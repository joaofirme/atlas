	/// Cálculo de meta diária por dias úteis.
	measure 'Meta Diária Atual' = ```
			
			
			VAR _DeltaRSL = ([Meta RSL] - [03 RSL])
			
			VAR _DiasUteis = MIN(fMeta_Geral[general_target_days])
			
			VAR _Feriado = 
				NETWORKDAYS(
					MIN('dTempo'[Data]),
					TODAY(), 
					1,
			        dFeriado
			    )
			
			VAR _MetaDia = 
			    DIVIDE(
			        _DeltaRSL
			        ,_DiasUteis - _Feriado
			        ,0
			    )
			
			 RETURN
			       IF(
			           SELECTEDVALUE('dTempo'[MesNum]) <> MONTH(TODAY()) || _MetaDia < 0,
			           0,
			           _MetaDia
			        )
			```
		formatString: #,0
		displayFolder: 07 Meta
		lineageTag: 6ba67c54-a34c-4994-ab94-be63f0e1f7d6

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Meta de venda diária.
	measure 'Meta Média' = ```
			
			
			VAR MRSL = 
			    CALCULATE(
			        SUMX(
			            SUMMARIZE ( 
			                fMeta_unificada,
			                fMeta_unificada[empresa],
			                fMeta_unificada[cod_executivo], 
			                fMeta_unificada[chave_regional], 
			                fMeta_unificada[chave_marca], 
			                fMeta_unificada[meta_receita]
			            )
			            ,fMeta_unificada[meta_receita] 
			        )
			        ,REMOVEFILTERS(dTempo[DiaNum])
			    )
			
			VAR Dias =
			    CALCULATE(
			        min(fMeta_Geral[general_target_days])
			        ,REMOVEFILTERS(dTempo[DiaNum])
			    )
			    
			VAR MetaMedia =
			
			    DIVIDE(
			        MRSL
			        ,Dias
			    )
			
			RETURN
			    
			    IF([03 RSL] = 0, BLANK(),MetaMedia)
			```
		formatString: #,0
		displayFolder: 07 Meta
		lineageTag: 2ad9b8ed-94e2-4280-8b7a-bcbd81f62858

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

