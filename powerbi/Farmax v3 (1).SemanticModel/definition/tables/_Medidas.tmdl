	measure '02 Cancelado' =
			
			VAR vCanceladoFarmax =
			    CALCULATE(
			        SUM(fVendas_unificada[order_sale_cut_value])
			        ,USERELATIONSHIP(dTempo[Data],fVendas_unificada[sale_cancellation_date])
			        ,fVendas_unificada[empresa] = "FARMAX"
			        ,fVendas_unificada[pedido_tipo] = "VENDA"
			        ,fVendas_unificada[sale_storage_code] <> 52 --Remove Refaturamento
			        ,NOT(ISBLANK(fVendas_unificada[sale_rejection_reason_code]))
			    )
			
			VAR vCanceladoSanavita =
			    CALCULATE(
			        SUM(fVendas_unificada[order_sale_subtotal])
			        ,USERELATIONSHIP(dTempo[Data],fVendas_unificada[data_pedido])
			        ,fVendas_unificada[empresa] = "SANAVITA"
			        ,fVendas_unificada[pedido_tipo] = "VENDA"
			        ,fVendas_unificada[pedido_status] = "CANCELADO"
			    )
			
			RETURN
			    (COALESCE(vCanceladoFarmax, 0) + COALESCE(vCanceladoSanavita, 0)) + 0
		displayFolder: 01 Vendas
		lineageTag: 7a8f4f0a-a23b-4202-9bfb-86bbfc9a6f26

