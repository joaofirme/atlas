			VAR vCSS18 = ".top-hero-grid{display:grid;grid-template-columns:minmax(600px,1.55fr) minmax(540px,1.05fr);gap:14px;margin:0 0 14px 0;align-items:stretch;}.top-hero-grid .hero{min-height:240px;height:100%;box-sizing:border-box;}.top-hero-grid .card{min-height:240px;height:100%;box-sizing:border-box;padding:22px 24px;}.top-hero-grid .card.col-4{grid-column:auto;}.top-hero-grid .card h3{font-size:18px;margin-bottom:6px;}.top-hero-grid .card .desc{font-size:13px;margin-bottom:14px;}.top-hero-grid .chart-wrap{height:178px;margin-top:10px;overflow:visible;}.top-hero-grid .chart{width:100%;height:178px;display:block;overflow:visible;}.top-hero-grid .axis-label{font-size:14px!important;font-weight:760!important;font-family:var(--font)!important;fill:var(--ink)!important;}.top-hero-grid .legend-item{font-size:12px!important;font-weight:700!important;font-family:var(--font)!important;fill:var(--ink-2)!important;}.top-hero-grid .card .src{font-size:12px;margin-top:10px;}@media(max-width:980px){.top-hero-grid{grid-template-columns:1fr;}.top-hero-grid .card.col-4{grid-column:auto;}}.receita-bruta-card{border-top:3px solid var(--pos);min-height:132px;cursor:help;z-index:3}.receita-bruta-card:hover{z-index:50}.receita-bruta-card .mini-base-line{height:2px;background:#2F78C4;margin-top:20px;border-radius:999px;opacity:.85}.rb-drill{display:none;position:absolute;left:12px;right:12px;top:104px;background:#fff;border:1px solid var(--accent-line);border-radius:10px;box-shadow:var(--shadow-lift);padding:10px 12px;z-index:80;color:var(--ink);min-width:250px}.receita-bruta-card:hover .rb-drill{display:block}.rb-drill-title{font-size:10px;font-weight:850;letter-spacing:.09em;text-transform:uppercase;color:var(--brand);margin-bottom:8px}.rb-drill-row{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;font-weight:700;margin:5px 0}.rb-drill-row .rb-label{color:var(--ink-2)}.rb-drill-row .rb-value{font-weight:900;color:var(--ink);white-space:nowrap}.rb-dr