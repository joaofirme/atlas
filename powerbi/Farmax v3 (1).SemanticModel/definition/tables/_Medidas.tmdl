	/// RLS do ano corrente.
	measure '04 RSL Ano Atual' = ```
			
			
			Var FaturamentoAtual = 
			    CALCULATE(
			        [00 Faturamento]
			        ,YEAR(fVendas_unificada[data_movimento]) = YEAR(TODAY())
			    )
			
			Var DevolucaoAtual = 
			    CALCULATE(
			        [02 Devolução Total]
			        ,YEAR(fDevolucao_unificada[data_movimento]) = YEAR(TODAY())
			    )
			
			Return
			    FaturamentoAtual - DevolucaoAtual + 0
			
			/*
			Var FaturamentoAtual = 
			    CALCULATE(
			        [00 Faturamento]
			        ,YEAR(fFaturamento[order_billing_billing_date]) = YEAR(TODAY())
			    )
			
			Var DevolucaoAtual = 
			    CALCULATE(
			        [02 Devolução Total]
			        ,YEAR('fDevolução'[order_return_billing_date]) =  YEAR(TODAY())
			    )
			
			Return
			    FaturamentoAtual - DevolucaoAtual + 0
			*/
			```
		formatString: #,0
		displayFolder: 05 Faturamento
		lineageTag: cb1bcfe1-7153-4bd4-ba34-df69f12c8c6d

		annotation PBI_FormatHint = {"isDecimal":true}

	/// RLS do ano anterior.
	measure '04 RSL YoY' = ```
			
			
			    CALCULATE(
			        [03 RSL],
			        SAMEPERIODLASTYEAR(
			            'dTempo'[Data]
			        )
			    )
			/*Var FaturamentoAnt = 
			    CALCULATE(
			        [00 Faturamento]
			        ,FILTER(fFaturamento, YEAR(fFaturamento[order_billing_billing_date]) = YEAR(TODAY())-1)
			    )
			
			Var DevolucaoAnt = 
			    CALCULATE(
			        [02 Devolução Total]
			        ,FILTER('fDevolução', YEAR('fDevolução'[order_return_billing_date]) = YEAR(TODAY())-1)
			    )
			
			Return
			    FaturamentoAnt - DevolucaoAnt
			*/
			```
