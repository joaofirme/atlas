	/// Soma dos valores dos faturados dos itens das ordens de venda, deduzindo os impostos e taxas: ST, IPI Devoluções (RSL) icms, confins e pis, bonificação, amostras, descontos, verbas comerciais (RL).
	measure '06 RL' = ```
			
			
			    SUMX(
			        SUMMARIZE(
			        fVendas_unificada
			        ,fVendas_unificada[companhia]
			        ,dTempo[Ano0Mes]
			        ,"ledger_net_subtotal", MAX(fVendas_unificada[ledger_net_subtotal])
			    ),
			    [ledger_net_subtotal]
			    )
			```
		formatString: #,0
		displayFolder: 05 Faturamento
