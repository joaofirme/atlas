ems:center !important;border:1px solid var(--accent-line) !important;background:#E9F1F9 !important;color:var(--brand) !important;border-radius:999px !important;padding:6px 15px !important;font-size:15px !important;font-weight:900 !important;line-height:1.15 !important;}.badge{display:inline-flex !important;align-items:center !important;border:1px solid var(--accent-line) !important;background:var(--card-2) !important;color:var(--brand) !important;border-radius:999px !important;font-size:15px !important;font-weight:900 !important;padding:4px 11px !important;white-space:nowrap !important;line-height:1.15 !important;}.partial-badge{background:#FFF2D8 !important;border-color:#F0C46A !important;color:#8F5600 !important;}@media(max-width:900px){.ctxline{gap:9px !important;}.ctxline .ctx-divider{display:none !important;}.ctxline .ctx-company{order:3 !important;width:100% !important;}.ctxline .ctx-company-value{max-width:calc(100% - 92px) !important;}.ctxline .ctx-right{margin-left:auto !important;}}@media(max-width:680px){.ctxline{gap:10px !important;}.ctxline .ctx-right{width:100% !important;margin-left:0 !important;justify-content:flex-start !important;}}"
			
			VAR vCSS54 = ".decision-head{font-size:13.8px !important;}.decision-score .decision-pct{font-size:21px !important;}.decision-score .decision-label{font-size:16px !important;}.decision-score .decision-status{font-size:15.2px !important;}.decision-summary{font-size:16px !important;}.decision-row{font-size:16px !important;}.decision-row.emphasis b{font-size:15.2px !important;}"
			VAR vCSS55 = ".kpis-main-single-row .faturamento-card .number,.kpis-main-single-row .rsl-card .number,.kpis-main-single-row .dev-total-card .number,.kpis-main-single-row .price-medio-card .kpi-val{font-size:30px !important;line-height:1.04 !important;}"
			VAR vCSS56 = ".decision-score .decision-pct{font-size:36px !important;}.decision-head{font-size:14.8px !important;}"
			VAR vCSS57 = ".ating-meta-card{height:auto !important;min-height:265px !important;max-height:none !important;}.ating-meta-scroll{height:196px !important;max-height:196px !important;overflow-y:auto !important;overflow-x:hidden !important;padding-right:5px !important;}.ating-meta-scroll svg.ating-meta-chart{width:100% !important;height:auto !important;min-height:196px !important;display:block !important;}"
			VAR vCSS58 = ".top-hero-grid svg.ating-meta-chart text.value-inline{font-size:24px !important;font-weight:780 !important;}.top-hero-grid svg.ating-meta-chart text.value-inline .percentage-inline{font-size:24px !important;font-weight:780 !important;}"
			VAR vCSS59 = ".top-hero-grid svg.ating-meta-chart text.axis-label{font-size:24px !important;font-weight:780 !important;}.top-hero-grid svg.ating-meta-chart text.legend-item{font-size:22px !important;font-weight:780 !important;}"
			VAR vCSS60 = ".ating-meta-card .ating-meta-scroll{display:flex !important;justify-content:center !important;}.ating-meta-card svg.ating-meta-chart{margin-left:auto !important;margin-right:auto !important;max-width:640px !important;}.top-hero-grid svg.ating-meta-chart text.meta-value-inline{font-size:24px !important;font-weight:780 !important;fill:#51667F !important;}"
			VAR vCSS61 = ".reg-dyn-card .reg-dyn-wrap{padding:8px 6px 4px 6px !important;}.reg-dyn-head{margin:6px 0 10px min(21.76%,154px) !important;}.reg-dyn-row{grid-template-columns:minmax(90px,17.92%) minmax(190px,1fr) minmax(105px,auto) !important;gap:12px !important;margin:11px 0 !important;align-items:center !important;}.reg-dyn-name{font-size:15px !important;font-weight:400 !important;color:#000000 !important;text-align:right !important;white-space:normal !important;overflow:visible !important;text-overflow:clip !important;line-height:1.2 !important;overflow-wrap:anywhere !important;}.reg-dyn-chart{height:24px !important;position:relative !important;min-width:0 !important;}.reg-dyn-track{height:24px !important;position:relative !important;overflow:visible !important;}.reg-dyn-bar{height:24px !important;}.reg-dyn-val{position:absolute !important;top:50% !important;transform:translateY(-50%) !important;font-size:17px !important;font-weight:800 !important;white-space:nowrap !important;pointer-events:none !important;text-align:right !important;}.reg-dyn-val.inside{right:7px !important;color:#FFFFFF !important;text-shadow:0 1px 2px rgba(0,0,0,.45) !important;}.reg-dyn-val.outside{color:#14243A !important;text-shadow:none !important;}.reg-dyn-meta-val{font-size:17px !important;font-weight:400 !important;color:#51667F !important;white-space:nowrap !important;text-align:left !important;}@media(max-width:900px){.reg-dyn-row{grid-template-columns:minmax(70px,20.48%) minmax(130px,1fr) minmax(90px,auto) !important;gap:8px !important;}.reg-dyn-head{margin-left:20.48% !important;}.reg-dyn-name{font-size:13px !important;}.reg-dyn-val,.reg-dyn-meta-val{font-size:14px !important;}}"
			VAR vCSS62 = ".top-hero-grid svg.ating-meta-chart text.value-inline.ating-bad{fill:var(--neg) !important;}.top-hero-grid svg.ating-meta-chart text.value-inline.ating-ok{fill:var(--pos) !important;}"
			VAR vCSS63 = ".ating-meta-card .ating-meta-scroll{display:block !important;height:196px !important;max-height:196px !important;padding:4px 8px 8px !important;overflow-y:auto !important;overflow-x:hidden !important;}.ating-goal-grid{display:grid !important;grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:18px 34px !important;width:100% !important;box-sizing:border-box !important;align-items:start !important;}.ating-goal-item{min-width:0 !important;padding:7px 10px 10px !important;}.ating-goal-company{font-size:24px !important;font-weight:500 !important;color:#51667F !important;line-height:1.15 !important;margin-bottom:11px !important;white-space:normal !important;overflow-wrap:anywhere !important;}.ating-goal-main{display:flex !important;align-items:baseline !important;gap:14px !important;line-height:1 !important;margin-bottom:14px !important;white-space:nowrap !important;}.ating-goal-main.ating-bad{color:var(--neg) !important;}.ating-goal-main.ating-ok{color:var(--pos) !important;}.ating-goal-pct{font-size:32px !important;font-weight:650 !important;letter-spacing:-.02em !important;}.ating-goal-real{font-size:24px !important;font-weight:500 !important;}.ating-goal-track{position:relative !important;width:100% !important;height:14px !important;border-radius:999px !important;background:#51667F !important;overflow:hidden !important;margin-bottom:11px !important;}.ating-goal-fill{height:100% !important;border-radius:999px !important;background:#2F78C4 !important;min-width:0 !important;}.ating-goal-meta{font-size:24px !important;font-weight:500 !important;color:#51667F !important;line-height:1.15 !important;}.ating-goal-empty{display:flex !important;align-items:center !important;justify-content:center !important;height:150px !important;font-size:17px !important;color:#51667F !important;text-align:center !important;}@media(max-width:900px){.ating-goal-grid{grid-template-columns:1fr !important;gap:14px !important;}.ating-goal-company{font-size:20px !important;}.ating-goal-pct{font-size:28px !important;}.ating-goal-real,.ating-goal-meta{font-size:20px !important;}}"
			VAR vCSS64 = ".ating-goal-track{overflow:visible !important;}.ating-goal-meta{white-space:nowrap !important;}.ating-goal-fill.ating-ok{background:var(--pos) !important;}.ating-goal-fill.ating-bad{background:var(--neg) !important;}.ating-goal-overflow-dot{position:absolute !important;right:-4px !important;top:50% !important;transform:translateY(-50%) !important;width:12px !important;height:12px !important;border-radius:50% !important;}.ating-goal-overflow-dot.ating-ok{background:var(--pos) !important;}.ating-goal-overflow-dot.ating-bad{background:var(--neg) !important;}"
			VAR vCSS65 = ".top-hero-grid>.card:has(.ating-meta-chart){background:transparent !important;border:none !important;box-shadow:none !important;padding:4px 2px !important;}.top-hero-grid .card:has(.ating-meta-chart) .graph-title{flex-direction:row !important;align-items:baseline !important;justify-content:space-between !important;}.top-hero-grid .card:has(.ating-meta-chart) .graph-title-text{text-transform:none !important;font-weight:500 !important;letter-spacing:0 !important;font-size:18px !important;}.ating-goal-item{overflow:visible !important;}.ating-goal-main{overflow:visible !important;flex-wrap:wrap !important;white-space:normal !important;}.ating-goal-real{white-space:nowrap !important;}"
			VAR vCSS66 = ".ating-goal-company{font-size:19px !important;margin-bottom:6px !important;}.ating-goal-pct{font-size:22px !important;}.ating-goal-real{font-size:16px !important;}.ating-goal-main{gap:8px !important;margin-bottom:8px !important;}.ating-goal-track{height:8px !important;margin-bottom:6px !important;background:#D9E1E8 !important;}.ating-goal-meta{font-size:16px !important;white-space:nowrap !important;}.ating-goal-item{padding:4px 8px 6px !important;}.ating-goal-grid{gap:10px 20px !important;}"
			VAR vCSS67 = ".top-hero-grid .card:has(.ating-meta-chart) .graph-title{margin-bottom:14px !important;}.ating-meta-card{display:flex !important;flex-direction:column !important;height:100% !important;min-height:0 !important;max-height:none !important;}.ating-meta-card .ating-meta-scroll{flex:1 !important;display:flex !important;flex-direction:column !important;justify-content:center !important;height:auto !important;max-height:none !important;min-height:0 !important;}"
			
			VAR vCSS = "<style>" & vCSS01 & vCSS02 & vCSS03 & vCSS04 & vCSS05 & vCSS06 & vCSS07 & vCSS08 & vCSS09 & vCSS10 & vCSS11 & vCSS12 & vCSS13 & vCSS14 & vCSS16 & vCSS17 & vCSS18 & vCSS19 & vCSS20 & vCSS21 & vCSS22 & vCSS24 & vCSS27 & vCSS28 & vCSS29 & vCSS30 & vCSS31 & vCSS32 & vCSS41 & vCSS42 & vCSS43 & vCSS44 & vCSS45 & vCSS46 & vCSS47 & vCSS48 & vCSS49 & vCSS50 & vCSS51 & vCSS52 & vCSS53 & vCSS54 & vCSS55 & vCSS56 & vCSS57 & vCSS58 & vCSS59 & vCSS60 & vCSS61 & vCSS62 & vCSS63 & vCSS64 & vCSS65 & vCSS66 & vCSS67 & "</style>"
			
			
			// SVG inline: atingimento de meta por empresa
			VAR vSVG2 =
			    "<div class=""ating-goal-grid"" aria-label=""Atingimento de meta por empresa"">" &
			        HAtingEmpresaCards &
			    "</div>"
			VAR HH1 =
			    "<div class=""decision-card"">" &
			        "<div class=""decision-head"">" &
			            "<span class=""decision-period"">" & vMesDecisao & " " & YEAR(vInicioMesDecisao) & " · " & FORMAT(vDiasUteisRealizados, "0") & " de " & FORMAT(vDiasUteisTotal, "0") & " dias úteis (" & fPercDiasUteis & ")</span>" &
			        "</div>" &
			        "<div class=""decision-score"">" &
			            "<div class=""decision-pct"">" & fAtingimentoDecisao & "</div>" &
			            "<div class=""decision-label"">Da meta:</div>" &
			            "<div class=""decision-status " & vStatusDecisaoCls & """>" & vStatusDecisao & "</div>" &
			        "</div>" &
			        "<div class=""decision-body"">" &
			            "<div class=""decision-summary"">Receita " & IF(vUsarReceitaBruta, "RB", "RSL") & " <b>" & fRSL & "</b> de Meta " & IF(vUsarReceitaBruta, "RB", "RSL") & " <b>" & fMetaRSL & "</b></div>" &
			            "<div class=""decision-row""><span>Ritmo realizado:</span><b>" & fRitmoAtualDU & "</b></div>" &
			            "<div class=""decision-row emphasis""><span>Ritmo necessário:</span><b>" & fRitmoNecessarioDU & "</b></div>" &
			            "<div class=""decision-row""><span>Dias úteis restantes:</span><b>" & FORMAT(vDiasUteisRestantes, "0") & "</b></div>" &
			            "<div class=""decision-row emphasis""><span>Esforço vs ritmo atual:</span><b>" & fMultiplicadorRitmo & "</b></div>" &
			            "<div class=""decision-row " & IF(NOT vTemMeta, "", IF(vGapProjetado >= 0, "positive", "negative")) & """><span>Gap vs meta:</span><b>" & fGapProjetado & " (" & fGapProjetadoPerc & ")</b></div>" &
			            "<div class=""decision-progress""><div class=""decision-progress-track""><div class=""decision-progress-fill"" style=""width:" & FORMAT(MIN(100, MAX(0, vAtingimentoDecisao * 100)), "0") & "%""></div><div class=""decision-progress-dot"" style=""left:" & FORMAT(MIN(100, MAX(0, vAtingimentoDecisao * 100)), "0") & "%""></div><div class=""decision-progress-target""></div></div></div>" &
			        "</div>" &
			    "</div>"
			VAR HH2 = ""
			VAR HH3 = ""
			VAR HH5 = ""
			VAR HH6 = ""
			VAR HH8 = ""
			
			// HTML: Indicadores principais - linha única com 4 cards
			VAR HFAT = "<div class=""kpi-spark-card faturamento-card""><div class=""kpi-top fat-title-top""><div class=""kpi-title fat-title""><span class=""fat-title-main"">Faturamento</span></div></div><div class=""kpi-main-value""><span class=""currency"">R$</span><span class=""number"">" & fFatNum & "</span><span class=""unit"">mi</span></div><div class=""kpi-variations""><span class=""variation " & IF(vFaturamentoMoM>0,"positive",IF(vFaturamentoMoM<0,"negative","flat")) & """>" & vSetaFatMoM & " " & fPercFatMoM & " MoM</span><span class=""variation " & IF(vFaturamentoYoY>0,"positive",IF(vFaturamentoYoY<0,"negative","flat")) & """>" & vSetaFatYoY & " " & fPercFatYoY & " YoY</span></div><div class=""sparkline-wrap""><svg viewBox=""0 0 280 50"" preserveAspectRatio=""none"" class=""sparkline""><defs><linearGradient id=""sparkFillFat"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#2F78C4"" stop-opacity=""0.22""/><stop offset=""100%"" stop-color=""#2F78C4"" stop-opacity=""0.04""/></linearGradient></defs><polygon points=""0,34 25,30 50,29 75,36 100,38 125,47 150,41 175,48 200,50 225,39 250,39 280,29 280,50 0,50"" fill=""url(#sparkFillFat)""/><polyline points=""0,34 25,30 50,29 75,36 100,38 125,47 150,41 175,48 200,50 225,39 250,39 280,29"" fill=""none"" stroke=""#2F78C4"" stroke-width=""1.7"" stroke-linecap=""round"" stroke-linejoin=""round""/></svg></div></div>"
			VAR HRSL = "<div class=""kpi-spark-card rsl-card""><div class=""kpi-top""><div class=""kpi-title"">Receita</div></div><div class=""kpi-main-value""><span class=""currency"">R$</span><span class=""number"">" & fRSLNum & "</span><span class=""unit"">mi</span></div><div class=""kpi-variations""><span class=""variation " & IF(vReceitaMoM>0,"positive",IF(vReceitaMoM<0,"negative","flat")) & """>" & vSetaMoM & " " & fPercMoM & " MoM</span><span class=""variation " & IF(vPercYoY>0,"positive",IF(vPercYoY<0,"negative","flat")) & """>" & vSetaYoY & " " & fPercYoY & " YoY</span></div><div class=""sparkline-wrap""><svg viewBox=""0 0 280 50"" preserveAspectRatio=""none"" class=""sparkline""><defs><linearGradient id=""sparkFillRSL"" x1=""0"" y1=""0"" x2=""0"" y2=""1""><stop offset=""0%"" stop-color=""#2F78C4"" stop-opacity=""0.22""/><stop offset=""100%"" stop-color=""#2F78C4"" stop-opacity=""0.04""/></linearGradient></defs><polygon points=""0,34 25,31 50,30 75,36 100,38 125,47 150,41 175,46 200,49 225,38 250,38 280,27 280,50 0,50"" fill=""url(#sparkFillRSL)""/><polyline points=""0,34 25,31 50,30 75,36 100,38 125,47 150,41 175,46 200,49 225,38 250,38 280,27"" fill=""none"" stroke=""#2F78C4"" stroke-width=""1.7"" stroke-linecap=""round"" stroke-linejoin=""round""/></svg></div></div>"
			VAR HDEV_TOTAL = "<div class=""kpi dev-total-card st-" & vClsDev & """><div class=""lab"">Devolução Total</div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fDevTotNum & "</span><span class=""unit"">mi</span></div><div class=""dev-total-details""><div class=""dev-total-line""><span>Devolução</span><b>" & fDev & " · " & fPercDev & "</b></div><div class=""dev-total-line""><span>Refaturamento</span><b>" & fRef & " · " & fPercRef & "</b></div></div></div>"
			VAR HPM_META =
			    IF(
			        vUsarReceitaBruta,
			        "",
			        "<div class=""hint"">Meta: " & fMetaPM & "</div><div class=""bar-track""><div class=""bar-fill"" style=""width:" & vPMWidth & "%;background:var(--" & vClsPM & ")""></div></div>"
			    )
			VAR vClsPMCard = IF(vUsarReceitaBruta, "", vClsPM)
			VAR HPM_TOP =
			    IF(
			        vUsarReceitaBruta,
			        "",
			        "<div class=""kpi price-medio-card " & vClsPMCard & """><div class=""lab"">Preço Médio</div><div class=""kpi-val " & vClsPMCard & """>" & fPM & "</div>" & HPM_META & "</div>"
			    )
			VAR HINDPRINCIPAIS = "<div class=""seclbl"">Indicadores principais</div><div class=""grid kpis kpis-main-single-row"">" & HFAT & HRSL & HDEV_TOTAL & HPM_TOP & "</div>"
			
			// HTML: Graficos
			VAR HG2 = "<div class=""card col-4 ating-meta-card""><h3 class=""graph-title""><span class=""graph-title-text"">Atingimento de meta</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "</span></h3><div class=""chart-wrap ating-meta-scroll"">" & vSVG2 & "</div></div>"
			VAR HTOPO = "<div class=""top-hero-grid"">" & HH1 & HH2 & HH3 & HH5 & HH6 & HH8 & IF(vUsarReceitaBruta, "", HG2) & "</div>"
			VAR HREGCSS = "<style>.reg-dyn-card .reg-title{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:7px;width:100%;margin-bottom:7px}.reg-dyn-card .reg-title-text{display:block;width:100%;min-width:0}.reg-dyn-card .reg-title-badges{display:flex;width:100%;align-items:center;gap:6px;flex-wrap:nowrap;justify-content:flex-end;white-space:nowrap}.reg-dyn-card .reg-title-badges .basetag{margin-left:0 !important}.reg-dyn-card .reg-dyn-wrap{padding:8px 10px 4px 10px}.reg-dyn-head{display:flex;align-items:center;gap:18px;margin:6px 0 10px 112px;font-size:13px;color:#14243A}.reg-legend-item{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}.reg-legend-real{width:26px;height:10px;border-radius:2px;background:#14568E;display:inline-block}.reg-legend-meta{width:3px;height:18px;background:#51667F;display:inline-block}.reg-dyn-row{display:grid;grid-template-columns:105px minmax(160px,1fr) 58px 68px;align-items:center;gap:8px;margin:8px 0}.reg-dyn-name{font-size:12px;font-weight:650;color:#233F63;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reg-dyn-chart{height:16px;position:relative}.reg-dyn-track{height:16px;background:#EEF2F7;border-radius:4px;position:relative;overflow:visible}.reg-dyn-bar{height:16px;background:#14568E;border-radius:4px}.reg-dyn-meta{position:absolute;top:-4px;width:3px;height:24px;background:#51667F;border-radius:2px}.reg-dyn-val{font-size:12px;font-weight:850;color:#233F63;text-align:right;white-space:nowrap}.reg-dyn-meta-val{font-size:10px;font-weight:650;color:#51667F;white-space:nowrap}.reg-empty{font-size:12px;color:#51667F;background:#F8FAFC;border:1px dashed #BDD4E9;border-radius:8px;padding:14px;margin-top:12px}.reg-dyn-card .src{margin-top:14px}@media(max-width:900px){.reg-dyn-card .reg-title-badges{justify-content:flex-start;white-space:normal;flex-wrap:wrap}.reg-dyn-row{grid-template-columns:86px minmax(120px,1fr) 52px}.reg-dyn-meta-val{display:none}.reg-dyn-head{margin-left:96px}}</style>"
			VAR HG4 = HREGCSS & "<div class=""card col-12 reg-dyn-card""><h3 class=""reg-title""><span class=""reg-title-text"">" & "Faturamento por região x meta" & "</span><span class=""reg-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "</span></h3><div class=""reg-dyn-wrap""><div class=""reg-dyn-head""><span class=""reg-legend-item""><span class=""reg-legend-real""></span>Realizado</span>" & "<span class=""reg-legend-item""><span class=""reg-legend-meta""></span>Meta</span>" & "</div>" & HRegiaoRows & "</div></div>"
			VAR HMIXCSS = "<style>.mix-card{min-height:360px !important}.mix-card h3{margin-bottom:6px}.mix-wrap{padding:2px 12px 10px}.mix-pie-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,300px) minmax(280px,1fr);gap:24px;align-items:center;min-height:290px}.mix-pie-wrap{grid-column:2;display:flex;align-items:center;justify-content:center;min-width:0}.mix-pie-svg{width:min(300px,78vw);height:auto;display:block;overflow:visible;filter:drop-shadow(0 4px 10px rgba(6,42,76,.10))}.mix-pie-label{font-family:var(--font);font-size:15px;font-weight:400;text-anchor:middle;dominant-baseline:middle;pointer-events:none}.mix-pie-label.light{fill:#FFFFFF}.mix-pie-label.dark{fill:#062A4C}.mix-pie-legend{grid-column:3;display:grid;grid-template-columns:1fr;gap:10px;align-content:center;justify-self:start;max-width:560px}.mix-pie-item{display:grid;grid-template-columns:16px minmax(0,230px) 70px;align-items:center;justify-content:start;gap:10px;min-height:28px}.mix-pie-dot{width:14px;height:14px;border-radius:3px;display:block;box-shadow:inset 0 0 0 1px rgba(6,42,76,.10)}.mix-pie-name{font-size:17px;font-weight:400;color:#000000;line-height:1.25;overflow-wrap:anywhere}.mix-pie-val{font-size:17px;font-weight:400;color:#000000;white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums}.mix-empty{font-size:15px;color:#51667F;background:#F8FAFC;border:1px dashed #BDD4E9;border-radius:8px;padding:18px;margin-top:12px}@media(max-width:1100px){.mix-pie-layout{grid-template-columns:1fr;gap:22px;min-height:0}.mix-pie-wrap,.mix-pie-legend{grid-column:1}.mix-pie-svg{width:min(280px,76vw)}.mix-pie-legend{width:min(100%,520px);margin:0 auto;justify-self:center}.mix-pie-name,.mix-pie-val{font-size:15px}}@media(max-width:560px){.mix-wrap{padding-left:0;padding-right:0}.mix-pie-svg{width:min(240px,72vw)}.mix-pie-item{grid-template-columns:14px minmax(0,190px) 62px;justify-content:start;gap:8px}.mix-pie-dot{width:12px;height:12px}.mix-pie-name,.mix-pie-val{font-size:14px}}</style>"
			VAR HG5 = HMIXCSS & "<div class=""card col-12 mix-card""><h3 class=""graph-title""><span class=""graph-title-text"">Participação Relativa por Segmento</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "</span></h3><div class=""mix-wrap"">" & HMixPie & "</div></div>"
			
			// HTML: Devolucao
			
			// HTML: Preco Medio e Positivacao
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtualizacaoContexto & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadgeContexto &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>"
			VAR HBASEFLAG = ""
			
			// Montagem final
			VAR vHTML =
			  vCSS &
			  "<div class=""fb"">" &
			  HCTX &
			  HTOPO &
			  HINDPRINCIPAIS &
			  "<div class=""grid cards charts-after-complements"">" &
			  HG4 & HG5 &
