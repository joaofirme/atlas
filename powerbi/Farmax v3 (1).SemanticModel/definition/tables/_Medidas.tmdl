			    [Devolução Selecionada]
			VAR vMovimento =
			    COALESCE(ABS(vVendido), 0)
			        + COALESCE(ABS(vReceita), 0)
			        + COALESCE(ABS(vAberto), 0)
			        + COALESCE(ABS(vProgramado), 0)
			        + COALESCE(ABS(vFaturamento), 0)
			        + COALESCE(ABS(vDevolucao), 0)
			RETURN
			    IF(
			        vMovimento <> 0,
			        1,
			        BLANK()
			    )
		formatString: 0
		displayFolder: [Pedidos & Faturamento] Matriz dinâmica
		lineageTag: 2b1d8380-8c23-4d48-9aa1-5025162f281a

