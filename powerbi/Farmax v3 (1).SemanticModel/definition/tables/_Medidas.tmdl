			VAR vCSS17 = ".ctxline{display:flex;align-items:center;gap:24px;flex-wrap:wrap;background:#F8FAFC;border-top:1px solid #D7E2EE;border-bottom:1px solid #D7E2EE;padding:9px 14px;margin:0 0 12px 0;font-family:var(--font);font-size:14px;color:var(--brand-deep);line-height:1.28;min-height:34px;font-weight:650;}.ctxline b{font-size:13px;font-weight:950;letter-spacing:.11em;text-transform:uppercase;color:var(--brand-deep);margin-right:5px;}.ctxline span{display:inline-flex;align-items:center;white-space:nowrap;}.ctxline .ctx-pill{background:#FFF2D8;border:1px solid #F0C46A;border-radius:999px;color:#8F5600;font-size:13px;font-weight:900;padding:3px 11px;}.dev-formula-sep{grid-column:1 / -1;display:flex;align-items:center;background:transparent;border:0;border-top:1px dashed #D7E2EE;border-bottom:1px dashed #D7E2EE;padding:8px 0 6px 0;margin:2px 0 2px 0;font-family:var(--font);min-height:30px;position:relative;}.dev-formula-title{position:relative;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:900;letter-spacing:1.4px;text-transform:uppercase;color:var(--brand-deep);cursor:help;line-height:1;}.dev-formula-title:after{content:'i';display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:999px;background:#E9F1F9;border:1px solid #BDD4E9;color:var(--brand);font-size:9px;font-weight:900;letter-spacing:0;text-transform:none;}.dev-tooltip{position:absolute;left:0;top:28px;z-index:10;display:none;align-items:center;gap:7px;flex-wrap:wrap;background:#FFFFFF;border:1px solid #C6D0DD;border-left:4px solid var(--brand);border-radius:9px;padding:9px 12px;box-shadow:0 8px 22px rgba(6,42,76,.16);color:var(--brand-deep);white-space:nowrap;}.dev-formula-title:hover .dev-tooltip{display:flex;}.dev-tooltip .formula-item{display:inline-flex;align-items:baseline;gap:4px;font-size:12px;font-weight:800;}.dev-tooltip .formula-label{font-size:10px;font-weight:800;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em;