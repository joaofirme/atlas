	measure '00 Financeiro' =
			
			VAR vFinanceiroFarmax =
			    CALCULATE(
			        [04 Aberto]
			        ,fVendas_unificada[empresa] = "FARMAX"
			        ,fVendas_unificada[obt_sales_department_status] = "FINANCEIRO"
			    )
			
			VAR vFinanceiroSanavita =
			    CALCULATE(
			        [04 Aberto]
