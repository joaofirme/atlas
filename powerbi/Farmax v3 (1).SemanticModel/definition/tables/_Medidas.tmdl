			VAR vCSS16 = ".kpi,.kpi-spark-card,.meta-summary-card,.meta-achievement-card{font-family:var(--font) !important;border-radius:9px !important;box-shadow:0 2px 7px rgba(6,42,76,.10) !important;min-height:132px !important;padding:12px 14px 10px !important;color:var(--ink) !important;}.kpi .lab,.kpi-spark-card .kpi-title,.meta-summary-card .meta-title,.meta-achievement-title{font-family:var(--font) !important;font-size:10px !important;line-height:1.2 !important;font-weight:800 !important;letter-spacing:1.1px !important;text-transform:uppercase !important;color:var(--brand) !important;margin:0 0 8px 0 !important;}.kpi-val,.kpi-spark-card .number,.meta-summary-card .number,.meta-achievement-value{font-family:var(--font) !important;font-size:24px !important;line-height:1.02 !important;font-weight:900 !important;letter-spacing:-.03em !important;color:#000 !important;font-variant-numeric:tabular-nums !important;white-space:nowrap !important;}.kpi-val{margin-top:5px !important;margin-bottom:4px !important;}.kpi-spark-card .kpi-main-value,.meta-summary-card .meta-value{display:flex !important;align-items:baseline !important;gap:3px !important;margin:0 0 6px 0 !important;white-space:nowrap !important;}.kpi-spark-card .currency,.meta-summary-card .currency{font-family:var(--font) !important;font-size:15px !important;font-weight:800 !important;color:#000 !important;}.kpi-spark-card .unit,.meta-summary-card .unit{font-family:var(--font) !important;font-size:10px !important;font-weight:800 !important;color:var(--brand-deep) !important;}.deltas,.kpi-spark-card .kpi-variations{font-family:var(--font) !important;margin-top:5px !important;gap:10px !important;}.delta,.kpi-spark-card .variation{font-family:var(--font) !important;font-size:10px !important;line-height:1.2 !important;font-weight:800 !important;}.kpi .hint,.meta-summary-card .meta-sub,.meta-achievement-sub{font-family:var(--font) !important;font-size:11px !important;line-height:1.3 !important;font-weight:650 !important;co