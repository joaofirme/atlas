			VAR vCSS70 =
			    ".info{position:relative;display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border:1.5px solid var(--brand);border-radius:50%;color:var(--brand);font-size:11px;font-weight:800;line-height:1;letter-spacing:0;text-transform:none;vertical-align:middle;cursor:help;flex:none;background:var(--accent-soft);}.info-abs{position:absolute;top:11px;right:13px;z-index:5;}.info-tip{position:absolute;top:calc(100% + 8px);right:0;width:272px;background:var(--brand-deep);color:#FFFFFF;font-size:12.5px;font-weight:600;line-height:1.5;letter-spacing:0;text-transform:none;text-align:left;white-space:normal;padding:10px 12px;border-radius:6px;box-shadow:0 4px 16px rgba(6,42,76,.30);opacity:0;visibility:hidden;transition:opacity .15s ease;z-index:80;pointer-events:none;}.info-tip b{font-weight:800;color:#FFFFFF;}.info:hover .info-tip,.info:focus .info-tip{opacity:1;visibility:visible;}.kpi-spark-card{position:relative !important;overflow:visible !important;}.decision-card{position:relative !important;}.decision-card .info-abs{top:13px;right:15px;background:transparent;border-color:#FFFFFF;color:#FFFFFF;}"
			VAR vCSS = "<style>" & vCSS01 & vCSS02 & vCSS03 & vCSS04 & vCSS05 & vCSS06 & vCSS07 & vCSS08 & vCSS09 & vCSS10 & vCSS11 & vCSS12 & vCSS13 & vCSS14 & vCSS16 & vCSS17 & vCSS18 & vCSS19 & vCSS20 & vCSS21 & vCSS22 & vCSS24 & vCSS27 & vCSS28 & vCSS29 & vCSS30 & vCSS31 & vCSS32 & vCSS41 & vCSS42 & vCSS43 & vCSS44 & vCSS45 & vCSS46 & vCSS47 & vCSS48 & vCSS49 & vCSS50 & vCSS51 & vCSS52 & vCSS53 & vCSS54 & vCSS55 & vCSS56 & vCSS57 & vCSS58 & vCSS59 & vCSS60 & vCSS61 & vCSS62 & vCSS63 & vCSS64 & vCSS65 & vCSS66 & vCSS67 & vCSS68 & vCSS69 & vCSS70 & "</style>"
			
			
			// SVG inline: atingimento de meta por empresa
			VAR vSVG2 =
			    "<div class=""ating-goal-grid"" aria-label=""Atingimento de meta por empresa"">" &
			        HAtingEmpresaCards &
			    "</div>"
			VAR HH1 =
			    "<div class=""decision-card"">" & "<span class=""info info-abs"" tabindex=""0"" role=""note"" aria-label=""Formulas de atingimento, ritmo realizado, ritmo necessario e esforco"">i<span class=""info-tip""><b>Atingimento</b> = Receita / Meta.<br><b>Ritmo realizado</b> = Receita / dias úteis decorridos.<br><b>Ritmo necessário</b> = (Meta - Receita) / dias úteis restantes.<br><b>Esforço vs ritmo atual</b> = Ritmo necessário / Ritmo realizado.<br><b>Gap vs meta</b> = Receita - Meta.<br>Batida a meta, o que falta vira zero: ritmo necessário e esforço zeram.</span></span>" &
			        "<div class=""decision-head"">" &
			            "<span class=""decision-period"">" & vMesDecisao & " " & YEAR(vInicioMesDecisao) & " · " & FORMAT(vDiasUteisRealizados, "0") & " de " & FORMAT(vDiasUteisTotal, "0") & " dias úteis (" & fPercDiasUteis & ")</span>" &
			        "</div>" &
			        "<div class=""decision-score"">" &
			            "<div class=""decision-pct"">" & fAtingimentoDecisao & "</div>" &
			            "<div class=""decision-label"">Da meta:</div>" &
			            "<div class=""decision-status " & vStatusDecisaoCls & """>" & vStatusDecisao & "</div>" &
			        "</div>" &
			        "<div class=""decision-body"">" &
			            "<div class=""decision-summary"">Receita " & IF(vUsarReceitaBruta, "RB", "RSL") & " <b>" & fRSL & "</b> de Meta " & IF(vUsarReceitaBruta, "RB", "RSL") & " <b>" & fMetaRSL & "</b></div>" &
			            "<div class=""decision-row""><span>Ritmo realizado:</span><b>" & fRitmoAtualDU & "</b></div>" &
			            "<div class=""decision-row emphasis""><span>Ritmo necessário:</span><b>" & fRitmoNecessarioDU & "</b></div>" &
			            "<div class=""decision-row""><span>Dias úteis restantes:</span><b>" & FORMAT(vDiasUteisRestantes, "0") & "</b></div>" &
			            "<div class=""decision-row emphasis""><span>Esforço vs ritmo atual:</span><b>" & fMultiplicadorRitmo & "</b></div>" &
			            "<div class=""decision-row " & IF(NOT vTemMeta, "", IF(vGapProjetado >= 0, "positive", "negative")) & """><span>Gap vs meta:</span><b>" & fGapProjetado & " (" & fGapProjetadoPerc & ")</b></div>" &
			            "<div class=""decision-progress""><div class=""decision-progress-track""><div class=""decision-progress-fill"" style=""width:" & FORMAT(MIN(100, MAX(0, vAtingimentoDecisao * 100)), "0") & "%""></div><div class=""decision-progress-dot"" style=""left:" & FORMAT(MIN(100, MAX(0, vAtingimentoDecisao * 100)), "0") & "%""></div><div class=""decision-progress-target""></div></div></div>" &
			        "</div>" &
			    "</div>"
			
			// HTML: Indicadores principais - linha única com 4 cards
			VAR HFAT = "<div class=""kpi-spark-card faturamento-card""><span class=""info info-abs"" tabindex=""0"" role=""note"" aria-label=""Faturamento do periodo; MoM e YoY sobre o mesmo recorte de dias"">i<span class=""info-tip""><b>Faturamento</b> do período.<br><b>MoM · YoY</b> = variação sobre o mesmo recorte de dias do mês e do ano anteriores.<br>Acompanha a base selecionada.</span></span><div class=""kpi-top fat-title-top""><div class=""kpi-title fat-title""><span class=""fat-title-main"">Faturamento</span></div></div><div class=""kpi-main-value""><span class=""currency"">R$</span><span class=""number"">" & fFatNum & "</span><span class=""unit"">mi</span></div><div class=""kpi-variations""><span class=""variation " & IF(vFaturamentoMoM>0,"positive",IF(vFaturamentoMoM<0,"negative","flat")) & """>" & vSetaFatMoM & " " & fPercFatMoM & " MoM</span><span class=""variation " & IF(vFaturamentoYoY>0,"positive",IF(vFaturamentoYoY<0,"negative","flat")) & """>" & vSetaFatYoY & " " & fPercFatYoY & " YoY</span></div></div>"
			VAR HRSL = "<div class=""kpi-spark-card rsl-card""><span class=""info info-abs"" tabindex=""0"" role=""note"" aria-label=""Receita igual a faturamento menos devolucao total"">i<span class=""info-tip""><b>Receita</b> = Faturamento - Devolução Total.<br><b>MoM · YoY</b> = variação sobre o mesmo recorte de dias.<br><b>Meta</b> = meta do período.<br>Acompanha a base selecionada.</span></span><div class=""kpi-top""><div class=""kpi-title"">Receita</div></div><div class=""kpi-main-value""><span class=""currency"">R$</span><span class=""number"">" & fRSLNum & "</span><span class=""unit"">mi</span></div><div class=""kpi-variations""><span class=""variation " & IF(vReceitaMoM>0,"positive",IF(vReceitaMoM<0,"negative","flat")) & """>" & vSetaMoM & " " & fPercMoM & " MoM</span><span class=""variation " & IF(vPercYoY>0,"positive",IF(vPercYoY<0,"negative","flat")) & """>" & vSetaYoY & " " & fPercYoY & " YoY</span></div><div class=""hint"">Meta: " & fMetaRSL & "</div></div>"
			VAR HDEV_TOTAL = "<div class=""kpi dev-total-card st-" & vClsDev & """><span class=""info info-abs"" tabindex=""0"" role=""note"" aria-label=""Devolucao total igual a devolucao mais refaturamento"">i<span class=""info-tip""><b>Devolução Total</b> = Devolução + Refaturamento.<br>Devolução = depósito diferente de 52 · Refaturamento = depósito 52.<br>O % de cada linha é sobre a Devolução Total.<br>A cor do card usa Devolução Total / Faturamento.</span></span><div class=""lab"">Devolução Total</div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fDevTotNum & "</span><span class=""unit"">mi</span></div><div class=""dev-total-details""><div class=""dev-total-line""><span>Devolução</span><b>" & fDev & " · " & fPercDev & "</b></div><div class=""dev-total-line""><span>Refaturamento</span><b>" & fRef & " · " & fPercRef & "</b></div></div></div>"
			VAR HPM_META =
			    IF(
			        vUsarReceitaBruta,
			        "",
			        "<div class=""hint"">Meta: " & fMetaPM & "</div>"
			    )
			VAR vClsPMCard = IF(vUsarReceitaBruta, "", vClsPM)
			VAR HPM_TOP =
			    IF(
			        vUsarReceitaBruta,
			        "",
			        "<div class=""kpi price-medio-card " & vClsPMCard & """><span class=""info info-abs"" tabindex=""0"" role=""note"" aria-label=""Preco medio igual a receita dividida por unidades faturadas"">i<span class=""info-tip""><b>Preço Médio</b> = Receita / Unidades Faturadas.<br><b>Meta</b> = meta de preço médio.<br>Verde a partir da meta · âmbar a partir de 97% · vermelho abaixo.<br>Acompanha a base selecionada.</span></span><div class=""lab"">Preço Médio</div><div class=""kpi-val money-split " & vClsPMCard & """><span class=""currency"">R$</span><span class=""number"">" & fPM & "</span></div>" & HPM_META & "</div>"
			    )
			VAR HINDPRINCIPAIS = "<div class=""seclbl"">Indicadores principais</div><div class=""grid kpis kpis-main-single-row"">" & HFAT & HRSL & HDEV_TOTAL & HPM_TOP & "</div>"
			
			// HTML: Graficos
			VAR HG2 = "<div class=""card col-4 ating-meta-card""><h3 class=""graph-title""><span class=""graph-title-text"">Atingimento de meta</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Receita dividida pela meta, por empresa"">i<span class=""info-tip"">Receita / Meta por empresa.<br>A barra mostra o avanço sobre a meta; o valor à direita é a receita realizada.<br>Exibe empresas com receita ou meta no período.<br>Acompanha a base selecionada.</span></span></span></h3><div class=""chart-wrap ating-meta-scroll"">" & vSVG2 & "</div></div>"
			VAR HTOPO = "<div class=""top-hero-grid"">" & HH1 & IF(vUsarReceitaBruta, "", HG2) & "</div>"
			VAR HREGCSS = "<style>.reg-dyn-card .reg-title{display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:7px;width:100%;margin-bottom:7px}.reg-dyn-card .reg-title-text{display:block;width:100%;min-width:0}.reg-dyn-card .reg-title-badges{display:flex;width:100%;align-items:center;gap:6px;flex-wrap:nowrap;justify-content:flex-end;white-space:nowrap}.reg-dyn-card .reg-title-badges .basetag{margin-left:0 !important}.reg-dyn-card .reg-dyn-wrap{padding:8px 10px 4px 10px}.reg-dyn-head{display:flex;align-items:center;gap:18px;margin:6px 0 10px 112px;font-size:13px;color:#14243A}.reg-legend-item{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}.reg-legend-real{width:26px;height:10px;border-radius:2px;background:#14568E;display:inline-block}.reg-legend-meta{width:3px;height:18px;background:#51667F;display:inline-block}.reg-dyn-row{display:grid;grid-template-columns:105px minmax(160px,1fr) 58px 68px;align-items:center;gap:8px;margin:8px 0}.reg-dyn-name{font-size:12px;font-weight:650;color:#233F63;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.reg-dyn-chart{height:16px;position:relative}.reg-dyn-track{height:16px;background:#EEF2F7;border-radius:4px;position:relative;overflow:visible}.reg-dyn-bar{height:16px;background:#14568E;border-radius:4px}.reg-dyn-meta{position:absolute;top:-4px;width:3px;height:24px;background:#51667F;border-radius:2px}.reg-dyn-val{font-size:12px;font-weight:850;color:#233F63;text-align:right;white-space:nowrap}.reg-dyn-meta-val{font-size:10px;font-weight:650;color:#51667F;white-space:nowrap}.reg-empty{font-size:12px;color:#51667F;background:#F8FAFC;border:1px dashed #BDD4E9;border-radius:8px;padding:14px;margin-top:12px}.reg-dyn-card .src{margin-top:14px}@media(max-width:900px){.reg-dyn-card .reg-title-badges{justify-content:flex-start;white-space:normal;flex-wrap:wrap}.reg-dyn-row{grid-template-columns:86px minmax(120px,1fr) 52px}.reg-dyn-meta-val{display:none}.reg-dyn-head{margin-left:96px}}</style>"
			VAR HG4 = HREGCSS & "<div class=""card col-12 reg-dyn-card""><h3 class=""reg-title""><span class=""reg-title-text"">" & "Faturamento por região x meta" & "</span><span class=""reg-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Top 10 regionais com meta; barra e realizado e marca e a meta"">i<span class=""info-tip"">Top 10 regionais por receita, entre as que possuem meta.<br>Barra = realizado · marca = meta · % = realizado / meta.<br>Acompanha a base selecionada.</span></span></span></h3><div class=""reg-dyn-wrap""><div class=""reg-dyn-head""><span class=""reg-legend-item""><span class=""reg-legend-real""></span>Realizado</span>" & "<span class=""reg-legend-item""><span class=""reg-legend-meta""></span>Meta</span>" & "</div>" & HRegiaoRows & "</div></div>"
			VAR HMIXCSS = "<style>.mix-card{min-height:360px !important}.mix-card h3{margin-bottom:6px}.mix-wrap{padding:2px 12px 10px}.mix-pie-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,300px) minmax(280px,1fr);gap:24px;align-items:center;min-height:290px}.mix-pie-wrap{grid-column:2;display:flex;align-items:center;justify-content:center;min-width:0}.mix-pie-svg{width:min(300px,78vw);height:auto;display:block;overflow:visible;filter:drop-shadow(0 4px 10px rgba(6,42,76,.10))}.mix-pie-label{font-family:var(--font);font-size:15px;font-weight:400;text-anchor:middle;dominant-baseline:middle;pointer-events:none}.mix-pie-label.light{fill:#FFFFFF}.mix-pie-label.dark{fill:#062A4C}.mix-pie-legend{grid-column:3;display:grid;grid-template-columns:1fr;gap:10px;align-content:center;justify-self:start;max-width:560px}.mix-pie-item{display:grid;grid-template-columns:16px minmax(0,230px) 70px;align-items:center;justify-content:start;gap:10px;min-height:28px}.mix-pie-dot{width:14px;height:14px;border-radius:3px;display:block;box-shadow:inset 0 0 0 1px rgba(6,42,76,.10)}.mix-pie-name{font-size:17px;font-weight:400;color:#000000;line-height:1.25;overflow-wrap:anywhere}.mix-pie-val{font-size:17px;font-weight:400;color:#000000;white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums}.mix-empty{font-size:15px;color:#51667F;background:#F8FAFC;border:1px dashed #BDD4E9;border-radius:8px;padding:18px;margin-top:12px}@media(max-width:1100px){.mix-pie-layout{grid-template-columns:1fr;gap:22px;min-height:0}.mix-pie-wrap,.mix-pie-legend{grid-column:1}.mix-pie-svg{width:min(280px,76vw)}.mix-pie-legend{width:min(100%,520px);margin:0 auto;justify-self:center}.mix-pie-name,.mix-pie-val{font-size:15px}}@media(max-width:560px){.mix-wrap{padding-left:0;padding-right:0}.mix-pie-svg{width:min(240px,72vw)}.mix-pie-item{grid-template-columns:14px minmax(0,190px) 62px;justify-content:start;gap:8px}.mix-pie-dot{width:12px;height:12px}.mix-pie-name,.mix-pie-val{font-size:14px}}</style>"
			VAR HG5 = HMIXCSS & "<div class=""card col-12 mix-card""><h3 class=""graph-title""><span class=""graph-title-text"">Participação Relativa por Segmento</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Participacao de cada segmento na receita, Top 6"">i<span class=""info-tip"">Participação de cada segmento na receita do período.<br>Top 6 segmentos com receita; o % é calculado sobre o total selecionado.<br>Acompanha a base selecionada.</span></span></span></h3><div class=""mix-wrap"">" & HMixPie & "</div></div>"
			
			// HTML: Devolucao
			
			// HTML: Preco Medio e Positivacao
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtualizacaoContexto & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadgeContexto &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>"
			
			// Montagem final
			VAR vHTML =
			  vCSS &
			  "<div class=""fb"">" &
			  HCTX &
			  HTOPO &
			  HINDPRINCIPAIS &
			  "<div class=""grid cards charts-after-complements"">" &
			  HG4 & HG5 &
			  "</div>" &
			  "</div>"
			
			RETURN vHTML
		displayFolder: Bi_novo
		lineageTag: 7839eddd-92d2-4198-ae83-3a21923d7230

	measure 'Pedidos & Faturamentos Menu HTML' = ```
			
			
			// ==========================================================
			// CONTROLE DA BASE DE RECEITA
			// ==========================================================
			VAR vBaseReceitaSelecionada =
			    SELECTEDVALUE(
			        'Base Receita'[Base Receita],
			        "Receita Semi Líquida"
			    )
			
			VAR vUsarReceitaBruta =
			    vBaseReceitaSelecionada = "Receita Bruta"
			
			VAR vTagBase =
			    IF(
			        vUsarReceitaBruta,
			        "BASE RB",
			        "BASE RSL"
			    )
			
			// ==========================================================
			// PERÍODO ATUAL / MÊS PARCIAL
			// ==========================================================
			VAR vDataInicialSelecionada =
			    MIN('dTempo'[Data])
			
			VAR vDataFinalSelecionada =
			    MAX('dTempo'[Data])
			
			VAR vMesSelecionadoAtual =
			    NOT ISBLANK(vDataFinalSelecionada)
			        && YEAR(vDataFinalSelecionada) = YEAR(TODAY())
			        && MONTH(vDataFinalSelecionada) = MONTH(TODAY())
			
			VAR vDataFinalComparavel =
			    IF(
			        vMesSelecionadoAtual,
			        MIN(
			            TODAY(),
			            EOMONTH(vDataFinalSelecionada, 0)
			        ),
			        vDataFinalSelecionada
			    )
			
			VAR vInicioMesAtual =
			    DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			
			VAR vFimMesAtual =
			    EOMONTH(TODAY(), 0)
			
			VAR vPeriodoIncluiMesAtual =
			    NOT ISBLANK(vDataInicialSelecionada)
			        && NOT ISBLANK(vDataFinalSelecionada)
			        && vDataInicialSelecionada <= vFimMesAtual
			        && vDataFinalSelecionada >= vInicioMesAtual
			
			VAR vParcialBadge =
			    IF(
			        vPeriodoIncluiMesAtual,
			        "<span class=""badge partial-badge"">Mês parcial até dia "
			            & FORMAT(DAY(vDataFinalComparavel), "0")
			            & "</span>",
			        ""
			    )
			
			// ==========================================================
			// CONTEXTO DE EMPRESA — HIERARQUIA dEmpresa
			// Empresa > Description
			// ==========================================================
			VAR vEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Empresa]
			    )
			
			VAR vDescricaoEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Description]
			    )
			
			VAR vEmpresaContexto =
			    SWITCH(
			        TRUE(),
			
			        HASONEVALUE('dEmpresa'[Description])
			            && NOT ISBLANK(vDescricaoEmpresaSelecionada),
			            COALESCE(vEmpresaSelecionada, "Empresa")
			                & " › "
			                & vDescricaoEmpresaSelecionada,
			
			        HASONEVALUE('dEmpresa'[Empresa])
			            && NOT ISBLANK(vEmpresaSelecionada),
			            vEmpresaSelecionada,
			
			        ISFILTERED('dEmpresa'[Empresa])
			            || ISFILTERED('dEmpresa'[Description]),
			            "Múltiplas empresas",
			
			        "Grupo"
			    )
			
			// ==========================================================
			// ATUALIZAÇÃO
			// ==========================================================
			VAR vAtualizacaoContexto =
			    [00 Atualização]
			
			VAR fAtualizacaoContexto =
			    IF(
			        ISBLANK(vAtualizacaoContexto),
			        "-",
			        IF(
			            ISTEXT(vAtualizacaoContexto),
			            TRIM(
			                SUBSTITUTE(
			                    vAtualizacaoContexto,
			                    "Atualizado em:",
			                    ""
			                )
			            ),
			            FORMAT(
			                vAtualizacaoContexto,
			                "dd/mm/yyyy hh:mm"
			            )
			        )
			    )
			
			// ==========================================================
			// CSS — BARRA SUPERIOR
			// ==========================================================
			VAR CSS =
			"<style>
			html,body{
			    margin:0;
			    padding:0;
			    background:#F2F5F9;
			    border:0;
			    outline:0;
			}
			
			:root{
			    --brand:#023F76;
			    --brand-deep:#062A4C;
			    --accent-line:#BDD4E9;
			    --card-2:#F3F5F7;
			    --font:'Segoe UI',Arial,sans-serif;
			}
			
			.ctxline{
			    display:flex;
			    align-items:center;
			    gap:14px;
			    flex-wrap:wrap;
			    background:#F8FAFC;
			    border-top:1px solid #D7E2EE;
			    border-bottom:1px solid #D7E2EE;
			    padding:9px 14px;
			    margin:0;
			    font-family:var(--font);
			    font-size:13px;
			    color:var(--brand-deep);
			    line-height:1.30;
			    min-height:34px;
			    font-weight:650;
			    width:100%;
			    box-sizing:border-box;
			}
			
			.ctxline b{
			    font-size:12px;
			    font-weight:950;
			    letter-spacing:.10em;
			    text-transform:uppercase;
			    color:var(--brand-deep);
			    margin-right:5px;
			}
			
			.ctxline span{
			    display:inline-flex;
			    align-items:center;
			    white-space:nowrap;
			}
			
			.ctxline .ctx-divider{
			    width:1px;
			    height:22px;
			    background:#D7E2EE;
			    flex:0 0 1px;
			}
			
			.ctxline .ctx-company{
			    display:inline-flex;
			    align-items:center;
			    gap:7px;
			    min-width:0;
			}
			
			.ctxline .ctx-company-label{
			    font-size:12px;
			    font-weight:950;
			    letter-spacing:.10em;
			    text-transform:uppercase;
			    color:var(--brand-deep);
			}
			
			.ctxline .ctx-company-value{
			    display:inline-flex;
			    align-items:center;
			    max-width:420px;
			    overflow:hidden;
			    text-overflow:ellipsis;
			    white-space:nowrap;
			    border:1px solid #BDD4E9;
			    background:#EDF4FB;
			    color:#023F76;
			    border-radius:999px;
			    padding:5px 12px;
			    font-size:12px;
			    font-weight:900;
			    line-height:1.15;
			    box-shadow:inset 0 0 0 1px rgba(255,255,255,.45);
			}
			
			.ctxline .ctx-right{
			    margin-left:auto;
			    display:inline-flex;
			    align-items:center;
			    gap:8px;
			    flex-wrap:wrap;
			}
			
			.ctxline .ctx-base{
			    display:inline-flex;
			    align-items:center;
			    border:1px solid var(--accent-line);
			    background:#E9F1F9;
			    color:var(--brand);
			    border-radius:999px;
			    padding:6px 15px;
			    font-size:12px;
			    font-weight:900;
			    line-height:1.15;
			}
			
			.badge{
			    display:inline-flex;
			    align-items:center;
			    border:1px solid var(--accent-line);
			    background:var(--card-2);
			    color:var(--brand);
			    border-radius:999px;
			    font-size:12px;
			    font-weight:900;
			    padding:4px 11px;
			    white-space:nowrap;
			    line-height:1.15;
			}
			
			.partial-badge{
			    background:#FFF2D8;
			    border-color:#F0C46A;
			    color:#8F5600;
			}
			
			@media(max-width:900px){
			    .ctxline{
			        gap:9px;
			    }
			
			    .ctxline .ctx-divider{
			        display:none;
			    }
			
			    .ctxline .ctx-company{
			        order:3;
			        width:100%;
			    }
			
			    .ctxline .ctx-company-value{
			        max-width:calc(100% - 92px);
			    }
			
			    .ctxline .ctx-right{
			        margin-left:auto;
			    }
			}
			
			@media(max-width:680px){
			    .ctxline{
			        gap:10px;
			    }
			
			    .ctxline .ctx-right{
			        width:100%;
			        margin-left:0;
			        justify-content:flex-start;
			    }
			}
			</style>"
			
			// ==========================================================
			// HTML — BARRA SUPERIOR
			// ==========================================================
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtualizacaoContexto & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadge &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>"
			
			RETURN
			CSS &
			HCTX
			
			```
		displayFolder: Bi_novo
		lineageTag: 56c6be72-a0a8-48e3-9d6d-f5a81702b8c4

	partition _Medidas-ce9aba6e-9299-4be2-bde8-ac30ae434d0b = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

