	measure '% Meta Exibição' =
			
			VAR vDimensaoSemMeta =
			    ISINSCOPE('dClientes_unificada'[cliente_grupo])
			        || ISINSCOPE('dMaterial_unificada'[descricao])
			        || ISINSCOPE('dMaterial_unificada'[level])
			        || ISINSCOPE('dMaterial_unificada'[novo_segmento])
			
			VAR vBaseReceita =
			    SELECTEDVALUE(
			        'Base Receita'[Base Receita],
			        "Receita Semi Líquida"
			    )
			
			VAR vReceitaBrutaSelecionada =
			    vBaseReceita = "Receita Bruta"
			
			VAR vMeta =
			    [Meta RSL]
			
			VAR vLinhaPossuiDados =
			    NOT ISBLANK(
			        [Linha Matriz Possui Movimento]
			    )
			
			VAR vSemMeta =
			    vReceitaBrutaSelecionada
			        || vDimensaoSemMeta
			        || ISBLANK(vMeta)
			        || vMeta = 0
			
			VAR vPercentual =
			    DIVIDE(
			        [03 RSL],
			        vMeta
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        NOT vLinhaPossuiDados,
			            BLANK(),
			
			        vSemMeta,
			            0,
			
			        COALESCE(
			            vPercentual,
			            0
			        )
			    )
		displayFolder: [Pedidos & Faturamento] Matriz dinâmica
		lineageTag: 4122d3a5-a5a6-4545-9d47-b509ebc78119

