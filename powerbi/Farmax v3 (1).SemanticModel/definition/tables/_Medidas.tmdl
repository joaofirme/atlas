	measure '07 Valor Em Transito' =
			
			
			VAR vDataMax = CALCULATE(MAX(fVendas_unificada[data_pedido]), REMOVEFILTERS())
			RETURN
			CALCULATE(
			    SUM(fVendas_unificada[order_sale_subtotal]),
			    fVendas_unificada[pedido_tipo] = "VENDA",
			    fVendas_unificada[pedido_status] IN {"FATURADO", "FATURADO PARCIAL"},
			    KEEPFILTERS(
			        NOT ISBLANK(fVendas_unificada[nota_fiscal])
			    ),
			    KEEPFILTERS(
			        ISBLANK(fVendas_unificada[data_entrega]) || fVendas_unificada[data_entrega] >= TODAY() + 1
			    ),
			    KEEPFILTERS(
			        DATEDIFF(fVendas_unificada[data_pedido], vDataMax, DAY) <= 90
			    )
			)
		displayFolder: 04 Logística
		lineageTag: 3f72cd45-53cb-40e6-8b15-9f84fd732492

		annotation PBI_FormatHint = {"isGeneralNumber":true}

