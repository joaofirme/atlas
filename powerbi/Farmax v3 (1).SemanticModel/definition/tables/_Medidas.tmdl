	measure '05 Devolução_Bruta' =
			[02 Devolução Total]
			
			/*    CALCULATE(
			        SUM('fDevolução'[order_return_total]),
			        'fDevolução'[order_return_storage_code] <> "52",
			        'fDevolução'[order_return_billing_type_code] in{"ZK","ZR","ZD","ZE","ZH"},
