			VAR vCSS13 = ".cellbar .trk{position:relative;flex:1;height:8px;background:var(--bg);border-radius:3px;}.cellbar .fill{position:absolute;left:0;top:1px;height:6px;border-radius:2px;}.cellbar .mk{position:absolute;top:-2px;width:2px;height:12px;background:var(--sc-meta);border-radius:1px;}.seg-legend{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;}.seg-dot{width:10px;height:10px;border-radius:2px;flex:none;display:inline-block;}.footer{font-size:var(--fs-foot);color:var(--ink-3);border-top:1px dashed var(--line);padding-top:8px;margin-top:8px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;}"
			VAR vCSS14 = ".kpi-spark-card{background:#FFFFFF;border:1px solid #DFE7F0;border-top:3px solid var(--pos);border-radius:9px;box-shadow:0 2px 7px rgba(6,42,76,.10);padding:9px 13px 8px;min-height:126px;box-sizing:border-box;color:var(--ink);overflow:hidden;}.kpi-spark-card .kpi-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px;}.kpi-spark-card .kpi-title{font-size:10px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--brand);}.kpi-spark-card .kpi-badge{background:var(--accent-soft);color:var(--brand);font-size:8.5px;font-weight:800;padding:3px 6px;border-radius:3px;white-space:nowrap;}.kpi-spark-card .kpi-main-value{display:flex;align-items:baseline;gap:3px;margin-bottom:6px;}.kpi-spark-card .currency{font-size:12px;font-weight:700;color:var(--ink);}.kpi-spark-card .number{font-size:22px;line-height:1;font-weight:900;color:var(--ink);letter-spacing:-.02em;}.kpi-spark-card .unit{font-size:10px;font-weight:800;color:var(--ink);}.kpi-spark-card .kpi-variations{display:flex;align-items:center;gap:12px;margin-bottom:5px;white-space:nowrap;flex-wrap:wrap;}.kpi-spark-card .variation{font-size:9.5px;font-weight:800;}.kpi-spark-card .variation.positive{color:var(--pos);}.kpi-spark-card .variation.negative{color:var(--neg);}.kpi-spark-card .variation.flat{color:var(--ink-3);}.sparkline-wrap{width:100%;height:43px;margin-top:2px;}.sparkline{width:100%;height:43px;display:block;}.receita-card .kpi-top{margin-bottom:8px;}.receita-card .kpi-variations{margin-bottom:4px;}.meta-summary-card{background:#FFFFFF;border:1px solid #DFE7F0;border-radius:8px;box-shadow:0 2px 7px rgba(6,42,76,.10);padding:14px 15px;min-height:132px;box-sizing:border-box;color:var(--ink);overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start;}.meta-summary-card .meta-title{font-size:10px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--brand);line-height:1.2;margin-bottom:8px;}.meta-summary-ca