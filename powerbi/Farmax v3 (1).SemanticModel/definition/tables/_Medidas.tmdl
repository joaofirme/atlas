	/// Soma dos valores dos faturados dos itens das ordens de venda, deduzindo os impostos e taxas: ST, IPI Devoluções.
	measure '03 RSL' = ```
			
			
			    [00 Faturamento] - [02 Devolução Total]
			```
		formatString: #,0
		displayFolder: 05 Faturamento
		lineageTag: 6bfbec92-8337-4bf1-962e-f2c9eab44686

