	measure 'Pedidos & Faturamentos HTML' = ```
			
			
			// Página sugerida: Pedidos & Faturamentos
			// Os cards e gráficos utilizam diretamente o contexto de filtro das dimensões originais do modelo.
			// Exemplos: dRegional, dExecutivos_unificada, dClientes_unificada e dMaterial_unificada.
			// Não é necessária tabela desconectada nem aplicação manual de TREATAS.
			// ==========================================================
			// CONTROLE DA BASE DE RECEITA
			// ==========================================================
			
			VAR vBaseReceitaSelecionada =
			    SELECTEDVALUE(
			        'Base Receita'[Base Receita],
			        "Receita Semi Líquida"
			    )
			
			VAR vUsarReceitaBruta =
			    vBaseReceitaSelecionada = "Receita Bruta"
			
			VAR vNomeFaturamento =
			    "Faturamento"
			
			VAR vNomeReceita =
			    "Receita"
			
			VAR vSiglaReceita =
			    IF(
			        vUsarReceitaBruta,
			        "RB",
			        "RSL"
			    )
			
			VAR vTagBase =
			    IF(
			        vUsarReceitaBruta,
			        "BASE RB",
			        "BASE RSL"
			    )
			
			VAR vFonteBase =
			    IF(
			        vUsarReceitaBruta,
			        "BASE RB",
			        "BASE RSL"
			    )
			VAR vVendido =
			    COALESCE(
			        [00 Valor de Vendas],
			        0
			    )
			VAR vFaturado =
			    COALESCE(
			        IF(
			            vUsarReceitaBruta,
			            [08 Faturamento Bruto],
			            [00 Faturamento]
			        ),
			        0
			    )
			VAR vRSLBase =
			    COALESCE(
			        [03 RSL],
			        0
			    )
			VAR vMetaRSL =
			    COALESCE(
			        [Meta RSL],
			        0
			    )
			VAR vAberto =
			    COALESCE(
			        CALCULATE(
			            [04 Aberto],
			            REMOVEFILTERS('dTempo')
			        ),
			        0
			    )
			VAR vProgramado =
			    COALESCE(
			        CALCULATE(
			            [05 Programado],
			            REMOVEFILTERS('dTempo')
			        ),
			        0
			    )
			VAR vProgramadoM =
			    COALESCE(
			        CALCULATE(
			            [05 Programado M+],
			            REMOVEFILTERS('dTempo')
			        ),
			        0
			    )
			VAR vCarteiraAtual =
			    vAberto + vProgramado
			
			VAR vPercAbertoCarteira =
			    DIVIDE(
			        vAberto,
			        vCarteiraAtual,
			        0
			    )
			
			VAR fPercAbertoCarteira =
			    FORMAT(
			        vPercAbertoCarteira,
			        "0.0%"
			    )
			
			VAR fProgramadoM =
			    FORMAT(
			        DIVIDE(vProgramadoM, 1000000),
			        "R$ #,##0.0"
			    ) & " mi"
			
			VAR vEntregue =
			    COALESCE(
			        [06 Valor Entregue],
			        0
			    )
			VAR vReceitaBruta =
			    COALESCE(
			        [09 Receita Bruta],
			        0
			    )
			VAR vReceitaSelecionada =
			    IF(
			        vUsarReceitaBruta,
			        vReceitaBruta,
			        vRSLBase
			    )
			VAR vDevolucao =
			    COALESCE(
			        [00 Devolução],
			        0
			    )
			VAR vRefaturamento =
			    COALESCE(
			        [01 Refaturamento],
			        0
			    )
			VAR vCancelados    = [02 Cancelado]
			
			VAR vAtingMeta =
			    DIVIDE(
			        vReceitaSelecionada,
			        vMetaRSL,
			        0
			    )
			
			VAR vMargemProxy =
			    DIVIDE(
			        vReceitaSelecionada,
			        vVendido,
			        0
			    )
			
			// A anatomia sempre compara Receita Bruta contra RSL real
			VAR vImpostos =
			    MAX(
			        0,
			        vReceitaBruta - vRSLBase
			    )
			VAR vDevRefTotal   = vDevolucao + vRefaturamento
			// ==========================================================
			// ANATOMIA DA NOTA — PERCENTUAIS REAIS E LARGURAS VISUAIS
			// ==========================================================
			
			// Percentual real dos impostos sobre a receita bruta
			VAR vPercImpostosReal =
			    MIN(
			        1,
			        MAX(
			            0,
			            DIVIDE(vImpostos, vReceitaBruta, 0)
			        )
			    )
			
			// Percentual real do RSL sobre a receita bruta
			VAR vPercRSLReal =
			    MIN(
			        1,
			        MAX(
			            0,
			            DIVIDE(
			                vRSLBase,
			                vReceitaBruta,
			                0
			            )
			        )
			    )
			
			// Espaço mínimo visual reservado aos impostos.
			// 0.18 representa 18% da largura total da barra.
			VAR vMinImpostosVisual = 0.18
			
			// Quando houver impostos, garante pelo menos 18% de largura visual
			VAR vPercImpostosVisual =
			    IF(
			        vImpostos > 0,
			        MAX(
			            vMinImpostosVisual,
			            vPercImpostosReal
			        ),
			        0
			    )
			
			// O RSL utiliza o restante da barra
			VAR vPercRSLVisual =
			    MAX(
			        0,
			        1 - vPercImpostosVisual
			    )
			
			// Valores usados exclusivamente no CSS.
			// O SUBSTITUTE troca a vírgula decimal por ponto,
			// porque o CSS precisa receber, por exemplo, 78.5%.
			VAR wAnatomiaRSL =
			    SUBSTITUTE(
			        FORMAT(
			            vPercRSLVisual * 100,
			            "0.0"
			        ),
			        ",",
			        "."
			    )
			
			VAR wAnatomiaImpostos =
			    SUBSTITUTE(
			        FORMAT(
			            vPercImpostosVisual * 100,
			            "0.0"
			        ),
			        ",",
			        "."
			    )
			
			// Percentuais apresentados no painel.
			// A exibição permanece conforme a localização pt-BR do modelo.
			VAR fPercRSLAnatomia =
			    FORMAT(
			        vPercRSLReal,
			        "0.0%"
			    )
			
			VAR fPercImpostosAnatomia =
			    FORMAT(
			        vPercImpostosReal,
			        "0.0%"
			    )
			// ==========================================================
			// PERÍODO COMPARÁVEL — YoY E MoM
			// Quando o mês selecionado é o mês corrente, limita as
			// comparações ao período entre o primeiro dia e a data atual.
			// Para meses encerrados, preserva o intervalo selecionado.
			// ==========================================================
			VAR vDataInicialSelecionada =
			    MIN('dTempo'[Data])
			
			VAR vDataFinalSelecionada =
			    MAX('dTempo'[Data])
			
			VAR vMesSelecionadoAtual =
			    NOT ISBLANK(vDataFinalSelecionada)
			        && YEAR(vDataFinalSelecionada) = YEAR(TODAY())
			        && MONTH(vDataFinalSelecionada) = MONTH(TODAY())
			
			VAR vDataFinalComparavel =
			    IF(
			        vMesSelecionadoAtual,
			        MIN(
			            TODAY(),
			            EOMONTH(vDataFinalSelecionada, 0)
			        ),
			        vDataFinalSelecionada
			    )
			
			VAR vDataInicialComparavel =
			    IF(
			        vMesSelecionadoAtual,
			        DATE(
			            YEAR(vDataFinalSelecionada),
			            MONTH(vDataFinalSelecionada),
			            1
			        ),
			        vDataInicialSelecionada
			    )
			
			VAR vDiaCorteComparavel =
			    DAY(vDataFinalComparavel)
			
			// Mesmo intervalo do ano anterior.
			VAR vDataInicialLY =
			    EDATE(vDataInicialComparavel, -12)
			
			VAR vDataFinalLY =
			    VAR vDataFinalLYBase =
			        EDATE(vDataFinalComparavel, -12)
			    RETURN
			        DATE(
			            YEAR(vDataFinalLYBase),
			            MONTH(vDataFinalLYBase),
			            MIN(
			                vDiaCorteComparavel,
			                DAY(EOMONTH(vDataFinalLYBase, 0))
			            )
			        )
			
			// Mês completo compara com o mês anterior completo.
			// Período parcial compara exatamente o mesmo intervalo
			// deslocado em um mês.
			VAR vSelecaoDentroDeUmMes =
			    YEAR(vDataInicialComparavel) = YEAR(vDataFinalComparavel)
			        && MONTH(vDataInicialComparavel) = MONTH(vDataFinalComparavel)
			
			VAR vSelecaoMesCompleto =
			    vSelecaoDentroDeUmMes
			        && vDataInicialComparavel =
			            DATE(
			                YEAR(vDataInicialComparavel),
			                MONTH(vDataInicialComparavel),
			                1
			            )
			        && vDataFinalComparavel = EOMONTH(vDataFinalComparavel, 0)
			
			VAR vDataInicialLM =
			    IF(
			        vSelecaoMesCompleto,
			        EOMONTH(vDataInicialComparavel, -2) + 1,
			        EDATE(vDataInicialComparavel, -1)
			    )
			
			VAR vDataFinalLM =
			    IF(
			        vSelecaoMesCompleto,
			        EOMONTH(vDataFinalComparavel, -1),
			        EDATE(vDataFinalComparavel, -1)
			    )
			
			// ==========================================================
			// COMPARAÇÃO YoY — MESMO PERÍODO DO ANO ANTERIOR
			// ==========================================================
			VAR vVendidoLY =
			    COALESCE(
			        CALCULATE(
			            [00 Valor de Vendas],
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vFaturadoLY =
			    COALESCE(
			        CALCULATE(
			            IF(
			                vUsarReceitaBruta,
			                [08 Faturamento Bruto],
			                [00 Faturamento]
			            ),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vReceitaSelecionadaLY =
			    COALESCE(
			        CALCULATE(
			            IF(
			                vUsarReceitaBruta,
			                [09 Receita Bruta],
			                [03 RSL]
			            ),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vAbertoLY =
			    COALESCE(
			        CALCULATE(
			            [03 Total a Faturar],
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vProgramadoLY =
			    COALESCE(
			        CALCULATE(
			            [05 Programado],
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vEntregueLY =
			    COALESCE(
			        CALCULATE(
			            [06 Valor Entregue],
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLY,
			                vDataFinalLY
			            )
			        ),
			        0
			    )
			
			VAR vYoYVendido =
			    DIVIDE(vVendido - vVendidoLY, ABS(vVendidoLY), 0)
			
			VAR vYoYFaturado =
			    DIVIDE(vFaturado - vFaturadoLY, ABS(vFaturadoLY), 0)
			
			VAR vYoYReceita =
			    DIVIDE(
			        vReceitaSelecionada - vReceitaSelecionadaLY,
			        ABS(vReceitaSelecionadaLY),
			        0
			    )
			
			VAR vYoYAberto =
			    DIVIDE(vAberto - vAbertoLY, ABS(vAbertoLY), 0)
			
			VAR vYoYProgramado =
			    DIVIDE(vProgramado - vProgramadoLY, ABS(vProgramadoLY), 0)
			
			VAR vYoYEntregue =
			    DIVIDE(vEntregue - vEntregueLY, ABS(vEntregueLY), 0)
			
			VAR vPercEntregueReceita =
			    DIVIDE(
			        vEntregue,
			        vFaturado,
			        0
			    )
			
			VAR fPercEntregueReceita =
			    FORMAT(
			        vPercEntregueReceita,
			        "0%"
			    )
			
			VAR fVendido       = FORMAT(DIVIDE(vVendido,1000000), "R$ #,##0.0") & " mi"
			VAR fFaturado      = FORMAT(DIVIDE(vFaturado,1000000), "R$ #,##0.0") & " mi"
			VAR fReceitaSelecionada =
			    FORMAT(
			        DIVIDE(vReceitaSelecionada, 1000000),
			        "R$ #,##0.0"
			    ) & " mi"
			
			VAR fRSLBase =
			    FORMAT(
			        DIVIDE(vRSLBase, 1000000),
			        "R$ #,##0.0"
			    ) & " mi"
			VAR fMetaRSL       = FORMAT(DIVIDE(vMetaRSL,1000000), "R$ #,##0.0") & " mi"
			VAR fAberto        = FORMAT(DIVIDE(vAberto,1000000), "R$ #,##0.0") & " mi"
			VAR fProgramado    = FORMAT(DIVIDE(vProgramado,1000000), "R$ #,##0.0") & " mi"
			VAR fAbertoNum     = FORMAT(DIVIDE(vAberto,1000000), "#,##0.0")
			VAR fProgramadoNum = FORMAT(DIVIDE(vProgramado,1000000), "#,##0.0")
			VAR fEntregue      = FORMAT(DIVIDE(vEntregue,1000000), "R$ #,##0.0") & " mi"
			VAR fReceitaBruta  = FORMAT(DIVIDE(vReceitaBruta,1000000), "R$ #,##0.0") & " mi"
			VAR fImpostos      = FORMAT(DIVIDE(vImpostos,1000000), "R$ #,##0.0") & " mi"
			VAR fDevolucao     = FORMAT(DIVIDE(vDevolucao,1000000), "R$ #,##0.0") & " mi"
			VAR fRefaturamento = FORMAT(DIVIDE(vRefaturamento,1000000), "R$ #,##0.0") & " mi"
			VAR fAtingMeta     = FORMAT(vAtingMeta, "0%")
			VAR fMargem        = FORMAT(vMargemProxy, "0.0%")
			
			VAR fYoYVendido    = FORMAT(vYoYVendido, "+0.0%;-0.0%;0.0%")
			VAR fYoYFaturado   = FORMAT(vYoYFaturado, "+0.0%;-0.0%;0.0%")
			VAR fYoYReceita    = FORMAT(vYoYReceita, "+0.0%;-0.0%;0.0%")
			VAR fYoYAberto     = FORMAT(vYoYAberto, "+0.0%;-0.0%;0.0%")
			VAR fYoYProgramado = FORMAT(vYoYProgramado, "+0.0%;-0.0%;0.0%")
			VAR fYoYEntregue   = FORMAT(vYoYEntregue, "+0.0%;-0.0%;0.0%")
			
			VAR sUp = UNICHAR(9650)
			VAR sDn = UNICHAR(9660)
			
			// Informativo de mês parcial.
			VAR vMesFiltrado =
			    VAR vNomeMes =
			        FORMAT(
			            vDataFinalSelecionada,
			            "mmmm",
			            "pt-BR"
			        )
			    RETURN
			        UPPER(LEFT(vNomeMes, 1))
			            & MID(vNomeMes, 2, LEN(vNomeMes))
			
			VAR vInicioMesAtual =
			    DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			
			VAR vFimMesAtual =
			    EOMONTH(TODAY(), 0)
			
			VAR vPeriodoIncluiMesAtual =
			    NOT ISBLANK(vDataInicialSelecionada)
			        && NOT ISBLANK(vDataFinalSelecionada)
			        && vDataInicialSelecionada <= vFimMesAtual
			        && vDataFinalSelecionada >= vInicioMesAtual
			
			VAR vParcialBadge =
			    IF(
			        vPeriodoIncluiMesAtual,
			        "<span class=""badge partial-badge"">Mês parcial até dia "
			            & FORMAT(DAY(vDataFinalComparavel), "0")
			            & "</span>",
			        ""
			    )
			
			// ==========================================================
			// COMPARAÇÃO MoM — MESMO INTERVALO DO MÊS ANTERIOR
			// ==========================================================
			VAR vVendidoLM =
			    COALESCE(
			        CALCULATE(
			            [00 Valor de Vendas],
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLM,
			                vDataFinalLM
			            )
			        ),
			        0
			    )
			
			VAR vFaturadoLM =
			    COALESCE(
			        CALCULATE(
			            IF(
			                vUsarReceitaBruta,
			                [08 Faturamento Bruto],
			                [00 Faturamento]
			            ),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN(
			                'dTempo'[Data],
			                vDataInicialLM,
			                vDataFinalLM
			            )
			        ),
			        0
			    )
			
			VAR vMoMVendido =
			    DIVIDE(vVendido - vVendidoLM, ABS(vVendidoLM), 0)
			
			VAR vMoMFaturado =
			    DIVIDE(vFaturado - vFaturadoLM, ABS(vFaturadoLM), 0)
			
			VAR fMoMVendido =
			    FORMAT(vMoMVendido, "+0.0%;-0.0%;0.0%")
			
			VAR fMoMFaturado =
			    FORMAT(vMoMFaturado, "+0.0%;-0.0%;0.0%")
			
			// ==========================================================
			// SPARKLINE MENSAL — VENDIDO
			// Somente meses completos
			// Esquerda = mais antigo | Direita = mais recente
			// ==========================================================
			
			VAR vSparkUltimaDataSelecionada =
			    MAXX(
			        ALLSELECTED('dTempo'[Data]),
			        'dTempo'[Data]
			    )
			
			VAR vSparkUltimoMesCompleto =
			    EOMONTH(
			        MIN(
			            vSparkUltimaDataSelecionada,
			            TODAY()
			        ),
			        -1
			    )
			
			VAR vSparkDataFinal =
			    vSparkUltimoMesCompleto
			
			VAR tSparkMeses =
			    ADDCOLUMNS(
			        GENERATESERIES(0, 11, 1),
			        "__Ordem", [Value],
			        "__DataInicio",
			            EOMONTH(
			                vSparkDataFinal,
			                [Value] - 12
			            ) + 1,
			        "__DataFim",
			            EOMONTH(
			                vSparkDataFinal,
			                [Value] - 11
			            )
			    )
			
			VAR tSparkVendido =
			    ADDCOLUMNS(
			        tSparkMeses,
			        "__Valor",
			            VAR vInicio = [__DataInicio]
			            VAR vFim = [__DataFim]
			            RETURN
			                COALESCE(
			                    CALCULATE(
			                        [00 Valor de Vendas],
			                        REMOVEFILTERS('dTempo'),
			                        DATESBETWEEN(
			                            'dTempo'[Data],
			                            vInicio,
			                            vFim
			                        )
			                    ),
			                    0
			                )
			    )
			
			VAR vSparkVendidoMin =
			    MINX(
			        tSparkVendido,
			        [__Valor]
			    )
			
			VAR vSparkVendidoMax =
			    MAXX(
			        tSparkVendido,
			        [__Valor]
			    )
			
			VAR vSparkVendidoAmplitude =
			    vSparkVendidoMax - vSparkVendidoMin
			
			VAR vSparkVendidoPontos =
			    CONCATENATEX(
			        tSparkVendido,
			        VAR vX =
			            DIVIDE(
			                [__Ordem] * 220,
			                11,
			                0
			            )
			
			        VAR vPosicao =
			            DIVIDE(
			                [__Valor] - vSparkVendidoMin,
			                vSparkVendidoAmplitude,
			                0.5
			            )
			
			        VAR vY =
			            38 - vPosicao * 34
			
			        RETURN
			            SUBSTITUTE(
			                FORMAT(vX, "0.0"),
			                ",",
			                "."
			            )
			                & ","
			                & SUBSTITUTE(
			                    FORMAT(vY, "0.0"),
			                    ",",
			                    "."
			                ),
			        " ",
			        [__Ordem],
			        ASC
			    )
			VAR vSparkVendidoAreaPontos =
			    "0,42 "
			        & vSparkVendidoPontos
			        & " 220,42"
			VAR HSparkVendido =
			    "<div class=""spark-wrap"">" &
			        "<svg class=""spark-svg"" viewBox=""0 0 220 42"" preserveAspectRatio=""none"">" &
			
			            "<defs>" &
			                "<linearGradient id=""sparkGradVendido"" x1=""0"" y1=""0"" x2=""0"" y2=""1"">" &
			                    "<stop offset=""0%"" stop-color=""#4B8DCE"" stop-opacity=""0.35""></stop>" &
			                    "<stop offset=""100%"" stop-color=""#4B8DCE"" stop-opacity=""0.02""></stop>" &
			                "</linearGradient>" &
			            "</defs>" &
			
			            "<polygon class=""spark-area"" style=""fill:url(#sparkGradVendido)"" points=""" &
			                vSparkVendidoAreaPontos &
			            """></polygon>" &
			
			            "<polyline class=""spark-line"" points=""" &
			                vSparkVendidoPontos &
			            """></polyline>" &
			
			        "</svg>" &
			    "</div>"
			
			// ==========================================================
			// SPARKLINE MENSAL — FATURADO
			// ==========================================================
			
			VAR tSparkFaturado =
			    ADDCOLUMNS(
			        tSparkMeses,
			        "__ValorFaturado",
			            VAR vInicio = [__DataInicio]
			            VAR vFim = [__DataFim]
			            RETURN
			                COALESCE(
			                    CALCULATE(
			                        IF(
			                            vUsarReceitaBruta,
			                            [08 Faturamento Bruto],
			                            [00 Faturamento]
			                        ),
			                        REMOVEFILTERS('dTempo'),
			                        DATESBETWEEN(
			                            'dTempo'[Data],
			                            vInicio,
			                            vFim
			                        )
			                    ),
			                    0
			                )
			    )
			
			VAR vSparkFaturadoMin =
			    MINX(tSparkFaturado, [__ValorFaturado])
			
			VAR vSparkFaturadoMax =
			    MAXX(tSparkFaturado, [__ValorFaturado])
			
			VAR vSparkFaturadoAmplitude =
			    vSparkFaturadoMax - vSparkFaturadoMin
			
			VAR vSparkFaturadoPontos =
			    CONCATENATEX(
			        tSparkFaturado,
			        VAR vX =
			            DIVIDE([__Ordem] * 220, 11, 0)
			
			        VAR vPosicao =
			            DIVIDE(
			                [__ValorFaturado] - vSparkFaturadoMin,
			                vSparkFaturadoAmplitude,
			                0.5
			            )
			
			        VAR vY =
			            38 - vPosicao * 34
			
			        RETURN
			            SUBSTITUTE(FORMAT(vX, "0.0"), ",", ".")
			                & ","
			                & SUBSTITUTE(FORMAT(vY, "0.0"), ",", "."),
			        " ",
			        [__Ordem],
			        ASC
			    )
			
			VAR vSparkFaturadoAreaPontos =
			    "0,42 "
			        & vSparkFaturadoPontos
			        & " 220,42"
			
			VAR HSparkFaturado =
			    "<div class=""spark-wrap"">" &
			        "<svg class=""spark-svg"" viewBox=""0 0 220 42"" preserveAspectRatio=""none"">" &
			
			            "<defs>" &
			                "<linearGradient id=""sparkGradFaturado"" x1=""0"" y1=""0"" x2=""0"" y2=""1"">" &
			                    "<stop offset=""0%"" stop-color=""#4B8DCE"" stop-opacity=""0.35""></stop>" &
			                    "<stop offset=""100%"" stop-color=""#4B8DCE"" stop-opacity=""0.02""></stop>" &
			                "</linearGradient>" &
			            "</defs>" &
			
			            "<polygon class=""spark-area"" style=""fill:url(#sparkGradFaturado)"" points=""" &
			                vSparkFaturadoAreaPontos &
			            """></polygon>" &
			
			            "<polyline class=""spark-line"" points=""" &
			                vSparkFaturadoPontos &
			            """></polyline>" &
			
			        "</svg>" &
			    "</div>"
			
			// ==========================================================
			// SPARKLINE MENSAL — ENTREGUE
			// ==========================================================
			
			VAR tSparkEntregue =
			    ADDCOLUMNS(
			        tSparkMeses,
			        "__ValorEntregue",
			            VAR vInicio = [__DataInicio]
			            VAR vFim = [__DataFim]
			            RETURN
			                COALESCE(
			                    CALCULATE(
			                        [06 Valor Entregue],
			                        REMOVEFILTERS('dTempo'),
			                        DATESBETWEEN(
			                            'dTempo'[Data],
			                            vInicio,
			                            vFim
			                        )
			                    ),
			                    0
			                )
			    )
			
			VAR vSparkEntregueMin =
			    MINX(tSparkEntregue, [__ValorEntregue])
			
			VAR vSparkEntregueMax =
			    MAXX(tSparkEntregue, [__ValorEntregue])
			
			VAR vSparkEntregueAmplitude =
			    vSparkEntregueMax - vSparkEntregueMin
			
			VAR vSparkEntreguePontos =
			    CONCATENATEX(
			        tSparkEntregue,
			        VAR vX =
			            DIVIDE([__Ordem] * 220, 11, 0)
			
			        VAR vPosicao =
			            DIVIDE(
			                [__ValorEntregue] - vSparkEntregueMin,
			                vSparkEntregueAmplitude,
			                0.5
			            )
			
			        VAR vY =
			            38 - vPosicao * 34
			
			        RETURN
			            SUBSTITUTE(FORMAT(vX, "0.0"), ",", ".")
			                & ","
			                & SUBSTITUTE(FORMAT(vY, "0.0"), ",", "."),
			        " ",
			        [__Ordem],
			        ASC
			    )
			
			VAR vSparkEntregueAreaPontos =
			    "0,42 "
			        & vSparkEntreguePontos
			        & " 220,42"
			
			VAR HSparkEntregue =
			    "<div class=""spark-wrap"">" &
			        "<svg class=""spark-svg"" viewBox=""0 0 220 42"" preserveAspectRatio=""none"">" &
			
			            "<defs>" &
			                "<linearGradient id=""sparkGradEntregue"" x1=""0"" y1=""0"" x2=""0"" y2=""1"">" &
			                    "<stop offset=""0%"" stop-color=""#4B8DCE"" stop-opacity=""0.35""></stop>" &
			                    "<stop offset=""100%"" stop-color=""#4B8DCE"" stop-opacity=""0.02""></stop>" &
			                "</linearGradient>" &
			            "</defs>" &
			
			            "<polygon class=""spark-area"" style=""fill:url(#sparkGradEntregue)"" points=""" &
			                vSparkEntregueAreaPontos &
			            """></polygon>" &
			
			            "<polyline class=""spark-line"" points=""" &
			                vSparkEntreguePontos &
			            """></polyline>" &
			
			        "</svg>" &
			    "</div>"
			
			
			// ==========================================================
			// CONTEXTO DE EMPRESA — HIERARQUIA dEmpresa
			// Empresa > Description
			// ==========================================================
			VAR vEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Empresa]
			    )
			
			VAR vDescricaoEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Description]
			    )
			
			VAR vEmpresaContexto =
			    SWITCH(
			        TRUE(),
			
			        HASONEVALUE('dEmpresa'[Description])
			            && NOT ISBLANK(vDescricaoEmpresaSelecionada),
			            COALESCE(vEmpresaSelecionada, "Empresa")
			                & " › "
			                & vDescricaoEmpresaSelecionada,
			
			        HASONEVALUE('dEmpresa'[Empresa])
			            && NOT ISBLANK(vEmpresaSelecionada),
			            vEmpresaSelecionada,
			
			        ISFILTERED('dEmpresa'[Empresa])
			            || ISFILTERED('dEmpresa'[Description]),
			            "Múltiplas empresas",
			
			        "Grupo"
			    )
			
			VAR vAtualizacaoContexto = [00 Atualização]
			VAR fAtualizacaoContexto =
			    IF(
			        ISBLANK(vAtualizacaoContexto),
			        "-",
			        IF(
			            ISTEXT(vAtualizacaoContexto),
			            TRIM(SUBSTITUTE(vAtualizacaoContexto, "Atualizado em:", "")),
			            FORMAT(vAtualizacaoContexto, "dd/mm/yyyy hh:mm")
			        )
			    )
			
			VAR CSS =
			"<style>
			html,body{
			    margin:0;
			    padding:0;
			    background:#F2F5F9;
			    border:0;
			    outline:0;
			}
			
			:root{
			    --brand:#023F76;
			    --brand-deep:#062A4C;
			    --accent:#0A5CA8;
			    --accent-soft:#E9F1F9;
			    --accent-line:#BDD4E9;
			    --bg:#F2F5F9;
			    --card:#F6F6F6;
			    --card-2:#F3F5F7;
			    --surface-soft:#F0F3F6;
			    --line:#DCE6F1;
			    --line-strong:#C6D0DD;
			    --ink:#071A33;
			    --ink-2:#294664;
			    --ink-3:#51667F;
			    --pos:#176B3A;
			    --neg:#B4231F;
			    --warn:#8F5600;
			    --pos-soft:#E4F3E9;
			    --neg-soft:#FBEAE8;
			    --warn-soft:#FCF1DE;
			    --shadow:0 3px 10px rgba(6,42,76,.08);
			    --radius:12px;
			    --font:'Segoe UI',Arial,sans-serif;
			    --fs-hero:27px;
			    --fs-section:14px;
			    --fs-title:12px;
			    --fs-body:12px;
			    --fs-legend:11px;
			}
			
			.pedfat{
			    font-family:var(--font);
			    background:var(--bg);
			    color:var(--ink);
			    padding:22px 22px 0;
			    box-sizing:border-box;
			    width:100%;
			    margin:0;
			    border:0;
			    outline:0;
			    box-shadow:none;
			    font-size:var(--fs-body);
			    line-height:1.5;
			}
			
			.pedfat *{box-sizing:border-box;}
			
			.title{
			    font-size:var(--fs-section);
			    font-weight:950;
			    letter-spacing:.12em;
			    text-transform:uppercase;
			    color:var(--brand);
			    margin:2px 0 16px;
			    line-height:1.3;
			}
			
			.grid-kpi{
			    display:grid;
			    grid-template-columns:repeat(5,minmax(0,1fr));
			    gap:16px;
			    margin-bottom:22px;
			    align-items:stretch;
			}
			
			.card{
			    background:var(--card);
			    border:1px solid var(--line);
			    border-radius:var(--radius);
			    box-shadow:var(--shadow);
			    padding:20px 22px;
			    position:relative;
			    overflow:hidden;
			    color:var(--ink);
			}
			
			.card h3{
			    font-size:var(--fs-section);
			    font-weight:950;
			    letter-spacing:.105em;
			    text-transform:uppercase;
			    color:var(--brand);
			    margin:0 0 10px;
			    line-height:1.35;
			    padding-right:112px;
			}
			
			.card .sub{
			    max-width:900px;
			    font-size:var(--fs-body);
			    font-weight:600;
			    color:#000000;
			    margin:0 0 18px;
			    line-height:1.55;
			}
			
			.kpi-card{
			    min-height:156px;
			    padding:18px 18px 14px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    text-align:center;
			}
			
			.kpi-card .kpi-lab,
			.kpi-card .kpi-val{
			    width:100%;
			    text-align:center;
			}
			
			.kpi-card .delta-group{
			    width:100%;
			    justify-content:center;
			}
			
			.kpi-card > .delta{
			    width:100%;
			    text-align:center;
			}
			
			.kpi-card-static{
			    min-height:156px;
			}
			
			.kpi-lab{
			    font-size:var(--fs-title);
			    font-weight:950;
			    letter-spacing:.105em;
			    text-transform:uppercase;
			    color:var(--brand);
			    margin-bottom:6px;
			    line-height:1.22;
			    min-height:25px;
			}
			
			.kpi-val{
			    font-size:var(--fs-hero);
			    font-weight:950;
			    color:#000000;
			    letter-spacing:-.035em;
			    line-height:1.08;
			    white-space:nowrap;
			    font-variant-numeric:tabular-nums;
			}
			
			.kpi-val small{
			    font-size:12px;
			    margin-left:3px;
			    color:var(--brand);
			    font-weight:850;
			}
			
			.delta{
			    font-size:13px;
			    font-weight:900;
			    margin-top:7px;
			    display:block;
			    line-height:1.3;
			    min-height:18px;
			}
			
			.delta-group{
			    display:flex;
			    align-items:center;
			    gap:10px;
			    flex-wrap:nowrap;
			    margin-top:7px;
			    min-height:18px;
			}
			
			.delta-group .delta{
			    margin-top:0;
			    min-height:auto;
			    white-space:nowrap;
			}
			
			.delta.pos,.delta.pos .ref{color:var(--pos)!important;}
			.delta.neg,.delta.neg .ref{color:var(--neg)!important;}
			.delta.neu,.delta.neu .ref{color:var(--ink-3)!important;}
			
			.kpi-card-carteira{
			    background:var(--card);
			    border:1px solid #DFE7F0;
			    border-radius:9px;
			    padding:18px 21px 16px;
			    box-shadow:0 2px 7px rgba(6,42,76,.10);
			    min-height:164px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    text-align:center;
			}
			
			.kpi-card-carteira .kpi-lab{
			    width:100%;
			    text-align:center;
			    margin-bottom:11px;
			    min-height:auto;
			}
			
			.kpi-card-carteira .money-split{
			    display:flex;
			    align-items:baseline;
			    justify-content:center;
			    gap:4px;
			    width:100%;
			    white-space:nowrap;
			}
			
			.kpi-card-carteira .currency{
			    font-size:13px;
			    line-height:1;
			    font-weight:950;
			    color:#000000;
			}
			
			.kpi-card-carteira .number{
			    font-size:30px;
			    line-height:1.05;
			    font-weight:950;
			    color:#000000;
			    letter-spacing:-.035em;
			    font-variant-numeric:tabular-nums;
			}
			
			.kpi-card-carteira .unit{
			    font-size:14px;
			    line-height:1;
			    font-weight:950;
			    color:#000000;
			    margin-left:1px;
			}
			
			.kpi-card-carteira .card-context{
			    display:flex;
			    justify-content:center;
			    width:100%;
			    margin-top:9px;
			    font-size:13px;
			    line-height:1.40;
			    font-weight:900;
			    color:var(--ink-3);
			}
			
			.kpi-card-carteira .card-hint{
			    width:100%;
			    margin-top:8px;
			    font-size:13px;
			    line-height:1.40;
			    font-weight:600;
			    color:var(--brand-deep);
			    text-align:center;
			}
			
			.spark-wrap{
			    width:100%;
			    height:44px;
			    margin-top:auto;
			    padding-top:10px;
			    overflow:hidden;
			}
			
			.spark-svg{
			    display:block;
			    width:100%;
			    height:34px;
			}
			
			.spark-line{
			    fill:none;
			    stroke:#4B8DCE;
			    stroke-width:2.2;
			    stroke-linecap:round;
			    stroke-linejoin:round;
			    vector-effect:non-scaling-stroke;
			}
			
			.spark-area{stroke:none;}
			
			.ctxline{display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#F8FAFC;border-top:1px solid #D7E2EE;border-bottom:1px solid #D7E2EE;padding:9px 14px;margin:0 0 12px 0;font-family:var(--font);font-size:14px;color:var(--brand-deep);line-height:1.28;min-height:34px;font-weight:650;}.ctxline b{font-size:13px;font-weight:950;letter-spacing:.11em;text-transform:uppercase;color:var(--brand-deep);margin-right:5px;}.ctxline span{display:inline-flex;align-items:center;white-space:nowrap;}.ctxline .ctx-divider{width:1px;height:22px;background:#D7E2EE;flex:0 0 1px;}.ctxline .ctx-company{display:inline-flex;align-items:center;gap:7px;min-width:0;}.ctxline .ctx-company-label{font-size:12px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand-deep);}.ctxline .ctx-company-value{display:inline-flex;align-items:center;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #BDD4E9;background:#EDF4FB;color:#023F76;border-radius:999px;padding:5px 12px;font-size:12px;font-weight:900;box-shadow:inset 0 0 0 1px rgba(255,255,255,.45);}.ctxline .ctx-right{margin-left:auto;display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;}.ctxline .ctx-base{display:inline-flex;align-items:center;border:1px solid var(--accent-line);background:#E9F1F9;color:var(--brand);border-radius:999px;padding:6px 15px;font-size:12px;font-weight:900;}
			
			.base-receita-flag{
			    display:flex;
			    align-items:center;
			    justify-content:space-between;
			    gap:18px;
			    background:var(--card);
			    border:1px solid #D7E2EE;
			    border-radius:12px;
			    padding:11px 16px;
			    margin-bottom:18px;
			}
			
			.base-receita-title{
			    font-size:11px;
			    font-weight:950;
			    letter-spacing:.12em;
			    text-transform:uppercase;
			    color:var(--brand-deep);
			}
			
			.base-receita-options{
			    display:flex;
			    gap:10px;
			    flex-wrap:wrap;
			}
			
			.base-receita-chip{
			    display:inline-flex;
			    align-items:center;
			    border:1px solid var(--accent-line);
			    background:#E9F1F9;
			    color:var(--brand);
			    border-radius:999px;
			    padding:6px 15px;
			    font-size:12px;
			    font-weight:900;
			}
			
			.badge{
			    display:inline-flex;
			    align-items:center;
			    border:1px solid var(--accent-line);
			    background:var(--card-2);
			    color:var(--brand);
			    border-radius:999px;
			    font-size:var(--fs-legend);
			    font-weight:900;
			    padding:4px 11px;
			    white-space:nowrap;
			    line-height:1.2;
			}
			.chart-title-row{
			    display:flex;
			    align-items:flex-start;
			    justify-content:space-between;
			    gap:12px;
			    margin:0 0 10px;
			}
			.chart-title-row h3{
			    margin:0;
			    padding-right:0;
			    flex:1;
			}
			.chart-badges{
			    display:flex;
			    align-items:center;
			    justify-content:flex-end;
			    gap:7px;
			    flex-wrap:wrap;
			}
			.partial-badge{
			    background:#FFF2D8;
			    border-color:#F0C46A;
			    color:#8F5600;
			}
			
			.anatomy{
			    margin-bottom:0;
			}
			
			.pedfat > *:last-child{
			    margin-bottom:0!important;
			}
			
			.anatomy-bar{
			    height:46px;
			    border-radius:9px;
			    overflow:hidden;
			    display:flex;
			    margin:18px 0;
			    background:#D7E6F5;
			}
			
			.anatomy-rsl,
			.anatomy-tax{
			    display:flex;
			    align-items:center;
			    min-width:0;
			    overflow:hidden;
			    white-space:nowrap;
			    font-size:var(--fs-body);
			    font-weight:900;
			    transition:width .25s ease;
			}
			
			.anatomy-rsl{
			    background:#064372;
			    color:#F6F6F6;
			    padding:0 16px;
			    justify-content:flex-start;
			}
			
			.anatomy-tax{
			    background:#8CB5DB;
			    color:#071A33;
			    padding:0 14px;
			    justify-content:center;
			    border-left:2px solid rgba(246,246,246,.65);
			}
			
			.anatomy-segment-content{
			    display:flex;
			    align-items:center;
			    gap:7px;
			    min-width:0;
			    overflow:hidden;
			}
			
			.anatomy-segment-label{
			    overflow:hidden;
			    text-overflow:ellipsis;
			    white-space:nowrap;
			}
			
			.anatomy-segment-percent{
			    flex:0 0 auto;
			    padding:2px 8px;
			    border-radius:999px;
			    background:rgba(246,246,246,.22);
			    font-size:10px;
			    font-weight:950;
			}
			
			.anatomy-tax .anatomy-segment-percent{
			    background:rgba(246,246,246,.52);
			}
			
			.anatomy-boxes{
			    display:grid;
			    grid-template-columns:1fr 1fr 1fr;
			    gap:16px;
			}
			
			.anatomy-box{
			    border:1px solid #D7E2EE;
			    background:var(--card-2);
			    border-radius:9px;
			    padding:15px 16px;
			    min-height:84px;
			}
			
			.anatomy-box b{
			    display:block;
			    font-size:var(--fs-legend);
			    letter-spacing:.09em;
			    text-transform:uppercase;
			    color:var(--brand);
			    font-weight:950;
			    margin-bottom:9px;
			}
			
			.anatomy-box span{
			    font-size:20px;
			    font-weight:950;
			    color:#000000;
			    white-space:nowrap;
			}
			
			
			@media(max-width:1100px){
			    .pedfat{padding:16px;}
			    .grid-kpi{grid-template-columns:repeat(2,1fr);gap:14px;}
			    .delta-group{flex-wrap:wrap;}
			    .anatomy-boxes{grid-template-columns:1fr;}
			    .card h3{padding-right:0;}
			    .chart-title-row{flex-direction:column;}
			    .chart-badges{justify-content:flex-start;}
			}
			
			
			/* ==========================================================
			   HIERARQUIA TIPOGRAFICA EXECUTIVA — CEO E DIRETORIA
			
			   Numeros decisorios: 30px
			   Titulos de secao e graficos: 16px
			   Titulos dos indicadores: 12px
			   Valores e textos de apoio: 13px
			   Tags e contexto: 12px
			   ========================================================== */
			
			.title{
			    font-size:16px !important;
			    line-height:1.25 !important;
			    font-weight:950 !important;
			    letter-spacing:.12em !important;
			}
			
			.card h3,
			.chart-title-row h3{
			    font-size:16px !important;
			    line-height:1.25 !important;
			    font-weight:950 !important;
			    letter-spacing:.10em !important;
			}
			
			.kpi-lab,
			.anatomy-box b{
			    font-size:12px !important;
			    line-height:1.25 !important;
			    font-weight:900 !important;
			    letter-spacing:.10em !important;
			}
			
			.kpi-val{
			    font-size:30px !important;
			    line-height:1.05 !important;
			    font-weight:950 !important;
			    letter-spacing:-.035em !important;
			}
			
			.anatomy-box span{
			    font-size:22px !important;
			    line-height:1.10 !important;
			    font-weight:950 !important;
			}
			
			.card .sub,
			.delta,
			.delta-group .delta,
			.anatomy-rsl,
			.anatomy-tax{
			    font-size:13px !important;
			    line-height:1.40 !important;
			}
			
			.ctxline{
			    font-size:13px !important;
			    line-height:1.30 !important;
			}
			
			.ctxline b{
			    font-size:12px !important;
			    font-weight:950 !important;
			    letter-spacing:.10em !important;
			}
			
			.badge,
			.partial-badge,
			.ctxline .ctx-base{
			    font-size:12px !important;
			    line-height:1.15 !important;
			    font-weight:900 !important;
			}
			
			.anatomy-segment-percent{
			    font-size:11px !important;
			    font-weight:950 !important;
			}
			
			.ctxline .ctx-company-value{
			    font-size:12px !important;
			    line-height:1.15 !important;
			    font-weight:900 !important;
			}
			
			@media(max-width:900px){
			    .ctxline{gap:9px;}
			    .ctxline .ctx-divider{display:none;}
			    .ctxline .ctx-company{order:3;width:100%;}
			    .ctxline .ctx-company-value{max-width:calc(100% - 78px);}
			    .ctxline .ctx-right{margin-left:auto;}
			}
			
			</style>"
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtualizacaoContexto & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadge &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>" 
			
			VAR HTop =
			    "<div class=""title"">RESUMO DO PERÍODO</div>" &
			    "<div class=""grid-kpi"">" &
			
			        // Card Vendido
			        "<div class=""card kpi-card"">" &
			            "<div class=""kpi-lab"">Vendido (pedidos)</div>" &
			            "<div class=""kpi-val"">" & fVendido & "</div>" &
			            "<div class=""delta-group"">" &
			                "<span class=""delta " & IF(vMoMVendido >= 0, "pos", "neg") & """>" &
			                    IF(vMoMVendido >= 0, sUp, sDn) & " " & fMoMVendido & " MoM" &
			                "</span>" &
			                "<span class=""delta " & IF(vYoYVendido >= 0, "pos", "neg") & """>" &
			                    IF(vYoYVendido >= 0, sUp, sDn) & " " & fYoYVendido & " YoY" &
			                "</span>" &
			            "</div>" &
			            HSparkVendido &
			        "</div>" &
			
			        // Card Faturado
			        "<div class=""card kpi-card"">" &
			            "<div class=""kpi-lab"">" &
			                vNomeFaturamento &
			            "</div>" &
			            "<div class=""kpi-val"">" & fFaturado & "</div>" &
			            "<div class=""delta-group"">" &
			                "<span class=""delta " & IF(vMoMFaturado >= 0, "pos", "neg") & """>" &
			                    IF(vMoMFaturado >= 0, sUp, sDn) & " " & fMoMFaturado & " MoM" &
			                "</span>" &
			                "<span class=""delta " & IF(vYoYFaturado >= 0, "pos", "neg") & """>" &
			                    IF(vYoYFaturado >= 0, sUp, sDn) & " " & fYoYFaturado & " YoY" &
			                "</span>" &
			            "</div>" &
			            HSparkFaturado &
			        "</div>" &
			
			        // Card Entregue
			        "<div class=""card kpi-card"">" &
			            "<div class=""kpi-lab"">Entregue</div>" &
			            "<div class=""kpi-val"">" & fEntregue & "</div>" &
			            "<span class=""delta neu"">" &
			                fPercEntregueReceita &
			                " do Faturamento" &
			            "</span>" &
			           HSparkEntregue &
			        "</div>" &
			
			        // Card Em Aberto — mesmo padrão visual da página Carteira e Estoque
			        "<div class=""card kpi-card kpi-card-static kpi-card-carteira"">" &
			            "<div class=""kpi-lab"">Aberto</div>" &
			            "<div class=""money-split"">" &
			                "<span class=""currency"">R$</span>" &
			                "<span class=""number"">" & fAbertoNum & "</span>" &
			                "<span class=""unit"">mi</span>" &
			            "</div>" &
			            "<div class=""card-context"">" &
			                fPercAbertoCarteira &
			                " da carteira" &
			            "</div>" &
			            "<div class=""card-hint"">Data programada até hoje</div>" &
			        "</div>" &
			
			        // Card Programado — mesmo padrão visual da página Carteira e Estoque
			        "<div class=""card kpi-card kpi-card-static kpi-card-carteira"">" &
			            "<div class=""kpi-lab"">Programado</div>" &
			            "<div class=""money-split"">" &
			                "<span class=""currency"">R$</span>" &
			                "<span class=""number"">" & fProgramadoNum & "</span>" &
			                "<span class=""unit"">mi</span>" &
			            "</div>" &
			            "<div class=""card-context"">M+: " &
			                fProgramadoM &
			            "</div>" &
			            "<div class=""card-hint"">Data programada futura</div>" &
			        "</div>" &
			
			    "</div>"
			
			
			VAR HAnatomia =
			    "<div class=""card anatomy"">" &
			        "<div class=""chart-title-row"">" &
			            "<h3>Anatomia da nota — receita bruta x RSL</h3>" &
			            "<div class=""chart-badges"">" &
			                vParcialBadge &
			                "<span class=""badge"">RB x RSL</span>" &
			            "</div>" &
			        "</div>" &
			
			        "<div class=""anatomy-bar"">" &
			
			            "<div class=""anatomy-rsl"" style=""width:" & wAnatomiaRSL & "%;"">" &
			                "<div class=""anatomy-segment-content"">" &
			                    "<span class=""anatomy-segment-label"">RSL · " &
			                        fRSLBase &
			                    "</span>" &
			                    "<span class=""anatomy-segment-percent"">" & fPercRSLAnatomia & "</span>" &
			                "</div>" &
			            "</div>" &
			
			            IF(
			                vImpostos > 0,
			                "<div class=""anatomy-tax"" style=""width:" & wAnatomiaImpostos & "%;"">" &
			                    "<div class=""anatomy-segment-content"">" &
			                        "<span class=""anatomy-segment-label"">Impostos · " & fImpostos & "</span>" &
			                        "<span class=""anatomy-segment-percent"">" & fPercImpostosAnatomia & "</span>" &
			                    "</div>" &
			                "</div>",
			                ""
			            ) &
			
			        "</div>" &
			
			        "<div class=""anatomy-boxes"">" &
			
			            "<div class=""anatomy-box"">" &
			                "<b>Receita Bruta</b>" &
			                "<span>" & fReceitaBruta & "</span>" &
			            "</div>" &
			
			            "<div class=""anatomy-box"">" &
			                "<b>Receita Semilíquida (RSL)</b>" &
			                "<span>" & fRSLBase & "</span>" &
			            "</div>" &
			
			            "<div class=""anatomy-box"">" &
			                "<b>Devoluções / Refaturamento</b>" &
			                "<span>" & fDevolucao & " + " & fRefaturamento & "</span>" &
			            "</div>" &
			
			        "</div>" &
			    "</div>"
			
			
			RETURN
			CSS &
			HCTX &
			"<div class=""pedfat"">" &
			HTop &
			HAnatomia &
			"</div>"
			```
		displayFolder: Bi_novo
		lineageTag: 4ed55a78-ab8c-462d-a754-3d777765849c

	measure 'Carteira e Estoque HTML v1' = ```
			
			// ===============================================================
			// CARTEIRA & ESTOQUE v4 - Farmax BI (versão enxuta)
			// Mantém apenas:
			//   1) Cards de carteira e perdas do período
			//   2) Waterfall - Funil completo do pedido (venda -> receita)
			//   3) Carteira por motivo de pendência
			//   4) Situação dos pedidos do período (largura inteira; Soro comentado)
			//   5) Pedidos em aberto - maiores valores pendentes (tabela)
			//   6) Pedido x estoque por SKU - risco de ruptura (tabela)
			// =====================================================================
			
			// ===== Filtro de periodo (trava a data na última atualização, ignora slicers Ano/Mes) =====
			VAR vDataRefAtual =
			    VAR vAtuRaw = [00 Atualização]
			    RETURN
			        IFERROR(
			            IF(
			                ISTEXT(vAtuRaw),
			                DATEVALUE(LEFT(TRIM(SUBSTITUTE(vAtuRaw, "Atualizado em:", "")), 10)),
			                DATE(YEAR(vAtuRaw), MONTH(vAtuRaw), DAY(vAtuRaw))
			            ),
			            TODAY()
			        )
			
			VAR vPrimeiroDiaMesAtual = DATE(YEAR(vDataRefAtual), MONTH(vDataRefAtual), 1)
			
			// Snapshot: histórico completo até hoje (Aberto, Programado, TAF, ProgM, etc.)
			VAR fltCarteiraData =
			    CALCULATETABLE(
			        VALUES('dTempo'[Data]),
			        REMOVEFILTERS('dTempo'),
			        REMOVEFILTERS(dMaterial_unificada),
			        'dTempo'[Data] <= vDataRefAtual
			    )
			
			// Fluxo: só o mês corrente da última atualização (Vendas, Cancelado, Devolução, Faturado, Refaturamento, Carteira Inicial)
			VAR fltCarteiraDataMes =
			    CALCULATETABLE(
			        VALUES('dTempo'[Data]),
			        REMOVEFILTERS('dTempo'),
			        REMOVEFILTERS(dMaterial_unificada),
			        'dTempo'[Data] >= vPrimeiroDiaMesAtual,
			        'dTempo'[Data] <= vDataRefAtual
			    )
			
			// Mês anterior (sempre travado no mês anterior à última atualização, ignora slicers)
			VAR vPrimeiroDiaMesAnterior = EOMONTH(vPrimeiroDiaMesAtual, -2) + 1
			VAR vUltimoDiaMesAnterior   = EOMONTH(vPrimeiroDiaMesAtual, -1)
			
			VAR vPrimeiroDiaMesAnteriorMoM = EDATE(vPrimeiroDiaMesAtual, -1)
			VAR vDataRefAnteriorMoM        = EDATE(vDataRefAtual, -1)
			VAR fltCarteiraDataMesAnteriorMoM =
			    CALCULATETABLE(
			        VALUES('dTempo'[Data]),
			        REMOVEFILTERS('dTempo'),
			        REMOVEFILTERS(dMaterial_unificada),
			        'dTempo'[Data] >= vPrimeiroDiaMesAnteriorMoM,
			        'dTempo'[Data] <= vDataRefAnteriorMoM
			    )
			
			VAR fltCarteiraDataMesAnterior =
			    CALCULATETABLE(
			        VALUES('dTempo'[Data]),
			        REMOVEFILTERS('dTempo'),
			        REMOVEFILTERS(dMaterial_unificada),
			        'dTempo'[Data] >= vPrimeiroDiaMesAnterior,
			        'dTempo'[Data] <= vUltimoDiaMesAnterior
			    )
			
			// ===== Leitura dos slicers para a faixa de contexto =====
			VAR vEmpresaTxt =
			    COALESCE(
			        SELECTEDVALUE('dEmpresa'[Company]),
			        IF(ISFILTERED('dEmpresa'), "Selecao multipla", "Todas")
			    )
			VAR vEscopoTxt =
			    IF(
			        NOT ISFILTERED('dEmpresa'),
			        "Consolidado · Farmax + Sanavita",
			        vEmpresaTxt
			    )
			    
			VAR vIsSanavitaOnly =
			    ISFILTERED('dEmpresa'[Empresa]) &&
			    COUNTROWS(
			        FILTER(
			            VALUES('dEmpresa'[Empresa]),
			            NOT ISBLANK('dEmpresa'[Empresa]) &&
			            UPPER('dEmpresa'[Empresa]) <> "SANAVITA"
			        )
			    ) = 0
			
			VAR vBaseReceitaTxt =
			    SELECTEDVALUE('Base Receita'[Base Receita], "Receita Semi Liquida")
			VAR vUsarReceitaBruta = vBaseReceitaTxt = "Receita Bruta"
			VAR vBaseTag = IF(vUsarReceitaBruta, "R$ Bruta", "R$ RSL")
			VAR vTagBase =
			    IF(vUsarReceitaBruta, "BASE RB", "BASE RSL")
			
			// ===== Periodo selecionado (travado na última atualização, ignora slicers) =====
			VAR vDataIniPeriodo = vPrimeiroDiaMesAtual
			VAR vDataFimPeriodo = vDataRefAtual
			
			VAR vMesIniPeriodo =
			    SWITCH(
			        MONTH(vDataIniPeriodo),
			        1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
			        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez",
			        ""
			    )
			VAR vMesFimPeriodo =
			    SWITCH(
			        MONTH(vDataFimPeriodo),
			        1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
			        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez",
			        ""
			    )
			VAR fPeriodoIniCurto = vMesIniPeriodo & "-" & FORMAT(vDataIniPeriodo, "yy")
			VAR fPeriodoFimCurto = vMesFimPeriodo & "-" & FORMAT(vDataFimPeriodo, "yy")
			VAR fPeriodoSelecionado =
			    IF(
			        ISBLANK(vDataIniPeriodo) || ISBLANK(vDataFimPeriodo),
			        "Periodo nao selecionado",
			        IF(
			            YEAR(vDataIniPeriodo) = YEAR(vDataFimPeriodo)
			                && MONTH(vDataIniPeriodo) = MONTH(vDataFimPeriodo),
			            fPeriodoFimCurto,
			            fPeriodoIniCurto & " a " & fPeriodoFimCurto
			        )
			    )
			
			// ===== Medidas base (carteira re-filtrada pelo periodo dos slicers) =====
			VAR vAberto    = COALESCE(CALCULATE([04 Aberto], fltCarteiraData), 0)
			VAR vProg      = COALESCE(CALCULATE([05 Programado], fltCarteiraData), 0)
			VAR vTAF       = COALESCE(CALCULATE([03 Total a Faturar], fltCarteiraData), 0)
			
			VAR vProgM     = COALESCE(CALCULATE([05 Programado M+], fltCarteiraData), 0)
			VAR vVendas    = COALESCE(CALCULATE([00 Valor de Vendas], fltCarteiraDataMes), 0)
			VAR vCancelado = COALESCE(CALCULATE([02 Cancelado], fltCarteiraDataMes), 0)
			VAR vDevolucao = COALESCE(CALCULATE([02 Devolução Total], fltCarteiraDataMes), 0)
			
			// ===== Comparação com mês anterior - Cancelado e Devolução =====
			VAR vCanceladoMesAnterior =
			    COALESCE(
			        CALCULATE([02 Cancelado], fltCarteiraDataMesAnteriorMoM),
			        0
			    )
			VAR vCanceladoDeltaPerc = DIVIDE(vCancelado - vCanceladoMesAnterior, ABS(vCanceladoMesAnterior), 0)
			VAR vCanceladoDeltaCls  = IF(vCanceladoDeltaPerc > 0, "neg", "pos")
			VAR vCanceladoDeltaSeta = IF(vCanceladoDeltaPerc >= 0, "▲", "▼")
			VAR fCanceladoDelta     = vCanceladoDeltaSeta & " " & FORMAT(ABS(vCanceladoDeltaPerc), "0.0%")
			
			VAR vDevolucaoMesAnterior =
			    COALESCE(
			        CALCULATE([02 Devolução Total], fltCarteiraDataMesAnterior),
			        0
			    )
			VAR vDevolucaoDeltaPerc = DIVIDE(vDevolucao - vDevolucaoMesAnterior, vDevolucaoMesAnterior, 0)
			VAR vDevolucaoDeltaCls  = IF(vDevolucaoDeltaPerc > 0, "neg", "pos")
			
			VAR vRefaturamento = COALESCE(CALCULATE([01 Refaturamento], fltCarteiraDataMes), 0)
			VAR fRefaturamento  = "Refaturado " & FORMAT(DIVIDE(vRefaturamento, 1000000), "#,##0.00") & " mi"
			VAR vDevolucaoDeltaSeta = IF(vDevolucaoDeltaPerc >= 0, "▲", "▼")
			VAR fDevolucaoDelta     = vDevolucaoDeltaSeta & " " & FORMAT(ABS(vDevolucaoDeltaPerc), "0.0%")
			VAR vMesAnteriorNum = MONTH(vPrimeiroDiaMesAnterior)
			VAR fMesAnteriorNome =
			    SWITCH(
			        vMesAnteriorNum,
			        1, "jan", 2, "fev", 3, "mar", 4, "abr", 5, "mai", 6, "jun",
			        7, "jul", 8, "ago", 9, "set", 10, "out", 11, "nov", 12, "dez",
			        ""
			    )
			
			// ==========================================================
			// CONTEXTO DE EMPRESA — HIERARQUIA dEmpresa
			// Empresa > Description
			// ==========================================================
			VAR vEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Empresa]
			    )
			
			VAR vDescricaoEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Description]
			    )
			
			VAR vEmpresaContexto =
			    SWITCH(
			        TRUE(),
			
			        HASONEVALUE('dEmpresa'[Description])
			            && NOT ISBLANK(vDescricaoEmpresaSelecionada),
			            COALESCE(vEmpresaSelecionada, "Empresa")
			                & " › "
			                & vDescricaoEmpresaSelecionada,
			
			        HASONEVALUE('dEmpresa'[Empresa])
			            && NOT ISBLANK(vEmpresaSelecionada),
			            vEmpresaSelecionada,
			
			        ISFILTERED('dEmpresa'[Empresa])
			            || ISFILTERED('dEmpresa'[Description]),
			            "Múltiplas empresas",
			
			        "Grupo"
			    )
			
			VAR vAtualizacao = [00 Atualização]
			VAR vProd    = COALESCE(CALCULATE([06 Aguarda Produção], fltCarteiraData), 0)
			
			// =====================================================================
			// MOTIVOS DE PENDÊNCIA — fonte única, usada no card "Carteira por motivo de pendência" (seção 3)
			// =====================================================================
			VAR vMotSemEstoque = COALESCE(CALCULATE([06 Aguarda Produção], fltCarteiraData), 0)
			VAR vMotAguardProg = COALESCE(CALCULATE([00 Customer Service], fltCarteiraData), 0)
			VAR vMotCredito    = COALESCE(CALCULATE([06 Ret.-Limit.créd.exc.], fltCarteiraData), 0)
			VAR vMotBloqFin    =
			    MAX(0,
			        COALESCE(CALCULATE([00 Financeiro], fltCarteiraData), 0) -
			        COALESCE(CALCULATE([06 Ret.-Limit.créd.exc.], fltCarteiraData), 0)
			    )
			VAR vMotLogistica  = COALESCE(CALCULATE([00 Logística], fltCarteiraData), 0)
			VAR vMotNaoClassificado = 
			    MAX(0, vAberto - (vMotSemEstoque + vMotAguardProg + vMotCredito + vMotBloqFin + vMotLogistica))
			
			VAR vMotTotalPrev = MAX(1, vMotSemEstoque + vMotAguardProg + vMotCredito + vMotBloqFin + vMotLogistica + vMotNaoClassificado)
			VAR tMotivos =
			    UNION(
			        ROW("Nome", "Aguardando Produção", "Valor", vMotSemEstoque, "Cor", "#8F5600"),
			        ROW("Nome", "Aguardando programação", "Valor", vMotAguardProg, "Cor", "var(--cat-5)"),
			        ROW("Nome", "Crédito", "Valor", vMotCredito, "Cor", "var(--cat-2)"),
			        ROW("Nome", "Bloqueio financeiro", "Valor", vMotBloqFin, "Cor", "var(--neg)"),
			        ROW("Nome", "Logística", "Valor", vMotLogistica, "Cor", "var(--cat-logistica)"),
			        ROW("Nome", "Não classificado", "Valor", vMotNaoClassificado, "Cor", "var(--ink-3)")
			    )
			VAR tMotivoTop = TOPN(1, tMotivos, [Valor], DESC, [Nome], ASC)
			VAR vMotivoPrincipalNome = MAXX(tMotivoTop, [Nome])
			VAR vMotivoPrincipalCor  = MAXX(tMotivoTop, [Cor])
			VAR vMotivoPrincipalValor = MAXX(tMotivoTop, [Valor])
			VAR fMotivoPrincipalPerc = FORMAT(DIVIDE(vMotivoPrincipalValor, vMotTotalPrev, 0), "0%")
			VAR fMotivoPrincipalValorFmt = FORMAT(DIVIDE(vMotivoPrincipalValor, 1000000), "#,##0.0")
			
			// ===== Percentuais e classes (usados nos cards) =====
			VAR vPercAberto = DIVIDE(vAberto, vTAF, 0)
			VAR vPercProg   = DIVIDE(vProg, vTAF, 0)
			VAR vPercCancel = DIVIDE(vCancelado, vVendas, 0)
			VAR vClsCanc    = IF(vPercCancel <= 0.02, "pos", IF(vPercCancel <= 0.05, "warn", "neg"))
			VAR vPercDevolucao = DIVIDE(vDevolucao, vVendas, 0)
			VAR vClsDevol      = IF(vPercDevolucao <= 0.02, "pos", IF(vPercDevolucao <= 0.05, "warn", "neg"))
			
			// ===== Valores formatados =====
			VAR fTAFNum       = FORMAT(DIVIDE(vTAF, 1000000), "#,##0.0")
			VAR fAbertoNum    = FORMAT(DIVIDE(vAberto, 1000000), "#,##0.0")
			VAR fProgNum      = FORMAT(DIVIDE(vProg, 1000000), "#,##0.0")
			VAR fProgM        = FORMAT(DIVIDE(vProgM, 1000000), "R$ #,##0.0") & " mi"
			VAR vProgMesAtual = vProg - vProgM
			VAR fProgMesAtual = FORMAT(DIVIDE(vProgMesAtual, 1000000), "R$ #,##0.0") & " mi"
			VAR fCancelNum    = FORMAT(DIVIDE(vCancelado, 1000000), "#,##0.0")
			VAR fDevolucaoNum = FORMAT(DIVIDE(vDevolucao, 1000000), "#,##0.0")
			VAR fProdNum      = FORMAT(DIVIDE(vProd, 1000000), "#,##0.0")
			
			VAR fPercAberto   = FORMAT(vPercAberto, "0.0%")
			VAR fPercProg     = FORMAT(vPercProg, "0.0%")
			VAR fPercCancel   = FORMAT(vPercCancel, "0.0%")
			VAR fAtu =
			    IF(
			        ISTEXT(vAtualizacao),
			        TRIM(SUBSTITUTE(vAtualizacao, "Atualizado em:", "")),
			        FORMAT(vAtualizacao, "dd/mm/yyyy hh:mm")
			    )
			VAR vDiaParcial = IFERROR(VALUE(LEFT(fAtu, 2)), DAY(TODAY()))
			VAR fDiaParcial  = FORMAT(vDiaParcial, "0")
			
			VAR vParcialBadge =
			    IF(
			        vDataRefAtual >= vPrimeiroDiaMesAtual,
			        "<span class=""badge partial-badge"">Mês corrente até dia " & fDiaParcial & "</span>",
			        ""
			    )
			
			// =====================================================================
			// 1) CARDS - CARTEIRA E PERDAS DO PERÍODO
			// =====================================================================
			VAR vRSLCarteira =
			    COALESCE(CALCULATE([03 RSL], fltCarteiraDataMes), 0)
			VAR vReceitaBrutaCarteira =
			    COALESCE(CALCULATE([09 Receita Bruta], fltCarteiraDataMes), 0)
			VAR vReceita = IF(vUsarReceitaBruta, vReceitaBrutaCarteira, vRSLCarteira)
			VAR vReceitaMesAnterior =
			    IF(
			        vUsarReceitaBruta,
			        COALESCE(CALCULATE([09 Receita Bruta], fltCarteiraDataMesAnteriorMoM), 0),
			        COALESCE(CALCULATE([03 RSL], fltCarteiraDataMesAnteriorMoM), 0)
			    )
			VAR vReceitaDeltaPerc = DIVIDE(vReceita - vReceitaMesAnterior, ABS(vReceitaMesAnterior), 0)
			-- em receita, subir e bom: o inverso do que valia para devolucao
			VAR vReceitaDeltaCls  = IF(vReceitaDeltaPerc >= 0, "pos", "neg")
			VAR vReceitaDeltaSeta = IF(vReceitaDeltaPerc >= 0, "▲", "▼")
			VAR fReceitaDelta     = vReceitaDeltaSeta & " " & FORMAT(ABS(vReceitaDeltaPerc), "0.0%")
			VAR fReceitaNum       = FORMAT(DIVIDE(vReceita, 1000000), "#,##0.0")
			
			VAR vMetaRBTextoCarteira = TRIM(CALCULATE([Meta RB], fltCarteiraDataMes) & "")
			VAR vMetaReceita =
			    IF(
			        vUsarReceitaBruta,
			        IF(
			            vMetaRBTextoCarteira = "-" || vMetaRBTextoCarteira = "",
			            BLANK(),
			            IFERROR(VALUE(vMetaRBTextoCarteira), BLANK())
			        ),
			        CALCULATE([Meta RSL], fltCarteiraDataMes)
			    )
			VAR vTemMetaReceita = NOT ISBLANK(vMetaReceita) && vMetaReceita <> 0
			VAR fMetaReceita =
			    IF(NOT vTemMetaReceita, "-", FORMAT(DIVIDE(vMetaReceita, 1000000), "R$ #,##0.00") & " mi")
			
			VAR HK0 = "<div class=""seclbl"">Carteira e perdas do período</div><div class=""grid kpis kpis-5"">"
			VAR HK1 = "<div class=""kpi""><div class=""lab"">A Faturar<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Carteira total a faturar: Aberto mais Programado"">i<span class=""info-tip"">Carteira total a faturar: <b>Aberto + Programado</b>.</span></span></div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fTAFNum & "</span><span class=""unit"">mi</span></div><div class=""hint"" style=""margin-top:36px"">Aberto + Programado</div></div>"
			VAR HK2 = "<div class=""kpi"" style=""--kpi-accent:#FBBF24;""><div class=""lab"">Aberto<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Pedidos com data programada ate hoje"">i<span class=""info-tip"">Pedidos cuja data programada de faturamento é <b>até hoje</b> — inclui tanto pedidos <b>atrasados</b> (por falta de estoque, programação, bloqueio financeiro ou logística) quanto pedidos que ainda podem ser faturados hoje.</span></span></div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fAbertoNum & "</span><span class=""unit"">mi</span></div><div class=""deltas""><span class=""delta fl"">" & fPercAberto & " da carteira</span></div><div class=""hint"">Programado até hoje</div></div>"
			VAR HK3 = "<div class=""kpi"" style=""--kpi-accent:#FB923C;""><div class=""lab"">Programado<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Pedidos com data programada futura"">i<span class=""info-tip"">Pedidos que vão ser faturados em uma data <b>futura</b> (amanhã em diante). <b>Mês atual</b>: programado para ainda este mês. <b>Mês+</b>: programado a partir do mês seguinte.</span></span></div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fProgNum & "</span><span class=""unit"">mi</span></div><div class=""deltas deltas-col""><span class=""delta fl"">Mês atual: " & fProgMesAtual & "</span><span class=""delta fl"">Mês+: " & fProgM & "</span></div></div>"
			VAR HK5 = "<div class=""kpi st-" & vClsCanc & """><div class=""lab"">Cancelamento<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Valor cortado em pedidos de venda cancelados no mes corrente"">i<span class=""info-tip"">Valor cortado em pedidos de venda <b>cancelados</b>, no mês corrente.</span></span></div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fCancelNum & "</span><span class=""unit"">mi</span></div><div class=""deltas""><span class=""delta " & vCanceladoDeltaCls & """>" & fCanceladoDelta & " MoM</span></div><div class=""hint"">" & fPercCancel & " do vendido</div></div>"
			VAR HK6 = "<div class=""kpi""><div class=""lab"">Receita<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Faturamento menos devolucoes no mes corrente"">i<span class=""info-tip""><b>Faturamento menos devoluções</b> no mês corrente.</span></span></div><div class=""kpi-val money-split""><span class=""currency"">R$</span><span class=""number"">" & fReceitaNum & "</span><span class=""unit"">mi</span></div><div class=""deltas""><span class=""delta " & vReceitaDeltaCls & """>" & fReceitaDelta & " MoM</span></div><div class=""hint"">Meta: " & fMetaReceita & "</div></div>"
			VAR HKF = "</div>"
			
			// =====================================================================
			// 2) WATERFALL - FUNIL COMPLETO DO PEDIDO - DA VENDA AO FATURADO
			// =====================================================================
			
			// --- Carteira Inicial: SEMPRE RSL ---
			VAR vFunilCarteiraInicial = COALESCE(CALCULATE([10 Carteira Inicial], fltCarteiraDataMes), 0)
			
			// --- Venda: SEMPRE RSL ---
			VAR vFunilVenda = vVendas
			
			// --- Programado M+: Tudo vendido no mês e programado pra meses futuros ---
			VAR vFunilProgramadoMFuturo = COALESCE(CALCULATE([05 Programado M+], fltCarteiraDataMes), 0)
			
			// --- Cancelado: SEMPRE RSL ---
			VAR vFunilCancelado = COALESCE(CALCULATE([02 Cancelado], fltCarteiraDataMes), 0)
			
			// --- Programado Atual: Programado total menos Programado M+ total (o que ainda falta faturar no mês) ---
			VAR vFunilProgramadoAtual = COALESCE(CALCULATE([05 Programado], fltCarteiraData), 0) - COALESCE(CALCULATE([05 Programado M+], fltCarteiraData), 0)
			
			// --- Faturado: SEMPRE RSL (comparação com o valor cascateado pelos motivos) ---
			VAR vFunilFaturado = COALESCE(CALCULATE([00 Faturamento], fltCarteiraDataMes), 0)
			
			VAR vF_CarteiraInicial = vFunilCarteiraInicial
			VAR vF_Venda           = vFunilVenda
			VAR vF_Massa           = vF_CarteiraInicial + vF_Venda - vFunilProgramadoMFuturo
			VAR vF_Faturavel       = vF_Massa - vFunilCancelado
			
			// --- Financeiro: medida direta, sem excluir o crédito (bloqueio + crédito juntos) ---
			VAR vMotFinanceiroFunil = COALESCE(CALCULATE([00 Financeiro], fltCarteiraData), 0)
			
			// --- Cascata dos motivos de pendência (já calculados na seção MOTIVOS DE PENDÊNCIA) ---
			VAR vF_AposSemEstoque   = vF_Faturavel - vMotSemEstoque
			VAR vF_AposAguardProg   = vF_AposSemEstoque - vMotAguardProg
			VAR vF_AposFinanceiro   = vF_AposAguardProg - vMotFinanceiroFunil
			VAR vF_AposLogistica    = vF_AposFinanceiro - vMotLogistica
			VAR vF_AposNaoClassif   = vF_AposLogistica - vMotNaoClassificado
			
			// --- Programado Atual: subtrai por último, antes do Faturado ---
			VAR vF_FaturadoCalc     = vF_AposNaoClassif - vFunilProgramadoAtual
			
			VAR vF_DiferencaTeste = vF_FaturadoCalc - vFunilFaturado
			VAR fDebugTeste = 
			    "FaturadoCalc (Massa - motivos - ProgAtual): R$ " & FORMAT(DIVIDE(vF_FaturadoCalc,1000000),"#,##0.00") & " mi | " &
			    "FaturadoReal: R$ " & FORMAT(DIVIDE(vFunilFaturado,1000000),"#,##0.00") & " mi | " &
			    "Diferença: R$ " & FORMAT(DIVIDE(vF_DiferencaTeste,1000000),"#,##0.00") & " mi"
			
			VAR vF_Faturado = vFunilFaturado
			
			VAR mCarteiraInicial    = DIVIDE(vF_CarteiraInicial, 1000000)
			VAR mVenda              = DIVIDE(vF_Venda, 1000000)
			VAR mProgramadoMFuturo  = DIVIDE(vFunilProgramadoMFuturo, 1000000)
			VAR mCancelado          = DIVIDE(vFunilCancelado, 1000000)
			VAR mFaturavel          = DIVIDE(vF_Faturavel, 1000000)
			VAR mMotSemEstoque      = DIVIDE(vMotSemEstoque, 1000000)
			VAR mMotAguardProg      = DIVIDE(vMotAguardProg, 1000000)
			VAR mMotFinanceiro      = DIVIDE(vMotFinanceiroFunil, 1000000)
			VAR mMotLogistica       = DIVIDE(vMotLogistica, 1000000)
			VAR mMotNaoClassificado = DIVIDE(vMotNaoClassificado, 1000000)
			VAR mProgramadoAtual    = DIVIDE(vFunilProgramadoAtual, 1000000)
			VAR mFaturado           = DIVIDE(vF_Faturado, 1000000)
			
			VAR vMaxAbsRaw =
			    MAXX(
			        {mCarteiraInicial, mVenda, mFaturavel, mFaturado,
			         mProgramadoMFuturo, mCancelado,
			         mMotSemEstoque, mMotAguardProg, mMotFinanceiro, mMotLogistica, mMotNaoClassificado, mProgramadoAtual,
			         mCarteiraInicial + mVenda,
			         mCarteiraInicial + mVenda - mProgramadoMFuturo},
			        ABS([Value])
			    )
			VAR vArred =
			    SWITCH(
			        TRUE(),
			        vMaxAbsRaw <= 5, 1,
			        vMaxAbsRaw <= 20, 2,
			        vMaxAbsRaw <= 50, 5,
			        vMaxAbsRaw <= 100, 10,
			        vMaxAbsRaw <= 500, 50,
			        100
			    )
			VAR vMaxMi = MAX(vArred, CEILING(vMaxAbsRaw * 1.15, vArred))
			VAR vBaseY = 210
			VAR vTopY  = 20
			VAR vPlotH = vBaseY - vTopY
			VAR vScale = DIVIDE(vPlotH, vMaxMi, 0)
			
			VAR hCI  = ABS(mCarteiraInicial) * vScale
			VAR yCI  = IF(mCarteiraInicial >= 0, vBaseY - hCI, vBaseY)
			VAR clsCI = IF(mCarteiraInicial >= 0, "wf-total", "wf-neg")
			
			VAR yAfterVenda = vBaseY - (mCarteiraInicial + mVenda) * vScale
			VAR hVenda = ABS(yAfterVenda - yCI)
			VAR yVendaTop = MIN(yAfterVenda, yCI)
			
			VAR yAfterProgramadoMFuturo = vBaseY - (mCarteiraInicial + mVenda - mProgramadoMFuturo) * vScale
			VAR hProgramadoMFuturo = ABS(yAfterProgramadoMFuturo - yAfterVenda)
			VAR yProgramadoMFuturoTop = MIN(yAfterProgramadoMFuturo, yAfterVenda)
			
			VAR yFaturavel = vBaseY - mFaturavel * vScale
			VAR hCancelado = ABS(yFaturavel - yAfterProgramadoMFuturo)
			VAR yCanceladoTop = MIN(yFaturavel, yAfterProgramadoMFuturo)
			
			VAR hFaturavel = ABS(vBaseY - yFaturavel)
			VAR clsFaturavel = IF(mFaturavel >= 0, "wf-total", "wf-neg")
			
			// --- Cascata dos motivos (Sem Estoque, Aguarda Programação, Financeiro, Logística, Não Classificado) ---
			VAR yAposSemEstoque = vBaseY - (mFaturavel - mMotSemEstoque) * vScale
			VAR hMotSemEstoque = ABS(yAposSemEstoque - yFaturavel)
			VAR yMotSemEstoqueTop = MIN(yFaturavel, yAposSemEstoque)
			
			VAR yAposAguardProg = vBaseY - (mFaturavel - mMotSemEstoque - mMotAguardProg) * vScale
			VAR hMotAguardProg = ABS(yAposAguardProg - yAposSemEstoque)
			VAR yMotAguardProgTop = MIN(yAposSemEstoque, yAposAguardProg)
			
			VAR yAposFinanceiro = vBaseY - (mFaturavel - mMotSemEstoque - mMotAguardProg - mMotFinanceiro) * vScale
			VAR hMotFinanceiro = ABS(yAposFinanceiro - yAposAguardProg)
			VAR yMotFinanceiroTop = MIN(yAposAguardProg, yAposFinanceiro)
			
			VAR yAposLogistica = vBaseY - (mFaturavel - mMotSemEstoque - mMotAguardProg - mMotFinanceiro - mMotLogistica) * vScale
			VAR hMotLogistica = ABS(yAposLogistica - yAposFinanceiro)
			VAR yMotLogisticaTop = MIN(yAposFinanceiro, yAposLogistica)
			
			VAR yAposNaoClassificado = vBaseY - (mFaturavel - mMotSemEstoque - mMotAguardProg - mMotFinanceiro - mMotLogistica - mMotNaoClassificado) * vScale
			VAR hMotNaoClassificado = ABS(yAposNaoClassificado - yAposLogistica)
			VAR yMotNaoClassificadoTop = MIN(yAposLogistica, yAposNaoClassificado)
			
			// --- Programado Atual: subtrai por último, antes do Faturado ---
			VAR yAposProgramadoAtual = vBaseY - (mFaturavel - mMotSemEstoque - mMotAguardProg - mMotFinanceiro - mMotLogistica - mMotNaoClassificado - mProgramadoAtual) * vScale
			VAR hProgramadoAtual = ABS(yAposProgramadoAtual - yAposNaoClassificado)
			VAR yProgramadoAtualTop = MIN(yAposNaoClassificado, yAposProgramadoAtual)
			
			VAR yFaturado = vBaseY - mFaturado * vScale
			VAR hFaturado = ABS(vBaseY - yFaturado)
			VAR clsFaturado = IF(mFaturado >= 0, "wf-total", "wf-neg")
			
			VAR bw = 70
			VAR x1  = 90    // Carteira Inicial
			VAR x2  = 205   // Vendas do Mês
			VAR x3  = 320   // Programado M+
			VAR x4  = 435   // Cancelados
			VAR x5  = 550   // Massa Disponível
			VAR x6  = 665   // Aguarda Produção
			VAR x7  = 780   // Aguarda Programação
			VAR x8  = 895   // Financeiro (Crédito + Bloqueio Financeiro)
			VAR x9  = 1010  // Logística
			VAR x10 = 1125  // Não Classificado
			VAR x11 = 1240  // Programado Atual
			VAR x12 = 1355  // Faturado
			
			VAR vBandTop    = vBaseY + 10
			VAR vBandBottom = vBaseY + 46
			VAR vBandH      = vBandBottom - vBandTop
			VAR vBandPad    = 12
			
			VAR vYelX = x6 - vBandPad
			VAR vYelW = (x10 + bw + vBandPad) - vYelX
			VAR HBandMotivos =
			    "<rect x=""" & FORMAT(vYelX,"0") & """ y=""" & FORMAT(vBandTop,"0") & """ width=""" & FORMAT(vYelW,"0") & """ height=""" & FORMAT(vBandH,"0") & """ fill=""#FDE68A"" opacity=""0.35"" rx=""8""/>"
			
			VAR vLarW = bw + vBandPad * 2
			VAR HBandProgMFuturo =
			    "<rect x=""" & FORMAT(x3 - vBandPad,"0") & """ y=""" & FORMAT(vBandTop,"0") & """ width=""" & FORMAT(vLarW,"0") & """ height=""" & FORMAT(vBandH,"0") & """ fill=""#FDBA74"" opacity=""0.35"" rx=""8""/>"
			VAR HBandProgAtual =
			    "<rect x=""" & FORMAT(x11 - vBandPad,"0") & """ y=""" & FORMAT(vBandTop,"0") & """ width=""" & FORMAT(vLarW,"0") & """ height=""" & FORMAT(vBandH,"0") & """ fill=""#FDBA74"" opacity=""0.35"" rx=""8""/>"
			VAR HBandCancelados =
			    "<rect x=""" & FORMAT(x4 - vBandPad,"0") & """ y=""" & FORMAT(vBandTop,"0") & """ width=""" & FORMAT(vLarW,"0") & """ height=""" & FORMAT(vBandH,"0") & """ fill=""#FCA5A5"" opacity=""0.35"" rx=""8""/>"
			
			VAR gStep = DIVIDE(vMaxMi, 5, 0)
			VAR g1v = gStep * 1
			VAR g2v = gStep * 2
			VAR g3v = gStep * 3
			VAR g4v = gStep * 4
			VAR g5v = gStep * 5
			VAR g1y = vBaseY - g1v * vScale
			VAR g2y = vBaseY - g2v * vScale
			VAR g3y = vBaseY - g3v * vScale
			VAR g4y = vBaseY - g4v * vScale
			VAR g5y = vBaseY - g5v * vScale
			
			VAR HGrid =
			    "<line x1=""65"" y1=""" & FORMAT(vBaseY,"0") & """ x2=""1405"" y2=""" & FORMAT(vBaseY,"0") & """ class=""axis-line""/>" &
			    "<text x=""0"" y=""" & FORMAT(vBaseY+4,"0") & """ class=""axis-label"">0,0 mi</text>" &
			    "<line x1=""65"" y1=""" & FORMAT(g1y,"0") & """ x2=""1405"" y2=""" & FORMAT(g1y,"0") & """ class=""axis-line"" opacity="".5""/>" &
			    "<text x=""0"" y=""" & FORMAT(g1y+4,"0") & """ class=""axis-label"">" & FORMAT(g1v,"#,##0.0") & " mi</text>" &
			    "<line x1=""65"" y1=""" & FORMAT(g2y,"0") & """ x2=""1405"" y2=""" & FORMAT(g2y,"0") & """ class=""axis-line"" opacity="".5""/>" &
			    "<text x=""0"" y=""" & FORMAT(g2y+4,"0") & """ class=""axis-label"">" & FORMAT(g2v,"#,##0.0") & " mi</text>" &
			    "<line x1=""65"" y1=""" & FORMAT(g3y,"0") & """ x2=""1405"" y2=""" & FORMAT(g3y,"0") & """ class=""axis-line"" opacity="".5""/>" &
			    "<text x=""0"" y=""" & FORMAT(g3y+4,"0") & """ class=""axis-label"">" & FORMAT(g3v,"#,##0.0") & " mi</text>" &
			    "<line x1=""65"" y1=""" & FORMAT(g4y,"0") & """ x2=""1405"" y2=""" & FORMAT(g4y,"0") & """ class=""axis-line"" opacity="".5""/>" &
			    "<text x=""0"" y=""" & FORMAT(g4y+4,"0") & """ class=""axis-label"">" & FORMAT(g4v,"#,##0.0") & " mi</text>" &
			    "<line x1=""65"" y1=""" & FORMAT(g5y,"0") & """ x2=""1405"" y2=""" & FORMAT(g5y,"0") & """ class=""axis-line"" opacity="".5""/>" &
			    "<text x=""0"" y=""" & FORMAT(g5y+4,"0") & """ class=""axis-label"">" & FORMAT(g5v,"#,##0.0") & " mi</text>"
			
			VAR HBarCarteiraInicial =
			    IF(
			        vIsSanavitaOnly,
			        "",
			        "<rect x=""" & x1 & """ y=""" & FORMAT(yCI,"0") & """ width=""" & bw & """ height=""" & FORMAT(hCI,"0") & """ class=""" & clsCI & """ rx=""2""/>" &
			        "<text x=""" & FORMAT(x1+bw/2,"0") & """ y=""" & FORMAT(yCI-10,"0") & """ class=""axis-label"" text-anchor=""middle"">" & FORMAT(mCarteiraInicial,"#,##0.0") & " mi</text>" &
			        "<text x=""" & FORMAT(x1+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			            "<tspan x=""" & FORMAT(x1+bw/2,"0") & """ dy=""0"">Carteira</tspan>" &
			            "<tspan x=""" & FORMAT(x1+bw/2,"0") & """ dy=""14"">Inicial</tspan>" &
			        "</text>"
			    )
			    
			VAR HBarVenda =
			    "<rect x=""" & x2 & """ y=""" & FORMAT(yVendaTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hVenda,"0") & """ style=""fill:var(--accent)"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x2+bw/2,"0") & """ y=""" & FORMAT(yVendaTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"">+" & FORMAT(mVenda,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x2+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x2+bw/2,"0") & """ dy=""0"">Venda do</tspan>" &
			        "<tspan x=""" & FORMAT(x2+bw/2,"0") & """ dy=""14"">Mês</tspan>" &
			    "</text>"
			
			VAR HBarProgramadoMFuturo =
			    "<rect x=""" & x3 & """ y=""" & FORMAT(yProgramadoMFuturoTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hProgramadoMFuturo,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x3+bw/2,"0") & """ y=""" & FORMAT(yProgramadoMFuturoTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mProgramadoMFuturo,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x3+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x3+bw/2,"0") & """ dy=""0"">Programado</tspan>" &
			        "<tspan x=""" & FORMAT(x3+bw/2,"0") & """ dy=""14"">M+</tspan>" &
			    "</text>"
			
			VAR HBarCancelado =
			    "<rect x=""" & x4 & """ y=""" & FORMAT(yCanceladoTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hCancelado,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x4+bw/2,"0") & """ y=""" & FORMAT(yCanceladoTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mCancelado,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x4+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">Cancelado</text>"
			
			VAR HBarFaturavel =
			    "<rect x=""" & x5 & """ y=""" & FORMAT(yFaturavel,"0") & """ width=""" & bw & """ height=""" & FORMAT(hFaturavel,"0") & """ class=""" & clsFaturavel & """ rx=""2""/>" &
			    "<text x=""" & FORMAT(x5+bw/2,"0") & """ y=""" & FORMAT(yFaturavel-10,"0") & """ class=""axis-label"" text-anchor=""middle"">" & FORMAT(mFaturavel,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x5+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x5+bw/2,"0") & """ dy=""0"">Massa Disponível</tspan>" &
			        "<tspan x=""" & FORMAT(x5+bw/2,"0") & """ dy=""14"">para Faturamento</tspan>" &
			    "</text>"
			
			VAR HBarMotSemEstoque =
			    "<rect x=""" & x6 & """ y=""" & FORMAT(yMotSemEstoqueTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hMotSemEstoque,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x6+bw/2,"0") & """ y=""" & FORMAT(yMotSemEstoqueTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mMotSemEstoque,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x6+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x6+bw/2,"0") & """ dy=""0"">Aguarda</tspan>" &
			        "<tspan x=""" & FORMAT(x6+bw/2,"0") & """ dy=""14"">Produção</tspan>" &
			    "</text>"
			
			VAR HBarMotAguardProg =
			    "<rect x=""" & x7 & """ y=""" & FORMAT(yMotAguardProgTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hMotAguardProg,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x7+bw/2,"0") & """ y=""" & FORMAT(yMotAguardProgTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mMotAguardProg,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x7+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x7+bw/2,"0") & """ dy=""0"">Aguarda</tspan>" &
			        "<tspan x=""" & FORMAT(x7+bw/2,"0") & """ dy=""14"">Programação</tspan>" &
			    "</text>"
			
			VAR HBarMotFinanceiro =
			    "<rect x=""" & x8 & """ y=""" & FORMAT(yMotFinanceiroTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hMotFinanceiro,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x8+bw/2,"0") & """ y=""" & FORMAT(yMotFinanceiroTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mMotFinanceiro,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x8+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">Financeiro</text>"
			
			VAR HBarMotLogistica =
			    "<rect x=""" & x9 & """ y=""" & FORMAT(yMotLogisticaTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hMotLogistica,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x9+bw/2,"0") & """ y=""" & FORMAT(yMotLogisticaTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mMotLogistica,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x9+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">Logística</text>"
			
			VAR HBarMotNaoClassificado =
			    "<rect x=""" & x10 & """ y=""" & FORMAT(yMotNaoClassificadoTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hMotNaoClassificado,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x10+bw/2,"0") & """ y=""" & FORMAT(yMotNaoClassificadoTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mMotNaoClassificado,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x10+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x10+bw/2,"0") & """ dy=""0"">Não</tspan>" &
			        "<tspan x=""" & FORMAT(x10+bw/2,"0") & """ dy=""14"">Classificado</tspan>" &
			    "</text>"
			
			VAR HBarProgramadoAtual =
			    "<rect x=""" & x11 & """ y=""" & FORMAT(yProgramadoAtualTop,"0") & """ width=""" & bw & """ height=""" & FORMAT(hProgramadoAtual,"0") & """ class=""wf-neg"" rx=""2""/>" &
			    "<text x=""" & FORMAT(x11+bw/2,"0") & """ y=""" & FORMAT(yProgramadoAtualTop-10,"0") & """ class=""axis-label"" text-anchor=""middle"" fill=""var(--neg)"">-" & FORMAT(mProgramadoAtual,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x11+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">" &
			        "<tspan x=""" & FORMAT(x11+bw/2,"0") & """ dy=""0"">Programado</tspan>" &
			        "<tspan x=""" & FORMAT(x11+bw/2,"0") & """ dy=""14"">Mês Atual</tspan>" &
			    "</text>"
			
			VAR HBarFaturado =
			    "<rect x=""" & x12 & """ y=""" & FORMAT(yFaturado,"0") & """ width=""" & bw & """ height=""" & FORMAT(hFaturado,"0") & """ class=""" & clsFaturado & """ rx=""2""/>" &
			    "<text x=""" & FORMAT(x12+bw/2,"0") & """ y=""" & FORMAT(yFaturado-10,"0") & """ class=""axis-label"" text-anchor=""middle"">" & FORMAT(mFaturado,"#,##0.0") & " mi</text>" &
			    "<text x=""" & FORMAT(x12+bw/2,"0") & """ y=""" & FORMAT(vBaseY+22,"0") & """ class=""axis-label-cat"" text-anchor=""middle"" fill=""var(--accent)"">Faturado</text>"
			
			VAR HHoverZones =
			    CONCATENATEX(
			        {x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12},
			        "<rect class=""wf-hoverzone"" x=""" & FORMAT([Value]-15,"0") & """ y=""" & FORMAT(vTopY,"0") & """ width=""" & FORMAT(bw+30,"0") & """ height=""" & FORMAT(vPlotH,"0") & """/>",
			        ""
			    )
			
			VAR vSVGFunil =
			    "<svg class=""chart"" viewBox=""0 0 1445 260"" aria-label=""Funil completo do pedido - da venda ao faturado"">" &
			    HBandMotivos & HBandProgMFuturo & HBandProgAtual & HBandCancelados &
			    HGrid &
			    HHoverZones &
			    HBarCarteiraInicial & HBarVenda & HBarProgramadoMFuturo & HBarCancelado & HBarFaturavel &
			    HBarMotSemEstoque & HBarMotAguardProg & HBarMotFinanceiro & HBarMotLogistica & HBarMotNaoClassificado &
			    HBarProgramadoAtual & HBarFaturado &
			    "</svg>"
			
			VAR HFUNIL =
			    "<div class=""card col-12""><h3 class=""graph-title""><span class=""graph-title-text"">Funil completo do pedido</span><span class=""graph-title-badges""><label class=""info"" for=""infoFunil"" tabindex=""0"" role=""button"" aria-label=""Ver descrição do funil completo do pedido"">i</label></span></h3>" &
			    "<input type=""checkbox"" id=""infoFunil"" class=""info-toggle"">" &
			    "<div class=""info-panel""><ul><li><b>Carteira Inicial:</b> saldo de pedidos a faturar herdado dos meses anteriores, anterior ao início das vendas do mês corrente.</li><li><b>Venda do Mês:</b> valor total de pedidos vendidos no mês corrente.</li><li><b>Programado M+:</b> pedidos vendidos no mês corrente com faturamento programado para meses subsequentes.</li><li><b>Cancelado:</b> valor total de pedidos cancelados no mês corrente.</li><li><b>Massa Disponível para Faturamento:</b> saldo passível de faturamento no mês, correspondente à Carteira Inicial mais Vendas, deduzidos Programado M+ e Cancelado.</li><li><b>Aguarda Produção:</b> pedido retido por indisponibilidade de estoque.</li><li><b>Aguarda Programação:</b> pedido pendente de definição de data pela área de Customer Service.</li><li><b>Financeiro:</b> pendências por motivos financeiros.</li><li><b>Logística:</b> pendência relacionada a etapas logísticas.</li><li><b>Não Classificado:</b> diferença residual não associada a um motivo específico de retenção.</li><li><b>Programado Mês Atual:</b> pedidos já programados para faturamento dentro do mês corrente.</li><li><b>Faturado:</b> valor efetivamente faturado no mês corrente.</li></ul></div>" &
			    "<div class=""chart-wrap"">" & vSVGFunil & "</div>" &
			    //"<div style=""margin-top:8px;padding:8px 12px;background:#FFF3CD;border:1px solid #FFE69C;border-radius:6px;font-size:12px;font-weight:700;color:#664D03;"">🔍 DEBUG: " & fDebugTeste & "</div>" &
			    "</div>"
			
			/*// =====================================================================
			// 3) ABERTO POR MOTIVO DE PENDÊNCIA
			// =====================================================================
			VAR vMotTotal = MAX(1, vMotSemEstoque + vMotAguardProg + vMotCredito + vMotBloqFin + vMotLogistica + vMotNaoClassificado)
			VAR wMotSemEstoque = SUBSTITUTE(FORMAT(DIVIDE(vMotSemEstoque, vMotTotal, 0) * 100, "0.0"), ",", ".")
			VAR wMotAguardProg = SUBSTITUTE(FORMAT(DIVIDE(vMotAguardProg, vMotTotal, 0) * 100, "0.0"), ",", ".")
			VAR wMotCredito    = SUBSTITUTE(FORMAT(DIVIDE(vMotCredito, vMotTotal, 0) * 100, "0.0"), ",", ".")
			VAR wMotBloqFin    = SUBSTITUTE(FORMAT(DIVIDE(vMotBloqFin, vMotTotal, 0) * 100, "0.0"), ",", ".")
			VAR wMotLogistica  = SUBSTITUTE(FORMAT(DIVIDE(vMotLogistica, vMotTotal, 0) * 100, "0.0"), ",", ".")
			VAR wMotNaoClassificado = SUBSTITUTE(FORMAT(DIVIDE(vMotNaoClassificado, vMotTotal, 0) * 100, "0.0"), ",", ".")
			
			VAR fMotSemEstoque = IF(vMotSemEstoque >= 1000000, "R$ " & FORMAT(DIVIDE(vMotSemEstoque,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotSemEstoque,1000),"#,##0") & " mil")
			VAR fMotAguardProg = IF(vMotAguardProg >= 1000000, "R$ " & FORMAT(DIVIDE(vMotAguardProg,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotAguardProg,1000),"#,##0") & " mil")
			VAR fMotCredito    = IF(vMotCredito >= 1000000, "R$ " & FORMAT(DIVIDE(vMotCredito,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotCredito,1000),"#,##0") & " mil")
			VAR fMotBloqFin    = IF(vMotBloqFin >= 1000000, "R$ " & FORMAT(DIVIDE(vMotBloqFin,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotBloqFin,1000),"#,##0") & " mil")
			VAR fMotLogistica  = IF(vMotLogistica >= 1000000, "R$ " & FORMAT(DIVIDE(vMotLogistica,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotLogistica,1000),"#,##0") & " mil")
			VAR fMotNaoClassificado = IF(vMotNaoClassificado >= 1000000, "R$ " & FORMAT(DIVIDE(vMotNaoClassificado,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vMotNaoClassificado,1000),"#,##0") & " mil")
			
			VAR pMotSemEstoque = FORMAT(DIVIDE(vMotSemEstoque, vMotTotal, 0), "0%")
			VAR pMotAguardProg = FORMAT(DIVIDE(vMotAguardProg, vMotTotal, 0), "0%")
			VAR pMotCredito    = FORMAT(DIVIDE(vMotCredito, vMotTotal, 0), "0%")
			VAR pMotBloqFin    = FORMAT(DIVIDE(vMotBloqFin, vMotTotal, 0), "0%")
			VAR pMotLogistica  = FORMAT(DIVIDE(vMotLogistica, vMotTotal, 0), "0%")
			VAR pMotNaoClassificado = FORMAT(DIVIDE(vMotNaoClassificado, vMotTotal, 0), "0%")
			
			VAR HMotStack =
			    "<div class=""mot-stack"">" &
			    "<div style=""width:" & wMotSemEstoque & "%;background:#8F5600"" title=""Aguardando Produção""></div>" &
			    "<div style=""width:" & wMotAguardProg & "%;background:var(--cat-5)"" title=""Aguardando programação""></div>" &
			    "<div style=""width:" & wMotCredito & "%;background:var(--cat-2)"" title=""Crédito""></div>" &
			    "<div style=""width:" & wMotBloqFin & "%;background:var(--neg)"" title=""Bloqueio financeiro""></div>" &
			    "<div style=""width:" & wMotLogistica & "%;background:var(--cat-logistica)"" title=""Logística""></div>" &
			    "<div style=""width:" & wMotNaoClassificado & "%;background:var(--ink-3)"" title=""Não classificado""></div>" &
			    "</div>"
			
			VAR HMotLegend =
			    "<div class=""mot-legend"">" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:#8F5600""></span><span class=""lbl"">Aguardando Produção</span><span class=""val"">" & fMotSemEstoque & "</span><span class=""pct"">" & pMotSemEstoque & "</span></div>" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:var(--cat-5)""></span><span class=""lbl"">Aguardando programação</span><span class=""val"">" & fMotAguardProg & "</span><span class=""pct"">" & pMotAguardProg & "</span></div>" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:var(--cat-2)""></span><span class=""lbl"">Crédito</span><span class=""val"">" & fMotCredito & "</span><span class=""pct"">" & pMotCredito & "</span></div>" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:var(--neg)""></span><span class=""lbl"">Bloqueio financeiro</span><span class=""val"">" & fMotBloqFin & "</span><span class=""pct"">" & pMotBloqFin & "</span></div>" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:var(--cat-logistica)""></span><span class=""lbl"">Logística</span><span class=""val"">" & fMotLogistica & "</span><span class=""pct"">" & pMotLogistica & "</span></div>" &
			    "<div class=""mot-item""><span class=""dot"" style=""background:var(--ink-3)""></span><span class=""lbl"">Não classificado</span><span class=""val"">" & fMotNaoClassificado & "</span><span class=""pct"">" & pMotNaoClassificado & "</span></div>" &
			    "</div>"
			
			VAR HMOTIVO =
			    "<div class=""card col-12""><h3 class=""graph-title""><span class=""graph-title-text"">Aberto por Motivo de Pendência</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTag & "</span></span></h3>" &
			    HMotStack & HMotLegend &
			    "</div>"
			
			// =====================================================================
			// 4) SITUAÇÃO DOS PEDIDOS DO PERÍODO (stacked bar) - largura inteira
			// PLACEHOLDER: trocar pelas medidas reais de status por pedido
			// =====================================================================
			VAR vSitEntregue  = COALESCE(CALCULATE([06 Valor Entregue], fltCarteiraDataMes), 0)
			VAR vSitTransito  = COALESCE(CALCULATE([07 Valor Em Transito], fltCarteiraData), 0)
			VAR vSitProgramado = COALESCE(CALCULATE([05 Programado], fltCarteiraData), 0)
			VAR vSitAberto = COALESCE(CALCULATE([04 Aberto Ajustado], fltCarteiraData), 0)
			VAR vSitBloqueio  = COALESCE(CALCULATE([00 Financeiro Ajustado], fltCarteiraData), 0)
			VAR vSitCancelado = COALESCE(CALCULATE([02 Cancelado Ajustado], fltCarteiraDataMes), 0)
			
			VAR nSitEntregue   = COALESCE(CALCULATE([06 Qtd Pedidos Entregues], fltCarteiraDataMes), 0)
			VAR nSitTransito   = COALESCE(CALCULATE([07 Qtd Pedidos Em Transito], fltCarteiraData), 0)
			VAR nSitProgramado = COALESCE(CALCULATE([05 Qtd Pedidos Programados], fltCarteiraData), 0)
			VAR nSitAberto     = COALESCE(CALCULATE([04 Qtd Pedidos Aberto], fltCarteiraData), 0)
			VAR nSitBloqueio   = COALESCE(CALCULATE([00 Qtd Pedidos Financeiro], fltCarteiraData), 0)
			VAR nSitCancelado  = COALESCE(CALCULATE([02 Qtd Pedidos Cancelados], fltCarteiraDataMes), 0)
			
			VAR vSitTotal = MAX(1,
			    vSitEntregue + vSitTransito /*+ vSitFaturado */+ vSitProgramado +
			    vSitAberto + vSitBloqueio + vSitCancelado
			)
			
			VAR fSitEntregue   = FORMAT(DIVIDE(vSitEntregue, 1000000), "R$ #,##0.00") & " mi"
			VAR fSitTransito   = FORMAT(DIVIDE(vSitTransito, 1000000), "R$ #,##0.00") & " mi"
			VAR fSitProgramado = FORMAT(DIVIDE(vSitProgramado, 1000000), "R$ #,##0.00") & " mi"
			VAR fSitAberto     = FORMAT(DIVIDE(vSitAberto, 1000000), "R$ #,##0.00") & " mi"
			VAR fSitBloqueio   = FORMAT(DIVIDE(vSitBloqueio, 1000), "R$ #,##0") & " mil"
			VAR fSitCancelado  = FORMAT(DIVIDE(vSitCancelado, 1000000), "R$ #,##0.00") & " mi"
			
			VAR HSitLegend =
			    "<div class=""sit-legend"">" &
			    "<div class=""sit-legend-item""><span class=""lbl""><span class=""dot"" style=""background:var(--sc-real)""></span>Entregue</span><span class=""val"">" & fSitEntregue & "</span><span class=""cnt"">" & FORMAT(nSitEntregue,"#,##0") & " ped.</span></div>" &
			    "<div class=""sit-legend-item""><span class=""lbl""><span class=""dot"" style=""background:var(--cat-3)""></span>Em trânsito</span><span class=""val"">" & fSitTransito & "</span><span class=""cnt"">" & FORMAT(nSitTransito,"#,##0") & " ped.</span></div>" &
			    "<div class=""sit-legend-item""><span class=""lbl""><span class=""dot"" style=""background:var(--cat-5)""></span>Programado</span><span class=""val"">" & fSitProgramado & "</span><span class=""cnt"">" & FORMAT(nSitProgramado,"#,##0") & " ped.</span></div>" &
			    "<div class=""sit-legend-item""><span class=""lbl""><span class=""dot"" style=""background:var(--warn-bright)""></span>Em aberto</span><span class=""val"">" & fSitAberto & "</span><span class=""cnt"">" & FORMAT(nSitAberto,"#,##0") & " ped.</span></div>" &
			    "<div class=""sit-legend-item""><span class=""lbl""><span class=""dot"" style=""background:var(--neg)""></span>Bloqueio financeiro</span><span class=""val"">" & fSitBloqueio & "</span><span class=""cnt"">" & FORMAT(nSitBloqueio,"#,##0") & " ped.</span></div>" &
			    "<div class=""sit-legend-item sit-legend-loss""><span class=""lbl""><span class=""dot"" style=""background:var(--neg-bright)""></span>Cancelado</span><span class=""val"">" & fSitCancelado & "</span><span class=""cnt"">" & FORMAT(nSitCancelado,"#,##0") & " ped.</span></div>" &
			    "</div>"
			
			VAR HSITUACAO =
			    "<div class=""card col-12""><h3 class=""graph-title""><span class=""graph-title-text"">Situação dos pedidos do período</span><span class=""graph-title-badges""><span class=""basetag"">" & vBaseTag & "</span></span></h3>" &
			    HSitLegend &
			    "</div>"
			*/
			// =====================================================================
			// 5) PEDIDOS EM ABERTO — MAIORES VALORES PENDENTES (tabela)
			// =====================================================================
			VAR tPedidosFarmax =
			    CALCULATETABLE(
			        SUMMARIZECOLUMNS(
			            fVendas_unificada[pedido],
			            fVendas_unificada[data_pedido],
			            fVendas_unificada[chave_cliente],
			            fVendas_unificada[sku],
			            fVendas_unificada[canal_n1],
			            fVendas_unificada[regional_cod],
			            fVendas_unificada[sale_program_date],
			            fVendas_unificada[obt_sales_department_status],
			            "Pendente", SUM(fVendas_unificada[order_sale_subtotal])
			        ),
			        fVendas_unificada[pedido_tipo] = "VENDA",
			        fVendas_unificada[empresa] = "FARMAX",
			        fVendas_unificada[pedido_status] = "A FATURAR"
			    )
			
			VAR tPedidosSanavita =
			    CALCULATETABLE(
			        SUMMARIZECOLUMNS(
			            fVendas_unificada[pedido],
			            fVendas_unificada[data_pedido],
			            fVendas_unificada[chave_cliente],
			            fVendas_unificada[sku],
			            fVendas_unificada[canal_n1],
			            fVendas_unificada[regional_cod],
			            fVendas_unificada[sale_program_date],
			            fVendas_unificada[obt_sales_department_status],
			            "Pendente", SUM(fVendas_unificada[order_sale_subtotal])
			        ),
			        fVendas_unificada[pedido_tipo] = "VENDA",
			        fVendas_unificada[empresa] = "SANAVITA",
			        fVendas_unificada[pedido_status] = "A FATURAR"
			    )
			
			VAR tPedidosBase = UNION(tPedidosFarmax, tPedidosSanavita)
			
			VAR tPedidosComNomeCliente =
			    ADDCOLUMNS(
			        tPedidosBase,
			        "__NomeCliente",
			            VAR vChaveCli = [chave_cliente]
			            RETURN
			                LOOKUPVALUE(dClientes_unificada[cliente], dClientes_unificada[chave_cliente], vChaveCli),
			        "__NomeSKU",
			            VAR vCodProd = [sku]
			            RETURN
			                LOOKUPVALUE(dMaterial_unificada[descricao], dMaterial_unificada[codigo_produto], vCodProd),
			        "__NomeRegional",
			            VAR vCodRegional = [regional_cod]
			            RETURN
			                LOOKUPVALUE(dRegional[order_sale_order_office], dRegional[order_sale_order_office_code], vCodRegional)
			    )
			
			VAR tPedidosComTrim =
			    ADDCOLUMNS(
			        tPedidosComNomeCliente,
			        "__StatusDeptTrim",
			            TRIM([obt_sales_department_status])
			    )
			
			VAR tPedidosComNome =
			    ADDCOLUMNS(
			        tPedidosComTrim,
			        "__StatusTxt",
			            IF(ISBLANK([sale_program_date]) || [sale_program_date] <= vDataRefAtual, "Em aberto", "Programado"),
			        "__StatusCls",
			            IF(ISBLANK([sale_program_date]) || [sale_program_date] <= vDataRefAtual, "aberto", "programado"),
			        "__MotivoTxt",
			            SWITCH(
			                TRUE(),
			                [__StatusDeptTrim] = "", "Não Classificado",
			                [__StatusDeptTrim] = "LOGISTICA", "Logística",
			                [__StatusDeptTrim] = "PRODUCAO", "Aguarda Produção",
			                [__StatusDeptTrim] = "FINANCEIRO", "Financeiro",
			                [__StatusDeptTrim] = "CUSTOMER SERVICE", "Customer Service",
			                [__StatusDeptTrim] = "LOGISTICA E CS", "Logística + CS",
			                [__StatusDeptTrim]
			            ),
			        "__MotivoCls",
			            SWITCH(
			                TRUE(),
			                [__StatusDeptTrim] = "", "naoclassificado",
			                [__StatusDeptTrim] = "LOGISTICA", "logistica",
			                [__StatusDeptTrim] = "PRODUCAO", "semestoque",
			                [__StatusDeptTrim] = "FINANCEIRO", "bloqfin",
			                [__StatusDeptTrim] = "CUSTOMER SERVICE", "credito",
			                [__StatusDeptTrim] = "LOGISTICA E CS", "logisticacs",
			                "aguardprog"
			            )
			    )
			 
			
			VAR tPedidosSoAberto = FILTER(tPedidosComNome, [__StatusCls] = "aberto")
			
			VAR tPedidosTop = TOPN(20, tPedidosSoAberto, [Pendente], DESC)
			
			VAR vPedSubtotal = SUMX(tPedidosTop, [Pendente])
			VAR fPedSubtotal =
			    IF(vPedSubtotal >= 1000000,
			       "R$ " & FORMAT(DIVIDE(vPedSubtotal,1000000),"#,##0.00") & " mi",
			       "R$ " & FORMAT(DIVIDE(vPedSubtotal,1000),"#,##0") & " mil")
			VAR HPedTotal =
			    "<div class=""ped-row ped-total"">" &
			        "<div class=""ped-total-lbl"">Subtotal</div>" &
			        "<div class=""ped-val"">" & fPedSubtotal & "</div>" &
			    "</div>"
			
			VAR HPedHead =
			    "<div class=""ped-head""><div>Pedido</div><div>Data</div><div>Cliente</div><div>SKU</div><div>Canal</div><div>Regional</div><div>Status</div><div>Motivo</div><div style=""text-align:right"">Pendente</div></div>"
			
			VAR HPedRows =
			    CONCATENATEX(
			        tPedidosTop,
			        VAR vPed    = [pedido]
			        VAR vData   = FORMAT([data_pedido], "dd/mm")
			        VAR vCli    = [__NomeCliente]
			        VAR vSku    = [__NomeSKU]
			        VAR vCanal  = [canal_n1]
			        VAR vReg    = [__NomeRegional]
			        VAR vStTxt  = [__StatusTxt]
			        VAR vStCls  = [__StatusCls]
			        VAR vMoTxt  = [__MotivoTxt]
			        VAR vMoCls  = [__MotivoCls]
			        VAR vPend   = [Pendente]
			        VAR fPend   = IF(vPend >= 1000000, "R$ " & FORMAT(DIVIDE(vPend,1000000),"#,##0.00") & " mi", "R$ " & FORMAT(DIVIDE(vPend,1000),"#,##0") & " mil")
			        RETURN
			            "<div class=""ped-row"">" &
			                "<div class=""ped-id"">" & vPed & "</div>" &
			                "<div class=""ped-cell"">" & vData & "</div>" &
			                "<div class=""ped-cell"">" & vCli & "</div>" &
			                "<div class=""ped-cell"">" & vSku & "</div>" &
			                "<div class=""ped-cell"">" & vCanal & "</div>" &
			                "<div class=""ped-cell"">" & vReg & "</div>" &
			                "<div><span class=""ped-badge " & vStCls & """>" & vStTxt & "</span></div>" &
			                "<div><span class=""ped-badge " & vMoCls & """>" & vMoTxt & "</span></div>" &
			                "<div class=""ped-val"">" & fPend & "</div>" &
			            "</div>",
			        "",
			        [Pendente], DESC
			    )
			
			VAR HPEDIDOS =
			    "<div class=""card col-12""><h3 class=""graph-title""><span class=""graph-title-text"">TOP 20 Pedidos em aberto</span><span class=""graph-title-badges""><label class=""info"" for=""infoPedidos"" tabindex=""0"" role=""button"" aria-label=""Ver descrição da tabela de pedidos em aberto"">i</label></span></h3>" &
			    "<input type=""checkbox"" id=""infoPedidos"" class=""info-toggle"">" &
			    "<div class=""info-panel""><ul><li>Os 20 pedidos com status <b>Em Aberto</b> (data de faturamento programada até a data atual) de maior valor pendente.</li><li><b>Aguarda Produção:</b> indisponibilidade de estoque.</li><li><b>Aguarda Programação:</b> pendente de definição de data pela área de Customer Service.</li><li><b>Financeiro:</b> pendências por motivos financeiros.</li><li><b>Customer Service:</b> pendência sob responsabilidade da área de CS.</li><li><b>Logística:</b> pendência relacionada a etapas logísticas.</li><li><b>Logística + CS:</b> pendência combinada entre Logística e Customer Service.</li><li><b>Não Classificado:</b> pedido sem motivo de retenção identificado.</li></ul></div>" &
			    "<div class=""ped-table"">" & HPedHead & HPedRows & HPedTotal & "</div>" &
			    "</div>"
			    
			// =====================================================================
			// 6) PEDIDO x ESTOQUE POR SKU — RISCO DE RUPTURA (tabela)
			// =====================================================================
			VAR vAlvoDias = 15
			
			VAR tSKUBase =
			    SUMMARIZECOLUMNS(
			        fPlanProd_unificada[cobertura_estoque_sku],
			        "Demanda", SUM(fPlanProd_unificada[cobertura_estoque_plano_medio]),
			        "EstoqueCalculado", SUM(fPlanProd_unificada[cobertura_estoque_quantidade]),
			        "Dias", AVERAGE(fPlanProd_unificada[cobertura_estoque_cobertura]),
			        "StatusSKU", SELECTEDVALUE(fPlanProd_unificada[status_sku])
			    )
			
			VAR tSKUComDemandaPositiva = FILTER(tSKUBase, [Demanda] > 0)
			
			VAR tSKUAtivos = 
			    FILTER(
			        tSKUComDemandaPositiva,
			        NOT(ISBLANK([StatusSKU])) && NOT([StatusSKU] IN {"INATIVO", "DESCONTINUADO"})
			    )
			
			VAR tSKUComNome =
			    ADDCOLUMNS(
			        tSKUAtivos,
			        "__NomeSKU",
			            VAR vCodSKU = [cobertura_estoque_sku]
			            RETURN
			                LOOKUPVALUE(dMaterial_unificada[descricao], dMaterial_unificada[codigo_produto], vCodSKU)
			    )
			
			VAR tSKUComCarteira =
			    ADDCOLUMNS(
			        tSKUComNome,
			        "A Faturar",
			            VAR vSkuAtual = [cobertura_estoque_sku]
			            RETURN
			                CALCULATE(
			                    [03 Total a Faturar],
			                    fltCarteiraData,
			                    fVendas_unificada[sku] = vSkuAtual
			                )
			    )
			
			VAR tSKUComTicket =
			    ADDCOLUMNS(
			        tSKUComCarteira,
			        "TicketMedio",
			            VAR vSkuAtual = [cobertura_estoque_sku]
			            VAR vDataMax = CALCULATE(MAX(fVendas_unificada[data_pedido]), REMOVEFILTERS())
			            VAR vDataIni = vDataMax - 90
			            RETURN
			                CALCULATE(
			                    DIVIDE(
			                        SUM(fVendas_unificada[receita]),
			                        SUM(fVendas_unificada[quantidade])
			                    ),
			                    REMOVEFILTERS(),
			                    fVendas_unificada[sku] = vSkuAtual,
			                    fVendas_unificada[pedido_tipo] = "VENDA",
			                    fVendas_unificada[pedido_status] = "FATURADO",
			                    fVendas_unificada[data_pedido] >= vDataIni,
			                    fVendas_unificada[data_pedido] <= vDataMax
			                )
			    )
			
			VAR tSKUComValores =
			    ADDCOLUMNS(
			        tSKUComTicket,
			        "EstoqueCalculadoValor", [EstoqueCalculado] * [TicketMedio],
			        "DemandaValor", [Demanda] * [TicketMedio]
			    )
			
			VAR tSKUComEstoqueTotal =
			    ADDCOLUMNS(
			        tSKUComValores,
			        "EstoqueTotalValor", [EstoqueCalculadoValor] + [A Faturar]
			    )
			
			VAR tSKUComDiasTratados =
			    ADDCOLUMNS(
			        tSKUComEstoqueTotal,
			        "DiasTratado", MAX(0, [Dias])
			    )
			VAR tSKUOrd = ADDCOLUMNS(tSKUComDiasTratados, "__Ord", [DiasTratado])
			VAR tSKUTop = TOPN(20, tSKUOrd, [DemandaValor], DESC, [cobertura_estoque_sku], ASC)
			
			VAR vSkuMaxDias  = MAXX(tSKUTop, [DiasTratado])
			VAR vSkuScaleMax = MAX(45, CEILING(vSkuMaxDias * 1.15, 5))
			VAR vSkuTargetPct = SUBSTITUTE(FORMAT(MIN(98, MAX(2, DIVIDE(vAlvoDias, vSkuScaleMax, 0) * 100)), "0.0"), ",", ".")
			
			VAR vSkuTotDemanda = SUMX(tSKUTop, [DemandaValor])
			VAR vSkuTotEstqTot = SUMX(tSKUTop, [EstoqueTotalValor])
			VAR vSkuTotCart    = SUMX(tSKUTop, [A Faturar])
			VAR vSkuTotEstqCal = SUMX(tSKUTop, [EstoqueCalculadoValor])
			-- cada subtotal repete o formato da propria coluna
			VAR fSkuTotDemanda =
			    VAR vA = ABS(vSkuTotDemanda) VAR vS = IF(vSkuTotDemanda < 0, "-", "")
			    RETURN vS & "R$ " & IF(vA >= 1000000, FORMAT(DIVIDE(vA,1000000), "#,##0.0") & " mi",
			                        IF(vA >= 1000, FORMAT(DIVIDE(vA,1000), "#,##0") & " mil", FORMAT(vA, "#,##0")))
			VAR fSkuTotEstqTot =
			    VAR vA = ABS(vSkuTotEstqTot) VAR vS = IF(vSkuTotEstqTot < 0, "-", "")
			    RETURN vS & "R$ " & IF(vA >= 1000000, FORMAT(DIVIDE(vA,1000000), "#,##0") & " mi",
			                        FORMAT(DIVIDE(vA,1000), "#,##0") & " mil")
			VAR fSkuTotCart =
			    VAR vA = ABS(vSkuTotCart) VAR vS = IF(vSkuTotCart < 0, "-", "")
			    RETURN vS & "R$ " & IF(vA >= 1000000, FORMAT(DIVIDE(vA,1000000), "#,##0.0") & " mi",
			                        FORMAT(DIVIDE(vA,1000), "#,##0") & " mil")
			VAR fSkuTotEstqCal =
			    VAR vA = ABS(vSkuTotEstqCal) VAR vS = IF(vSkuTotEstqCal < 0, "-", "")
			    RETURN vS & "R$ " & IF(vA >= 1000000, FORMAT(DIVIDE(vA,1000000), "#,##0.0") & " mi",
			                        FORMAT(DIVIDE(vA,1000), "#,##0") & " mil")
			VAR HSkuTotal =
			    "<div class=""sku-row sku-total"">" &
			        "<div class=""sku-total-lbl"">Subtotal</div>" &
			        "<div class=""sku-num"">" & fSkuTotDemanda & "</div>" &
			        "<div class=""sku-num"">" & fSkuTotEstqTot & "</div>" &
			        "<div class=""sku-num"">" & fSkuTotCart & "</div>" &
			        "<div class=""sku-num"">" & fSkuTotEstqCal & "</div>" &
			        "<div></div><div></div><div></div>" &
			    "</div>"
			
			VAR HSkuHead =
			    "<div class=""sku-head""><div>SKU</div><div>Demanda mês</div><div>Estoque Total</div><div>A Faturar</div><div>Estoque Calculado</div><div>Cobertura · alvo " & vAlvoDias & "d</div><div>Dias</div><div>Status</div></div>"
			
			VAR HSkuRows =
			    CONCATENATEX(
			        tSKUTop,
			        VAR vNome     = [__NomeSKU]
			        VAR vDemanda  = [DemandaValor]
			        VAR vCart     = [A Faturar]
			        VAR vEstqCalc = [EstoqueCalculadoValor]
			        VAR vEstqTot  = [EstoqueTotalValor]
			        VAR vDias     = ROUND([DiasTratado], 0)
			        VAR vCls      = IF(vDias <= vAlvoDias, "bad", IF(vDias <= vAlvoDias * 2, "warn", "ok"))
			        VAR vStTxt    = IF(vDias <= vAlvoDias, "Ruptura", IF(vDias <= vAlvoDias * 2, "Atenção", "Ok"))
			        VAR vBarPct   = SUBSTITUTE(FORMAT(MIN(100, MAX(2, DIVIDE(vDias, vSkuScaleMax, 0) * 100)), "0.0"), ",", ".")
			        VAR fDemanda = 
			            VAR vAbsD = ABS(vDemanda)
			            VAR vSinalD = IF(vDemanda < 0, "-", "")
			            RETURN
			                vSinalD & "R$ " & IF(vAbsD >= 1000000, FORMAT(DIVIDE(vAbsD,1000000), "#,##0.0") & " mi", IF(vAbsD >= 1000, FORMAT(DIVIDE(vAbsD,1000), "#,##0") & " mil", FORMAT(vAbsD, "#,##0")))
			    VAR fCart =
			        VAR vAbsC = ABS(vCart)
			        VAR vSinalC = IF(vCart < 0, "-", "")
			        RETURN
			            vSinalC & "R$ " & IF(vAbsC >= 1000000, FORMAT(DIVIDE(vAbsC,1000000), "#,##0.0") & " mi", FORMAT(DIVIDE(vAbsC,1000), "#,##0") & " mil")
			
			    VAR fEstqCalc =
			    VAR vAbs = ABS(vEstqCalc)
			    VAR vSinal = IF(vEstqCalc < 0, "-", "")
			    RETURN
			        vSinal & "R$ " & IF(vAbs >= 1000000, FORMAT(DIVIDE(vAbs,1000000), "#,##0.0") & " mi", FORMAT(DIVIDE(vAbs,1000), "#,##0") & " mil")
			        VAR fEstqTot =
			            VAR vAbsT = ABS(vEstqTot)
			            VAR vSinalT = IF(vEstqTot < 0, "-", "")
			            RETURN
			                vSinalT & "R$ " & IF(vAbsT >= 1000000, FORMAT(DIVIDE(vAbsT,1000000), "#,##0") & " mi", FORMAT(DIVIDE(vAbsT,1000), "#,##0") & " mil")
			        RETURN
			            "<div class=""sku-row"">" &
			                "<div class=""sku-name"">" & vNome & "</div>" &
			                "<div class=""sku-num"">" & fDemanda & "</div>" &
			                "<div class=""sku-num"">" & fEstqTot & "</div>" &
			                "<div class=""sku-num"">" & fCart & "</div>" &
			                "<div class=""sku-num"">" & fEstqCalc & "</div>" &
			                "<div class=""sku-cov""><div class=""sku-cov-track""><div class=""sku-cov-fill " & vCls & """ style=""width:" & vBarPct & "%""></div><div class=""sku-cov-target"" style=""left:" & vSkuTargetPct & "%""></div></div></div>" &
			                "<div class=""sku-dias"">" & vDias & "d</div>" &
			                "<div><span class=""sku-badge " & vCls & """>" & vStTxt & "</span></div>" &
			            "</div>",
			        "",
			        [DiasTratado], ASC,
			        [DemandaValor], DESC
			    )
			
			VAR HSKU =
			    "<div class=""card col-12""><h3 class=""graph-title""><span class=""graph-title-text"">Top 20 SKU x Estoque</span><span class=""graph-title-badges""><label class=""info"" for=""infoSku"" tabindex=""0"" role=""button"" aria-label=""Ver descrição da tabela de risco de ruptura por SKU"">i</label></span></h3>" &
			    "<input type=""checkbox"" id=""infoSku"" class=""info-toggle"">" &
			    "<div class=""info-panel""><ul><li>Comparativo entre a demanda projetada do mês e o estoque disponível, por SKU.</li><li><b>Demanda Mês:</b> valor projetado de vendas do mês, conforme planejamento de S&OP.</li><li><b>Estoque Total:</b> Estoque Calculado somado ao valor A Faturar.</li><li><b>A Faturar:</b> pedidos do SKU ainda não faturados.</li><li><b>Estoque Calculado:</b> estoque líquido, descontados os valores já faturados e os pendentes de faturamento.</li><li><b>Cobertura (dias):</b> estoque atual dividido pela média diária de vendas projetada (S&OP); meta de 15 dias.</li><li><b>Status:</b> Ruptura (até a meta), Atenção (até 2x a meta) ou Ok (acima disso).</li></ul></div>" &
			    "<div class=""sku-table"">" & HSkuHead & HSkuRows & HSkuTotal & "</div>" &
			    "</div>"
			    
			// =====================================================================
			// CSS - blocos nomeados por função
			// =====================================================================
			VAR vCSSBase =
			    ":root{--brand:#023F76;--brand-deep:#062A4C;--accent:#0A5CA8;--accent-soft:#E9F1F9;--accent-line:#BDD4E9;--bg:#F2F5F9;--card:#FFFFFF;--card-2:#F8FAFC;--line:#E2E8F0;--line-strong:#C6D0DD;--ink:#14243A;--ink-2:#3C4E64;--ink-3:#51667F;--pos:#176B3A;--pos-soft:#E4F3E9;--neg:#B4231F;--neg-soft:#FBEAE8;--warn:#8F5600;--warn-soft:#FCF1DE;--pos-bright:#57D992;--warn-bright:#F5C04E;--neg-bright:#FF8B84;--cat-1:#0A3A66;--cat-2:#14568E;--cat-3:#2F74AE;--cat-4:#5A94C6;--cat-5:#8CB5DB;--cat-6:#BDD6EC;--cat-logistica:#6B5CA5;--sc-real:#0A1B2C;--sc-meta:#5D7186;--sc-ly:#A3B0BE;--font:'Segoe UI',system-ui,-apple-system,sans-serif;--radius:12px;--radius-sm:8px;--shadow:0 1px 2px rgba(6,42,76,.05),0 2px 10px rgba(6,42,76,.05);--shadow-lift:0 4px 20px rgba(6,42,76,.12);--fs-legend:12px;}" &
			    "*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}body{font-family:var(--font);background:var(--bg);color:var(--ink);font-size:13px;line-height:1.45;-webkit-font-smoothing:antialiased;}.num{font-variant-numeric:tabular-nums;}.fb{padding:4px 2px 30px;}.grid{display:grid;gap:12px;}.cards{grid-template-columns:repeat(12,1fr);}.col-12{grid-column:span 12;}.col-6{grid-column:span 6;}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:15px 17px;box-shadow:var(--shadow);min-width:0;position:relative;}.card h3{font-size:17px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand);display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:3px;line-height:1.25;}.card .desc{font-size:13.5px;color:#000;font-weight:400;margin-bottom:10px;line-height:1.48;}.card .src{font-size:12px;color:var(--ink-3);font-weight:400;margin-top:10px;border-top:1px dashed var(--line);padding-top:6px;}.seclbl{font-size:17px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:950;margin:20px 0 9px 2px;}@media(max-width:1100px){.col-6{grid-column:span 12;}}"
			
			VAR vCSSBadges =
			    ".basetag{font-size:15px;font-weight:600;letter-spacing:.02em;color:var(--ink-3);background:var(--card-2);border:1px solid var(--line-strong);border-radius:20px;padding:1px 8px;margin-left:auto;white-space:nowrap;text-transform:none;display:none}.tag{display:inline-flex;align-items:center;gap:4px;font-size:15px;font-weight:600;padding:2px 8px;border-radius:20px;white-space:nowrap;}.graph-title{display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:12px;width:100%;margin-bottom:7px;flex-wrap:wrap;}.graph-title .graph-title-text{display:block;}.graph-title .graph-title-badges{display:flex;align-items:center;gap:6px;white-space:nowrap;flex:none;}.graph-title .graph-title-badges .basetag{margin-left:0;}"
			
			VAR vCSSContext =
			    ".ctxline{display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#F8FAFC;border-top:1px solid #D7E2EE;border-bottom:1px solid #D7E2EE;padding:9px 14px;margin:0 0 12px 0;font-family:var(--font);font-size:13px;color:var(--brand-deep);line-height:1.30;min-height:34px;font-weight:650;}.ctxline b{font-size:15px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand-deep);margin-right:5px;}.ctxline span{display:inline-flex;align-items:center;white-space:nowrap;}.ctxline .ctx-divider{width:1px;height:22px;background:#D7E2EE;flex:0 0 1px;}.ctxline .ctx-company{display:inline-flex;align-items:center;gap:7px;min-width:0;}.ctxline .ctx-company-label{font-size:15px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand-deep);}.ctxline .ctx-company-value{display:inline-flex;align-items:center;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #BDD4E9;background:#EDF4FB;color:#023F76;border-radius:999px;padding:5px 12px;font-size:15px;font-weight:900;line-height:1.15;box-shadow:inset 0 0 0 1px rgba(255,255,255,.45);}.ctxline .ctx-right{margin-left:auto;display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap;}.ctxline .ctx-base{display:inline-flex;align-items:center;border:1px solid var(--accent-line);background:#E9F1F9;color:var(--brand);border-radius:999px;padding:6px 15px;font-size:15px;font-weight:900;}.badge{display:inline-flex;align-items:center;border:1px solid var(--accent-line);background:var(--card-2);color:var(--brand);border-radius:999px;font-size:15px;font-weight:900;padding:4px 11px;white-space:nowrap;line-height:1.15;}.partial-badge{background:#FFF2D8;border-color:#F0C46A;color:#8F5600;}.footer{font-size:12px;color:var(--ink-3);border-top:1px dashed var(--line);padding-top:8px;margin-top:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;}@media(max-width:900px){.ctxline{gap:9px;}.ctxline .ctx-divider{display:none;}.ctxline .ctx-company{order:3;width:100%;}.ctxline .ctx-company-value{max-width:calc(100% - 92px);}.ctxline .ctx-right{margin-left:auto;}}@media(max-width:680px){.ctxline{gap:10px;}.ctxline .ctx-right{width:100%;margin-left:0;justify-content:flex-start;}}"
			
			VAR vCSSKpi =
			    ".kpis{grid-template-columns:repeat(4,minmax(0,1fr));align-items:stretch;gap:12px;}.kpis-5{grid-template-columns:repeat(5,minmax(0,1fr));}@media(max-width:1250px){.kpis,.kpis-5{grid-template-columns:repeat(2,minmax(0,1fr));}}@media(max-width:760px){.kpis,.kpis-5{grid-template-columns:1fr;}}.kpi{background:var(--card);border:1px solid #DFE7F0;border-radius:9px;padding:18px 21px 16px;box-shadow:0 2px 7px rgba(6,42,76,.10);position:relative;overflow:visible;min-width:0;min-height:164px;display:flex;flex-direction:column;align-items:center;text-align:center;}.kpi::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:var(--kpi-accent, var(--line));border-radius:9px 9px 0 0;}.kpi.st-pos::before{background:var(--pos);}.kpi.st-neg::before{background:var(--neg);}.kpi.st-warn::before{background:var(--warn);}.kpi .lab{font-size:17px;font-weight:950;letter-spacing:0.4px;text-transform:uppercase;color:var(--brand);margin-bottom:11px;line-height:1.25;width:100%;text-align:center;padding-left:0.4px;}.kpi-val{font-size:30px;font-weight:950;letter-spacing:-.035em;line-height:1.05;color:#000;font-variant-numeric:tabular-nums;white-space:nowrap;width:100%;text-align:center;}.kpi-val.money-split{display:flex;align-items:baseline;justify-content:center;gap:4px;white-space:nowrap;}.kpi-val.money-split .currency{font-size:13px;line-height:1;font-weight:950;color:#000;}.kpi-val.money-split .number{font-size:30px;line-height:1.05;font-weight:950;color:#000;letter-spacing:-.035em;}.kpi-val.money-split .unit{font-size:14px;line-height:1;font-weight:950;color:#000;margin-left:1px;}.deltas{display:flex;gap:14px;margin-top:9px;flex-wrap:wrap;justify-content:center;width:100%;}.delta{font-size:13px;font-weight:900;display:inline-flex;align-items:center;gap:3px;line-height:1.34;}.delta.pos{color:var(--pos);}.delta.neg{color:var(--neg);}.delta.warn{color:var(--warn);}.delta.fl{color:var(--ink-3);}.kpi .hint{font-size:13px;color:var(--brand-deep);font-weight:600;margin-top:8px;line-height:1.42;width:100%;text-align:center;}"
			
			/*VAR vCSSChart =
			    ".chart-wrap{width:100%;overflow:hidden;margin-top:14px;}svg.chart{width:100%;display:block;}.axis-label{font-size:17px;fill:#000;font-family:var(--font);font-weight:400;}.axis-label-cat{font-size:13px;fill:#000;font-family:var(--font);font-weight:700;}.axis-line{stroke:var(--line);stroke-width:1;}.wf-neg{fill:var(--neg);}.wf-total{fill:var(--sc-real);}.wf-hoverzone{fill:transparent;cursor:default;}.wf-hoverzone:hover{fill:#EEF1F5;}"*/
			
			VAR vCSSChart =
			    ".chart-wrap{width:100%;overflow:hidden;margin-top:14px;}svg.chart{width:100%;display:block;}.axis-label{font-size:21px;fill:#000;font-family:var(--font);font-weight:400;}.axis-label-cat{font-size:15px;fill:#000;font-family:var(--font);font-weight:700;}.axis-line{stroke:var(--line);stroke-width:1;}.wf-neg{fill:var(--neg);}.wf-total{fill:var(--sc-real);}.wf-hoverzone{fill:transparent;cursor:default;}.wf-hoverzone:hover{fill:#EEF1F5;}"    
			
			VAR vCSSSku =
			    ".sku-table{width:100%;}.sku-head{display:grid;grid-template-columns:2.2fr minmax(64px,0.65fr) minmax(64px,0.65fr) minmax(64px,0.65fr) minmax(64px,0.65fr) 1.4fr 42px 88px;gap:8px;padding:0 0 8px;margin-top:14px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);border-bottom:2px solid var(--line-strong);align-items:end;}.sku-row{display:grid;grid-template-columns:2.2fr minmax(64px,0.65fr) minmax(64px,0.65fr) minmax(64px,0.65fr) minmax(64px,0.65fr) 1.4fr 42px 88px;gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line);}.sku-row:last-child{border-bottom:none;}.sku-name{font-size:14px;font-weight:500;color:#000;line-height:1.3;}.sku-sub{font-size:12px;font-weight:400;color:var(--ink-3);margin-top:1px;}.sku-num{font-size:15px;font-weight:600;color:#000;font-variant-numeric:tabular-nums;}.sku-cov{position:relative;height:8px;}.sku-cov-track{position:relative;width:100%;height:8px;background:#EEF2F7;border-radius:4px;overflow:visible;}.sku-cov-fill{position:absolute;left:0;top:0;height:8px;border-radius:4px;}.sku-cov-fill.bad{background:var(--neg);}.sku-cov-fill.warn{background:var(--warn);}.sku-cov-fill.ok{background:var(--pos);}.sku-cov-target{position:absolute;top:-3px;width:2px;height:14px;background:var(--ink-2);}.sku-dias{font-size:15px;font-weight:700;color:#000;text-align:left;}.sku-badge{display:inline-flex;align-items:center;font-size:12px;font-weight:600;padding:3px 10px;border-radius:20px;white-space:nowrap;}.sku-badge.bad{background:var(--neg-soft);color:var(--neg);}.sku-badge.warn{background:var(--warn-soft);color:var(--warn);}.sku-badge.ok{background:var(--pos-soft);color:var(--pos);}@media(max-width:1200px){.sku-head,.sku-row{grid-template-columns:1.8fr minmax(56px,0.6fr) minmax(56px,0.6fr) minmax(56px,0.6fr) minmax(56px,0.6fr) 1.2fr 38px 78px;gap:6px;font-size:12px;}}"
			
			VAR vCSSPedidos =
			    ".ped-table{width:100%;overflow-x:auto;}.ped-head{display:grid;grid-template-columns:64px 56px 0.85fr 1fr 120px 145px 85px 130px 90px;gap:10px;padding:0 0 8px;margin-top:14px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);border-bottom:2px solid var(--line-strong);white-space:nowrap;}.ped-row{display:grid;grid-template-columns:64px 56px 0.85fr 1fr 120px 145px 85px 130px 90px;gap:10px;align-items:start;padding:9px 0;border-bottom:1px solid var(--line);}.ped-row:last-child{border-bottom:none;}.ped-id{font-size:14px;font-weight:600;color:var(--accent);}.ped-cell{font-size:14px;font-weight:400;color:#000;white-space:normal;line-height:1.35;overflow-wrap:break-word;}.ped-val{font-size:15px;font-weight:800;color:#000;text-align:right;font-variant-numeric:tabular-nums;}.ped-badge{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;padding:3px 9px;border-radius:20px;white-space:nowrap;}.ped-badge.aberto{background:var(--warn-soft);color:var(--warn);}.ped-badge.programado{background:var(--accent-soft);color:var(--accent);}.ped-badge.bloqueio{background:var(--neg-soft);color:var(--neg);}.ped-badge.semestoque{background:#FCF1DE;color:#8F5600;}.ped-badge.credito{background:#E9F1F9;color:var(--cat-2);}.ped-badge.aguardprog{background:#E9F1F9;color:var(--cat-5);}.ped-badge.logistica{background:#F1EDF9;color:var(--cat-logistica);}.ped-badge.bloqfin{background:var(--neg-soft);color:var(--neg);}.ped-badge.naoclassificado{background:var(--card-2);color:var(--ink-3);}.ped-badge.logisticacs{background:#E3F2ED;color:#0E6E5C;}@media(max-width:1200px){.ped-head,.ped-row{grid-template-columns:55px 50px 0.85fr 1fr 100px 125px 75px 110px 80px;font-size:12px;}}"
			    
			VAR vCSSTotais =
			    ".ped-row.ped-total{border-top:2px solid var(--line-strong);border-bottom:none;padding-top:11px;}.ped-total .ped-total-lbl{grid-column:1 / 9;text-align:right;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);}.ped-total .ped-val{font-weight:800;}.sku-row.sku-total{border-top:2px solid var(--line-strong);border-bottom:none;padding-top:11px;}.sku-total .sku-total-lbl{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);}.sku-total .sku-num{font-weight:800;}"
			VAR vCSSKpiSec =
			    ".kpi .deltas{margin-top:12px;}.kpi .deltas-col{flex-direction:column;align-items:center;gap:4px;}.kpi .delta{font-size:18px;line-height:1.35;}.kpi .hint{font-size:18px;line-height:1.35;margin-top:12px;}"
			VAR vCSSInfo =
			    ".info{position:absolute;top:12px;right:14px;display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;margin-left:0;border:1.5px solid var(--brand);border-radius:50%;color:var(--brand);font-size:11px;font-weight:800;line-height:1;letter-spacing:0;text-transform:none;vertical-align:middle;cursor:pointer;}.info-tip{position:absolute;top:calc(100% + 9px);left:50%;transform:translateX(-50%);width:236px;background:var(--brand-deep);color:#FFFFFF;font-size:13px;font-weight:600;line-height:1.45;letter-spacing:0;text-transform:none;text-align:left;padding:9px 11px;border-radius:6px;box-shadow:0 4px 14px rgba(6,42,76,.28);opacity:0;visibility:hidden;transition:opacity .15s ease;z-index:60;pointer-events:none;}.info-tip b{font-weight:800;}.info-tip::before{content:"""";position:absolute;bottom:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-bottom-color:var(--brand-deep);}.info:hover .info-tip,.info:focus .info-tip{opacity:1;visibility:visible;}.kpis-5 .kpi:last-child .info-tip{left:auto;right:0;transform:none;}.kpis-5 .kpi:last-child .info-tip::before{left:auto;right:14px;transform:none;}.info-toggle{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none;}.info-panel{display:none;margin:8px 0 4px;padding:12px 14px;background:var(--brand-deep);color:#FFFFFF;font-size:13px;font-weight:600;line-height:1.5;border-radius:8px;box-shadow:0 4px 14px rgba(6,42,76,.20);}.info-panel b{font-weight:800;}.info-panel ul{margin:2px 0 0;padding-left:16px;}.info-panel li{margin:0 0 6px;}.info-panel li:last-child{margin-bottom:0;}.info-toggle:checked ~ .info-panel{display:block;}"
			VAR vCSS = "<style>" & vCSSBase & vCSSBadges & vCSSContext & vCSSKpi & vCSSChart & vCSSSku & vCSSPedidos & vCSSTotais & vCSSKpiSec & vCSSInfo & "</style>"
			
			// ===== HTML: contexto (ESCOPO · PERIODO · BASE · ATUALIZADO) =====
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtu & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadge &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>"
			
			// ===== Montagem final =====
			VAR vHTML =
			    vCSS &
			    HCTX &
			    "<div class=""fb"">" &
			    HK0 & HK2 & HK3 & HK1 & HK5 & HK6 & HKF &
			    "<div class=""grid cards"" style=""margin-top:16px"">" & HFUNIL & "</div>" &
			    "<div class=""grid cards"" style=""margin-top:12px"">" & HPEDIDOS & "</div>" &
			    "<div class=""grid cards"" style=""margin-top:12px"">" & HSKU & "</div>" &
			    "</div>"
			
			RETURN vHTML
			
			```
		displayFolder: Bi_novo
		lineageTag: 30fe317e-5c11-421f-99cf-4ef677925d49

	/// Comercial HTML v1 - clientes por cpf_cnpj_completo
	measure 'Comercial HTML v1' = ```
			// Comercial HTML v1
			VAR vBaseReceitaSelecionada = SELECTEDVALUE('Base Receita'[Base Receita], "Receita Semi Liquida")
			VAR vUsarReceitaBruta = vBaseReceitaSelecionada = "Receita Bruta"
			VAR vRSLBase = COALESCE([03 RSL], 0)
			VAR vReceitaBruta = COALESCE([09 Receita Bruta], 0)
			VAR vRSL = IF(vUsarReceitaBruta, vReceitaBruta, vRSLBase)
			VAR vBaseTagReceita = IF(vUsarReceitaBruta, "Base RB", "Base RSL")
			VAR vTagBase = IF(vUsarReceitaBruta, "BASE RB", "BASE RSL")
			VAR vFonteBaseReceita = IF(vUsarReceitaBruta, "Base RB", "Base RSL")
			VAR vDataIni = MIN('dTempo'[Data])
			VAR vDataFim = MAX('dTempo'[Data])
			VAR vMesIni = SWITCH(MONTH(vDataIni),1,"Jan",2,"Fev",3,"Mar",4,"Abr",5,"Mai",6,"Jun",7,"Jul",8,"Ago",9,"Set",10,"Out",11,"Nov",12,"Dez","")
			VAR vMesFim = SWITCH(MONTH(vDataFim),1,"Jan",2,"Fev",3,"Mar",4,"Abr",5,"Mai",6,"Jun",7,"Jul",8,"Ago",9,"Set",10,"Out",11,"Nov",12,"Dez","")
			VAR fPeriodo = IF(ISBLANK(vDataIni), "—", IF(YEAR(vDataIni)=YEAR(vDataFim) && MONTH(vDataIni)=MONTH(vDataFim), vMesFim & "-" & FORMAT(vDataFim,"yy"), vMesIni & "-" & FORMAT(vDataIni,"yy") & " a " & vMesFim & "-" & FORMAT(vDataFim,"yy")))
			VAR vPeriodoBadge = "<span class=""basetag periodtag"">" & fPeriodo & "</span>"
			// ==========================================================
			// CONTEXTO DE EMPRESA — HIERARQUIA dEmpresa
			// Empresa > Description
			// ==========================================================
			VAR vEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Empresa]
			    )
			
			VAR vDescricaoEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Description]
			    )
			
			VAR vEmpresaContexto =
			    SWITCH(
			        TRUE(),
			
			        HASONEVALUE('dEmpresa'[Description])
			            && NOT ISBLANK(vDescricaoEmpresaSelecionada),
			            COALESCE(vEmpresaSelecionada, "Empresa")
			                & " › "
			                & vDescricaoEmpresaSelecionada,
			
			        HASONEVALUE('dEmpresa'[Empresa])
			            && NOT ISBLANK(vEmpresaSelecionada),
			            vEmpresaSelecionada,
			
			        ISFILTERED('dEmpresa'[Empresa])
			            || ISFILTERED('dEmpresa'[Description]),
			            "Múltiplas empresas",
			
			        "Grupo"
			    )
			
			VAR vAtualizacaoContexto = [00 Atualização]
			VAR fAtualizacaoContexto =
			    IF(
			        ISBLANK(vAtualizacaoContexto),
			        "-",
			        IF(
			            ISTEXT(vAtualizacaoContexto),
			            TRIM(
			                SUBSTITUTE(
			                    vAtualizacaoContexto,
			                    "Atualizado em:",
			                    ""
			                )
			            ),
			            FORMAT(vAtualizacaoContexto, "dd/mm/yyyy hh:mm")
			        )
			    )
			VAR vDataInicialSelecionada = MIN('dTempo'[Data])
			VAR vDataFinalSelecionada = MAX('dTempo'[Data])
			VAR vInicioMesAtual = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR vFimMesAtual = EOMONTH(TODAY(), 0)
			VAR vPeriodoIncluiMesAtual =
			    NOT ISBLANK(vDataInicialSelecionada)
			        && NOT ISBLANK(vDataFinalSelecionada)
			        && vDataInicialSelecionada <= vFimMesAtual
			        && vDataFinalSelecionada >= vInicioMesAtual
			VAR vParcialBadge =
			    IF(
			        vPeriodoIncluiMesAtual,
			        "<span class=""badge partial-badge"">Mês parcial até dia "
			            & FORMAT(DAY(TODAY()), "0")
			            & "</span>",
			        ""
			    )
			// CANAL com contagem de clientes por CPF/CNPJ
			VAR tCanalBase = ADDCOLUMNS(FILTER(VALUES('fVendas_unificada'[canal_n1]), NOT ISBLANK('fVendas_unificada'[canal_n1])), "__Nome", 'fVendas_unificada'[canal_n1], "__Fat", COALESCE(CALCULATE(IF(vUsarReceitaBruta, [08 Faturamento Bruto], [00 Faturamento])), 0))
			VAR tCanalFiltrada = FILTER(tCanalBase, [__Fat] <> 0)
			VAR tCanalTop = TOPN(8, tCanalFiltrada, [__Fat], DESC, [__Nome], ASC)
			VAR vCanalTotal      = SUMX(tCanalFiltrada, [__Fat])
			VAR vCanalTopSoma    = SUMX(tCanalTop, [__Fat])
			VAR vCanalOutros     = vCanalTotal - vCanalTopSoma
			VAR vCanalOutrosQtd  = COUNTROWS(tCanalFiltrada) - COUNTROWS(tCanalTop)
			VAR HCanalOutros = IF(vCanalOutrosQtd > 0, "<tr class=""agg""><td>OUTROS</td><td class=""num"">" & FORMAT(DIVIDE(vCanalOutros,1000000), "R$ #,##0.0") & " mi</td></tr>", "")
			VAR HCanalTotal = "<tfoot><tr><td>TOTAL</td><td class=""num"">" & FORMAT(DIVIDE(vCanalTotal,1000000), "R$ #,##0.0") & " mi</td></tr></tfoot>"
			VAR HCanalTabela = IF(COUNTROWS(tCanalTop) = 0, "<div class=""empty-msg"">Sem dados.</div>", "<div class=""twrap""><table><thead><tr><th>Canal</th><th class=""num"">Faturado</th></tr></thead><tbody>" & CONCATENATEX(tCanalTop, VAR vNome = [__Nome] VAR fVal = FORMAT(DIVIDE([__Fat],1000000), "R$ #,##0.0") & " mi" RETURN "<tr><td>" & vNome & "</td><td class=""num"">" & fVal & "</td></tr>", "", [__Fat], DESC) & HCanalOutros & "</tbody>" & HCanalTotal & "</table></div>")
			// CLIENTES base com UF
			VAR tCliBase = ADDCOLUMNS(FILTER(VALUES('dClientes_unificada'[cliente]), NOT ISBLANK('dClientes_unificada'[cliente])), "__Nome", 'dClientes_unificada'[cliente], "__Fat", COALESCE(CALCULATE(IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL])), 0), "__UF", SELECTEDVALUE('dClientes_unificada'[estado], ""))
			VAR tCliFiltrada = FILTER(tCliBase, [__Fat] > 0)
			VAR tCliTop15 = TOPN(15, tCliFiltrada, [__Fat], DESC, [__Nome], ASC)
			VAR vCliMaxSeg = IF(ISBLANK(MAXX(tCliTop15, [__Fat])) || MAXX(tCliTop15, [__Fat]) = 0, 1, MAXX(tCliTop15, [__Fat]))
			VAR HCliRows = IF(COUNTROWS(tCliTop15) = 0, "<div class=""empty-msg"">Sem dados de clientes.</div>", CONCATENATEX(tCliTop15, VAR vNome = [__Nome] VAR vVal = [__Fat] VAR vPct = FORMAT(MIN(100, MAX(2, DIVIDE(vVal, vCliMaxSeg, 0)*100)), "0") VAR fVal = FORMAT(DIVIDE(vVal,1000000), "#,##0.0") & " mi" RETURN "<div class=""rank-row cli""><div class=""rank-name cli-name"">" & vNome & "</div><div class=""rank-bar-cell""><div class=""rank-bar-bg""><div class=""rank-bar"" style=""width:" & vPct & "%""></div></div></div><div class=""rank-val"">" & fVal & "</div></div>", "", [__Fat], DESC))
			// PARETO TOP 10 clientes com acumulado
			VAR tCliPareto = TOPN(10, tCliFiltrada, [__Fat], DESC, [__Nome], ASC)
			VAR vTotalCli = SUMX(tCliFiltrada, [__Fat])
			VAR vTotalCliSeg = IF(vTotalCli = 0, 1, vTotalCli)
			VAR tCliRanked = ADDCOLUMNS(tCliFiltrada, "__Rank", RANKX(tCliFiltrada, [__Fat], , DESC, DENSE))
			VAR vClasseACount = COUNTROWS(FILTER(ADDCOLUMNS(tCliRanked, "__Acum", DIVIDE(SUMX(FILTER(tCliRanked, [__Rank] <= EARLIER([__Rank])), [__Fat]), vTotalCliSeg, 0)), [__Acum] <= 0.80)) + 1
			VAR tParetoRnk = ADDCOLUMNS(tCliPareto, "__Rnk", RANKX(tCliPareto, [__Fat], , DESC, DENSE))
			VAR tParetoFull = ADDCOLUMNS(tParetoRnk, "__CumPct", DIVIDE(SUMX(FILTER(ADDCOLUMNS(tCliFiltrada, "__R2", RANKX(tCliFiltrada, [__Fat], , DESC, DENSE)), [__R2] <= EARLIER([__Rnk])), [__Fat]), vTotalCliSeg, 0))
			VAR vPMaxFat = MAXX(tParetoFull, [__Fat])
			VAR vPMaxSeg = IF(ISBLANK(vPMaxFat) || vPMaxFat = 0, 1, vPMaxFat)
			VAR vCL = 80
			VAR vCR = 1020
			VAR vCT = 30
			VAR vCB = 260
			VAR vCH = 230
			VAR vParetoQtd = 10
			VAR vBW = 66
			VAR vBG = DIVIDE(vCR - vCL - vParetoQtd * vBW, vParetoQtd - 1, 4)
			VAR HPBars =
			    CONCATENATEX(
			        tParetoFull,
			        VAR vN = [__Nome]
			        VAR vV = [__Fat]
			        VAR vRnk = [__Rnk]
			        VAR vI = vRnk - 1
			        VAR vX = vCL + vI * (vBW + vBG)
			        VAR vBH = MAX(4, DIVIDE(vV, vPMaxSeg, 0) * vCH)
			        VAR vBY = vCB - vBH
			        VAR vLbl = IF(LEN(vN) > 16, LEFT(vN, 14) & "..", vN)
			        VAR vLabelX = vX + vBW / 2
			        VAR vLabelY = 282
			        RETURN
			            "<rect class=""pareto-bar"" x=""" & FORMAT(vX,"0") & """ y=""" & FORMAT(vBY,"0") & """ width=""" & FORMAT(vBW,"0") & """ height=""" & FORMAT(vBH,"0") & """ rx=""2""/>" &
			            "<text x=""" & FORMAT(vLabelX,"0") & """ y=""" & FORMAT(vLabelY,"0") & """ class=""axis-label pareto-x-label"" text-anchor=""end"" transform=""rotate(-40," & FORMAT(vLabelX,"0") & "," & FORMAT(vLabelY,"0") & ")""><title>" & vN & "</title>" & vLbl & "</text>",
			        "",
			        [__Fat], DESC
			    )
			VAR HPLine = CONCATENATEX(tParetoFull, VAR vI = [__Rnk] - 1 VAR vX = vCL + vI * (vBW + vBG) + vBW / 2 VAR vY = vCB - [__CumPct] * vCH RETURN FORMAT(vX,"0") & "," & FORMAT(vY,"0"), " ", [__Rnk], ASC)
			VAR HPDots = CONCATENATEX(tParetoFull, VAR vI = [__Rnk] - 1 VAR vX = vCL + vI * (vBW + vBG) + vBW / 2 VAR vY = vCB - [__CumPct] * vCH RETURN "<circle cx=""" & FORMAT(vX,"0") & """ cy=""" & FORMAT(vY,"0") & """ r=""2.6"" class=""pareto-dot""/>", "", [__Rnk], ASC)
			VAR HPHitTips =
			    CONCATENATEX(
			        tParetoFull,
			        VAR vN = [__Nome]
			        VAR vV = [__Fat]
			        VAR vUF = [__UF]
			        VAR vRnk = [__Rnk]
			        VAR vCum = [__CumPct]
			        VAR vI = vRnk - 1
			        VAR vX = vCL + vI * (vBW + vBG)
			        VAR vBH = MAX(4, DIVIDE(vV, vPMaxSeg, 0) * vCH)
			        VAR vBY = vCB - vBH
			        VAR vNomeUF = vN & IF(NOT ISBLANK(vUF) && vUF <> "", " - " & vUF, "")
			        VAR fV = FORMAT(DIVIDE(vV, 1000000), "R$ #,##0.00") & " mi"
			        VAR fC = FORMAT(vCum, "0%")
			        VAR vTipChars = MAX(LEN(vNomeUF), MAX(LEN("Faturamento: " & fV), LEN("Acumulado: " & fC)))
			        VAR vTipW = MIN(460, MAX(250, vTipChars * 8 + 40))
			        VAR vTipH = 84
			        VAR vTipX = IF(vX + vBW + 12 + vTipW > vCR, vX - vTipW - 12, vX + vBW + 12)
			        VAR vTipY = MAX(vCT + 4, MIN(vCB - vTipH - 4, vBY + 8))
			        RETURN
			            "<g class=""pareto-hover"">" &
			                "<rect class=""pareto-hit"" x=""" & FORMAT(vX,"0") & """ y=""" & FORMAT(vCT,"0") & """ width=""" & FORMAT(vBW,"0") & """ height=""" & FORMAT(vCH,"0") & """/>" &
			                "<g class=""pareto-tooltip"">" &
			                    "<rect x=""" & FORMAT(vTipX,"0") & """ y=""" & FORMAT(vTipY,"0") & """ width=""" & FORMAT(vTipW,"0") & """ height=""" & FORMAT(vTipH,"0") & """ rx=""8"" class=""pareto-tooltip-bg""/>" &
			                    "<text x=""" & FORMAT(vTipX+14,"0") & """ y=""" & FORMAT(vTipY+22,"0") & """ class=""pareto-tooltip-title"">" & vNomeUF & "</text>" &
			                    "<text x=""" & FORMAT(vTipX+14,"0") & """ y=""" & FORMAT(vTipY+46,"0") & """ class=""pareto-tooltip-text"">Faturamento: <tspan font-weight=""800"">" & fV & "</tspan></text>" &
			                    "<text x=""" & FORMAT(vTipX+14,"0") & """ y=""" & FORMAT(vTipY+68,"0") & """ class=""pareto-tooltip-text"">Acumulado: <tspan font-weight=""800"">" & fC & "</tspan></text>" &
			                "</g>" &
			            "</g>",
			        "",
			        [__Rnk], ASC
			    )
			VAR vCutY = FORMAT(vCB - 0.80 * vCH, "0")
			VAR HParetoSVG =
			    IF(
			        COUNTROWS(tParetoFull) = 0,
			        "<div class=""empty-msg"">Sem dados.</div>",
			        "<div class=""chart-wrap pareto-wrap""><svg class=""chart pareto-chart"" viewBox=""0 0 1100 420"" preserveAspectRatio=""xMidYMid meet"">" &
			        "<line x1=""80"" y1=""30"" x2=""80"" y2=""260"" class=""axis-line""/><line x1=""80"" y1=""260"" x2=""1020"" y2=""260"" class=""axis-line""/><line x1=""1020"" y1=""30"" x2=""1020"" y2=""260"" class=""axis-line""/>" &
			        "<line x1=""80"" y1=""30"" x2=""1020"" y2=""30"" class=""grid-line""/><line x1=""80"" y1=""" & FORMAT(vCB-0.25*vCH,"0") & """ x2=""1020"" y2=""" & FORMAT(vCB-0.25*vCH,"0") & """ class=""grid-line""/><line x1=""80"" y1=""" & FORMAT(vCB-0.50*vCH,"0") & """ x2=""1020"" y2=""" & FORMAT(vCB-0.50*vCH,"0") & """ class=""grid-line""/><line x1=""80"" y1=""" & FORMAT(vCB-0.75*vCH,"0") & """ x2=""1020"" y2=""" & FORMAT(vCB-0.75*vCH,"0") & """ class=""grid-line""/>" &
			        "<text x=""75"" y=""34"" class=""axis-label"" text-anchor=""end"">" & FORMAT(DIVIDE(vPMaxFat,1000000),"#,##0.0") & " mi</text><text x=""75"" y=""" & FORMAT(vCB-0.50*vCH+3,"0") & """ class=""axis-label"" text-anchor=""end"">" & FORMAT(DIVIDE(vPMaxFat*0.50,1000000),"#,##0.0") & " mi</text>" &
			        "<text x=""1025"" y=""34"" class=""axis-label"">100%</text><text x=""1025"" y=""" & FORMAT(vCB-0.75*vCH+3,"0") & """ class=""axis-label"">75%</text><text x=""1025"" y=""" & FORMAT(vCB-0.50*vCH+3,"0") & """ class=""axis-label"">50%</text><text x=""1025"" y=""" & FORMAT(vCB-0.25*vCH+3,"0") & """ class=""axis-label"">25%</text><text x=""1025"" y=""263"" class=""axis-label"">0%</text>" &
			        "<line x1=""80"" y1=""" & vCutY & """ x2=""1025"" y2=""" & vCutY & """ class=""pareto-cut""/><text x=""1030"" y=""" & FORMAT(VALUE(vCutY)-4,"0") & """ class=""axis-label pareto-cut-label"">corte A</text>" &
			        HPBars &
			        "<polyline points=""" & HPLine & """ class=""pareto-line""/>" &
			        HPDots &
			        HPHitTips &
			        "<g class=""pareto-legend"" transform=""translate(535,394)""><rect x=""-245"" y=""-4"" width=""18"" height=""8"" class=""pareto-legend-bar"" rx=""1""/><text x=""-222"" y=""4"" class=""legend-item"">Faturamento</text><line x1=""-105"" y1=""0"" x2=""-87"" y2=""0"" class=""pareto-legend-line""/><circle cx=""-96"" cy=""0"" r=""2.6"" class=""pareto-dot""/><text x=""-81"" y=""4"" class=""legend-item"">% acumulado</text><text x=""45"" y=""4"" class=""legend-item"" font-style=""italic"">classe A = contas até 80%</text></g>" &
			        "</svg></div>"
			    )
			// CSS
			VAR vCSS01 = ":root{--brand:#023F76;--brand-deep:#062A4C;--accent:#0A5CA8;--accent-soft:#E9F1F9;--accent-line:#BDD4E9;--on-brand:#FFF;--bg:#F2F5F9;--card:#FFF;--card-2:#F8FAFC;--line:#E2E8F0;--line-strong:#C6D0DD;--ink:#14243A;--ink-2:#3C4E64;--ink-3:#51667F;--pos:#176B3A;--pos-soft:#E4F3E9;--neg:#B4231F;--neg-soft:#FBEAE8;--warn:#8F5600;--warn-soft:#FCF1DE;--cat-1:#0A3A66;--cat-2:#14568E;--cat-3:#2F74AE;--cat-4:#5A94C6;--cat-5:#8CB5DB;--cat-6:#BDD6EC;--sc-real:#0A1B2C;--sc-meta:#5D7186;--sc-ly:#A3B0BE;--font:'Segoe UI',system-ui,-apple-system,sans-serif;--fs-legend:11px;--fs-foot:11px;--fs-lbl:12px;--fs-body:13px;--fs-md:14px;--fs-h3:17px;--fs-indicator:22px;--fs-value:15px;--fs-tag:15px;--radius:12px;--radius-sm:8px;--shadow:0 1px 2px rgba(6,42,76,.05),0 2px 10px rgba(6,42,76,.05)}"
			VAR vCSS02 = "*{box-sizing:border-box;margin:0;padding:0}body{font-family:var(--font);background:var(--bg);color:var(--ink);font-size:var(--fs-body);line-height:1.45}.num{font-variant-numeric:tabular-nums}"
			VAR vCSS03 = ".grid{display:grid;gap:14px}.cards{grid-template-columns:repeat(12,1fr)}.col-12{grid-column:span 12}.col-7{grid-column:span 7}.col-6{grid-column:span 6}.col-5{grid-column:span 5}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow);min-width:0}.card h3{font-size:17px;font-weight:950;letter-spacing:.15em;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:18px;color:var(--brand);text-transform:uppercase;line-height:1.25}.card .desc{font-size:var(--fs-lbl);color:var(--ink-3);margin-bottom:12px}.top10-clientes-card h3{margin-bottom:32px}"
			VAR vCSS05 = ".basetag{font-family:var(--font);font-size:15px;font-weight:800;color:var(--ink-3);background:var(--card-2);border:1px solid var(--line-strong);border-radius:20px;padding:2px 9px;white-space:nowrap;margin-left:6px;text-transform:none !important;letter-spacing:0}.card h3 .basetag:first-of-type{margin-left:auto}.periodtag{background:#E9F1F9 !important;border-color:#BDD4E9 !important;color:#023F76 !important}.partialtag{background:#FFF4D6 !important;border-color:#F3B64A !important;color:#8F5600 !important}"
			VAR vCSS06 = ".rank-row{display:grid;grid-template-columns:120px minmax(140px,1fr) 72px;align-items:center;gap:9px;margin:7px 0}.rank-row.cli{grid-template-columns:calc(160px + 10%) minmax(0,1fr) 72px}.rank-name{font-size:17px;font-weight:500;color:#000;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cli-name{font-size:17px}.rank-bar-cell{min-width:0}.rank-bar-bg{height:14px;background:var(--bg);border-radius:4px;overflow:hidden}.rank-bar{height:14px;background:var(--cat-2);border-radius:4px}.rank-val{font-size:17px;font-weight:500;color:#000;text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}"
			VAR vCSS07 = ".twrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:17px;color:#000}th{text-align:left;font-size:15px;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-3);font-weight:500;padding:7px 9px;border-bottom:2px solid var(--line-strong);white-space:nowrap}td{color:#000;padding:8px 9px;border-bottom:1px solid var(--line);font-weight:500}td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}tr:hover td{background:var(--card-2)}"
			VAR vCSS08 = ".empty-msg{font-size:17px;color:#000;background:var(--card-2);border:1px dashed var(--line-strong);border-radius:8px;padding:16px;text-align:center}.chart-wrap{width:100%;overflow:hidden}svg.chart{width:100%;display:block}.axis-label{font-size:17px;fill:#000;font-family:var(--font)}.axis-line{stroke:var(--line);stroke-width:1}.grid-line{stroke:var(--line);stroke-width:1;stroke-dasharray:3,3}.legend-item{font-size:17px;fill:#000;font-family:var(--font)}"
			VAR vCSS09 = ".ctxline{display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#F8FAFC;border-top:1px solid #D7E2EE;border-bottom:1px solid #D7E2EE;padding:9px 14px;margin:0 0 12px 0;font-family:var(--font);font-size:13px;color:var(--brand-deep);line-height:1.30;min-height:34px;font-weight:650}.ctxline b{font-size:12px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand-deep);margin-right:5px}.ctxline span{display:inline-flex;align-items:center;white-space:nowrap}.ctxline .ctx-divider{width:1px;height:22px;background:#D7E2EE;flex:0 0 1px}.ctxline .ctx-company{display:inline-flex;align-items:center;gap:7px;min-width:0}.ctxline .ctx-company-label{font-size:12px;font-weight:950;letter-spacing:.10em;text-transform:uppercase;color:var(--brand-deep)}.ctxline .ctx-company-value{display:inline-flex;align-items:center;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;border:1px solid #BDD4E9;background:#EDF4FB;color:#023F76;border-radius:999px;padding:5px 12px;font-size:15px;font-weight:900;line-height:1.15;box-shadow:inset 0 0 0 1px rgba(255,255,255,.45)}.ctxline .ctx-right{margin-left:auto;display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap}.ctxline .ctx-base{display:inline-flex;align-items:center;border:1px solid var(--accent-line);background:#E9F1F9;color:var(--brand);border-radius:999px;padding:6px 15px;font-size:15px;font-weight:900;line-height:1.15}.badge{display:inline-flex;align-items:center;border:1px solid var(--accent-line);background:var(--card-2);color:var(--brand);border-radius:999px;font-size:15px;font-weight:900;padding:4px 11px;white-space:nowrap;line-height:1.15}.partial-badge{background:#FFF2D8;border-color:#F0C46A;color:#8F5600}@media(max-width:900px){.ctxline{gap:9px}.ctxline .ctx-divider{display:none}.ctxline .ctx-company{order:3;width:100%}.ctxline .ctx-company-value{max-width:calc(100% - 92px)}.ctxline .ctx-right{margin-left:auto}}@media(max-width:680px){.ctxline{gap:10px}.ctxline .ctx-right{width:100%;margin-left:0;justify-content:flex-start}}"
			VAR vCSS10 = ".pareto-card{padding:18px 22px}.pareto-wrap{overflow-x:auto;margin-top:4px}.pareto-wrap svg.chart{min-width:1000px;min-height:450px}.pareto-chart{overflow:visible}.pareto-bar,.pareto-legend-bar{fill:var(--cat-2)}.pareto-line{fill:none;stroke:var(--cat-1);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.pareto-dot{fill:var(--cat-1);stroke:#FFF;stroke-width:1.4}.pareto-cut{stroke:var(--neg);stroke-width:1.2;stroke-dasharray:6,4}.pareto-cut-label{fill:#000;font-weight:500;font-size:17px}.pareto-legend-line{stroke:var(--cat-1);stroke-width:2}.pareto-x-label{font-size:16px;font-weight:500}.pareto-hit{fill:transparent;cursor:pointer}.pareto-tooltip{opacity:0;pointer-events:none;transition:opacity .12s ease}.pareto-hover:hover .pareto-tooltip{opacity:1}.pareto-hover:hover .pareto-hit{fill:rgba(20,86,142,.04)}.pareto-tooltip-bg{fill:#FFF;stroke:#D9E2EC;stroke-width:1;filter:drop-shadow(0 3px 7px rgba(6,42,76,.22))}.pareto-tooltip-title{font-family:var(--font);font-size:17px;font-weight:500;fill:#000}.pareto-tooltip-text{font-family:var(--font);font-size:17px;font-weight:500;fill:#000}@media(max-width:1180px){.col-7,.col-6,.col-5{grid-column:span 12}}"
			VAR vCSS11 = "tfoot td{font-weight:800;color:#000;border-top:2px solid var(--line-strong);border-bottom:none}tfoot tr:hover td{background:transparent}tr.agg td{color:var(--ink-2)}"
			VAR vCSS12 =
			    ".info{position:relative;display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border:1.5px solid var(--brand);border-radius:50%;background:var(--accent-soft);color:var(--brand);font-size:11px;font-weight:800;line-height:1;letter-spacing:0;text-transform:none;vertical-align:middle;cursor:help;flex:none;}.info-tip{position:absolute;top:calc(100% + 8px);right:0;width:272px;background:var(--brand-deep);color:#FFFFFF;font-size:12.5px;font-weight:600;line-height:1.5;letter-spacing:0;text-transform:none;text-align:left;white-space:normal;padding:10px 12px;border-radius:6px;box-shadow:0 4px 16px rgba(6,42,76,.30);opacity:0;visibility:hidden;transition:opacity .15s ease;z-index:80;pointer-events:none;}.info-tip b{font-weight:800;color:#FFFFFF;}.info:hover .info-tip,.info:focus .info-tip{opacity:1;visibility:visible;}"
			VAR vCSS13 =
			    ".badge,.partial-badge{text-transform:none !important;}.basetag,.periodtag,.partialtag,.tag{font-family:var(--font) !important;font-size:15px !important;font-weight:900 !important;line-height:1.1 !important;letter-spacing:.02em !important;text-transform:none !important;}"
			VAR vCSS = "<style>" & vCSS01 & vCSS02 & vCSS03 & vCSS05 & vCSS06 & vCSS07 & vCSS08 & vCSS09 & vCSS10 & vCSS11 & vCSS12 & vCSS13 & "</style>"
			// HTML
			VAR HCTX =
			    "<div class=""ctxline"">" &
			        "<span><b>ATUALIZADO</b> " & fAtualizacaoContexto & "</span>" &
			        "<span class=""ctx-divider""></span>" &
			        "<span class=""ctx-company"">" &
			            "<span class=""ctx-company-label"">EMPRESA</span>" &
			            "<span class=""ctx-company-value"">" & vEmpresaContexto & "</span>" &
			        "</span>" &
			        "<span class=""ctx-right"">" &
			            vParcialBadge &
			            "<span class=""ctx-base"">" & vTagBase & "</span>" &
			        "</span>" &
			    "</div>"
			VAR HCANAL_TAB = "<div class=""card col-6""><h3>Faturamento por canal <span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Faturamento por canal; top 8 mais OUTROS e TOTAL"">i<span class=""info-tip"">Faturamento por <b>canal</b> no período.<br>Top 8 canais · <b>OUTROS</b> agrega os demais · <b>TOTAL</b> soma todos.<br>Acompanha a base selecionada.</span></span></h3>" & HCanalTabela & "</div>"
			VAR HCLI_RANK = "<div class=""card col-6 top10-clientes-card""><h3>Top 15 clientes <span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Top 15 clientes por faturamento no periodo"">i<span class=""info-tip""><b>Top 15 clientes</b> por faturamento no período.<br>A barra é proporcional ao maior cliente da lista.<br>Acompanha a base selecionada.</span></span></h3>" & HCliRows & "</div>"
			VAR HPARETO = "<div class=""card col-12 pareto-card""><h3>Pareto de clientes — concentração A/B/C <span class=""basetag"">" & vBaseTagReceita & "</span>" & vPeriodoBadge & vParcialBadge & "<span class=""info"" tabindex=""0"" role=""note"" aria-label=""Barras sao os 10 maiores clientes e a linha e o acumulado; classe A ate 80%"">i<span class=""info-tip""><b>Barras</b> = faturamento dos 10 maiores clientes.<br><b>Linha</b> = participação acumulada sobre o total de clientes do período.<br><b>Classe A</b> = clientes que somam até 80% do faturamento.<br>Acompanha a base selecionada.</span></span></h3>" & HParetoSVG & "</div>"
			VAR vHTML = vCSS & HCTX & "<div class=""fb""><div class=""grid cards"">" & HCANAL_TAB & HCLI_RANK & HPARETO & "</div></div>"
			RETURN vHTML
			
			```
		displayFolder: Bi_novo
		lineageTag: b4edd1d0-d13f-4aac-902e-5693be5fa875

	/// Valor faturado dos pedidos com data de entrega anterior a hoje.
	measure '06 Valor Entregue' =
			
			VAR vBaseReceita =
			    SELECTEDVALUE(
			        'Base Receita'[Base Receita],
			        "Receita Semi Líquida"
			    )
			
			RETURN
			    IF(
			        vBaseReceita = "Receita Bruta",
			        CALCULATE(
			            [08 Faturamento Bruto],
			            KEEPFILTERS(
			                NOT ISBLANK(
			                    fVendas_unificada[data_entrega]
			                )
			            ),
			            KEEPFILTERS(
			                fVendas_unificada[data_entrega] <= TODAY()
			            )
			        ),
			        CALCULATE(
			            [00 Faturamento],
			            KEEPFILTERS(
			                NOT ISBLANK(
			                    fVendas_unificada[data_entrega]
			                )
			            ),
			            KEEPFILTERS(
			                fVendas_unificada[data_entrega] <= TODAY()
			            )
			        )
			    )
		displayFolder: 01 Vendas
		lineageTag: 3a0cd8f1-3d74-4095-9f93-71ac5245be94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Farmax BI HTML old' =
			
			
			// Medidas do modelo
			// A segmentacao Base Receita controla simultaneamente Receita e Faturamento.
			// Receita Semi Liquida => Receita = [03 RSL] e Faturamento = [00 Faturamento]
			// Receita Bruta        => Receita = [09 Receita Bruta] e Faturamento = [08 faturamento_bruto]
			VAR vBaseReceitaSelecionada = SELECTEDVALUE('Base Receita'[Base Receita], "Receita Semi Líquida")
			VAR vUsarReceitaBruta      = vBaseReceitaSelecionada = "Receita Bruta"
			VAR vFaturamentoLiquido    = COALESCE([00 Faturamento], 0)
			VAR vFaturamentoBruto      = COALESCE([08 Faturamento Bruto], 0)
			VAR vFaturamento           = IF(vUsarReceitaBruta, vFaturamentoBruto, vFaturamentoLiquido)
			VAR vRSLBase               = COALESCE([03 RSL], 0)
			VAR vReceitaBruta          = COALESCE([09 Receita Bruta], 0)
			VAR vRSL                   = IF(vUsarReceitaBruta, vReceitaBruta, vRSLBase)
			
			// Periodo comparavel para indicadores de Receita e Faturamento.
			// Quando o mes selecionado for o mes corrente, limita YoY e MoM ao mesmo dia de corte.
			VAR vDataInicioSelecionada = MIN('dTempo'[Data])
			VAR vDataFimSelecionada    = MAX('dTempo'[Data])
			VAR vMesSelecionadoAtual   =
			    YEAR(vDataFimSelecionada) = YEAR(TODAY())
			        && MONTH(vDataFimSelecionada) = MONTH(TODAY())
			VAR vDataFimComparavel     =
			    IF(
			        vMesSelecionadoAtual,
			        MIN(TODAY(), EOMONTH(vDataFimSelecionada, 0)),
			        vDataFimSelecionada
			    )
			VAR vDataInicioComparavel  =
			    IF(
			        vMesSelecionadoAtual,
			        DATE(YEAR(vDataFimSelecionada), MONTH(vDataFimSelecionada), 1),
			        vDataInicioSelecionada
			    )
			VAR vDiaCorteComparavel    = DAY(vDataFimComparavel)
			VAR vDataInicioLY          = EDATE(vDataInicioComparavel, -12)
			VAR vDataFimLY             =
			    DATE(
			        YEAR(EDATE(vDataFimComparavel, -12)),
			        MONTH(EDATE(vDataFimComparavel, -12)),
			        MIN(vDiaCorteComparavel, DAY(EOMONTH(EDATE(vDataFimComparavel, -12), 0)))
			    )
			
			// Comparação MoM: replica a lógica do painel Pedidos & Faturamentos.
			// Mês completo compara com o mês anterior completo; período parcial
			// compara exatamente o mesmo intervalo de datas deslocado em um mês.
			VAR vSelecaoDentroDeUmMes =
			    YEAR(vDataInicioComparavel) = YEAR(vDataFimComparavel)
			        && MONTH(vDataInicioComparavel) = MONTH(vDataFimComparavel)
			VAR vSelecaoMesCompleto =
			    vSelecaoDentroDeUmMes
			        && vDataInicioComparavel = DATE(YEAR(vDataInicioComparavel), MONTH(vDataInicioComparavel), 1)
			        && vDataFimComparavel = EOMONTH(vDataFimComparavel, 0)
			VAR vDataInicioPM =
			    IF(
			        vSelecaoMesCompleto,
			        EOMONTH(vDataInicioComparavel, -2) + 1,
			        EDATE(vDataInicioComparavel, -1)
			    )
			VAR vDataFimPM =
			    IF(
			        vSelecaoMesCompleto,
			        EOMONTH(vDataFimComparavel, -1),
			        EDATE(vDataFimComparavel, -1)
			    )
			VAR vBaseTagReceita        = IF(vUsarReceitaBruta, "Base RB", "Base RSL")
			// As medidas de RB retornam texto e podem conter "-". A validacao e feita antes da conversao numerica
			// para impedir que o indicador de atingimento assuma 100% quando nao existe meta.
			VAR vMetaRBTexto           = TRIM([Meta RB] & "")
			VAR vMetaRSL               =
			    IF(
			        vUsarReceitaBruta,
			        IF(vMetaRBTexto = "-" || vMetaRBTexto = "", BLANK(), IFERROR(VALUE(vMetaRBTexto), BLANK())),
			        [Meta RSL]
			    )
			VAR vTemMeta               = NOT ISBLANK(vMetaRSL) && vMetaRSL <> 0
			VAR vDevolucao             = COALESCE([00 Devolução], 0)
			VAR vRefaturamento         = COALESCE([01 Refaturamento], 0)
			VAR vDevolucaoTotal        = vDevolucao + vRefaturamento
			
			// Representatividade de cada componente no Total de Devolução.
			// Devolução + Refaturamento = 100% quando o total for diferente de zero.
			VAR vPercDevolucao         = DIVIDE(vDevolucao, vDevolucaoTotal, 0)
			VAR vPercRefaturamento     = DIVIDE(vRefaturamento, vDevolucaoTotal, 0)
			
			// Mantém a classificação visual do card baseada no impacto total sobre o faturamento.
			VAR vPercDevolucaoTotalFat = DIVIDE(vDevolucaoTotal, vFaturamento, 0)
			VAR vFatLY                =
			    COALESCE(
			        CALCULATE(
			            IF(vUsarReceitaBruta, [08 Faturamento Bruto], [00 Faturamento]),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN('dTempo'[Data], vDataInicioLY, vDataFimLY)
			        ),
			        0
			    )
			VAR vFaturamentoYoY        = DIVIDE(vFaturamento - vFatLY, ABS(vFatLY), 0)
			VAR vFatPM                 =
			    COALESCE(
			        CALCULATE(
			            IF(vUsarReceitaBruta, [08 Faturamento Bruto], [00 Faturamento]),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN('dTempo'[Data], vDataInicioPM, vDataFimPM)
			        ),
			        0
			    )
			VAR vFaturamentoMoM        = DIVIDE(vFaturamento - vFatPM, ABS(vFatPM), 0)
			VAR vReceitaLY             =
			    COALESCE(
			        CALCULATE(
			            IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL]),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN('dTempo'[Data], vDataInicioLY, vDataFimLY)
			        ),
			        0
			    )
			VAR vPercYoY               = DIVIDE(vRSL - vReceitaLY, ABS(vReceitaLY), 0)
			VAR vReceitaPM             =
			    COALESCE(
			        CALCULATE(
			            IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL]),
			            REMOVEFILTERS('dTempo'),
			            DATESBETWEEN('dTempo'[Data], vDataInicioPM, vDataFimPM)
			        ),
			        0
			    )
			VAR vReceitaMoM            = DIVIDE(vRSL - vReceitaPM, ABS(vReceitaPM), 0)
			VAR vMetaPrecoMedio        = COALESCE([Meta Preço Médio], 0)
			VAR vPrecoMedio            =
			    COALESCE(
			        IF(
			            vUsarReceitaBruta,
			            [07 Preço Médio Bruto],
			            [07 Preço Médio]
			        ),
			        0
			    )
			VAR vAtualizacao           = [00 Atualização]
			VAR vDataAtualizacao =
			    IF(
			        ISTEXT(vAtualizacao),
			        IFERROR(
			            DATE(
			                VALUE(MID(TRIM(SUBSTITUTE(vAtualizacao, "Atualizado em:", "")), 7, 4)),
			                VALUE(MID(TRIM(SUBSTITUTE(vAtualizacao, "Atualizado em:", "")), 4, 2)),
			                VALUE(LEFT(TRIM(SUBSTITUTE(vAtualizacao, "Atualizado em:", "")), 2))
			            ),
			            TODAY()
			        ),
			        INT(vAtualizacao)
			    )
			VAR vDataCorteDecisao = MIN(vDataAtualizacao, EOMONTH(vDataFimSelecionada, 0))
			VAR vInicioMesDecisao = DATE(YEAR(vDataFimSelecionada), MONTH(vDataFimSelecionada), 1)
			VAR vFimMesDecisao = EOMONTH(vDataFimSelecionada, 0)
			VAR vDiasUteisTotal =
			    CALCULATE(
			        COUNTROWS('dTempo'),
			        REMOVEFILTERS('dTempo'),
			        DATESBETWEEN('dTempo'[Data], vInicioMesDecisao, vFimMesDecisao),
			        'dTempo'[DiaUtil] = 1
			    )
			VAR vDiasUteisRealizados =
			    CALCULATE(
			        COUNTROWS('dTempo'),
			        REMOVEFILTERS('dTempo'),
			        DATESBETWEEN('dTempo'[Data], vInicioMesDecisao, vDataCorteDecisao),
			        'dTempo'[DiaUtil] = 1
			    )
			VAR vDiasUteisRestantes = MAX(0, vDiasUteisTotal - vDiasUteisRealizados)
			VAR vPercDiasUteis = DIVIDE(vDiasUteisRealizados, vDiasUteisTotal, 0)
			VAR vAtingimentoDecisao = DIVIDE(vRSL, vMetaRSL, 0)
			VAR vRitmoAtualDU = DIVIDE(vRSL, vDiasUteisRealizados, 0)
			VAR vReceitaFaltante = MAX(0, vMetaRSL - vRSL)
			VAR vRitmoNecessarioDU = DIVIDE(vReceitaFaltante, vDiasUteisRestantes, 0)
			VAR vMultiplicadorRitmo = DIVIDE(vRitmoNecessarioDU, vRitmoAtualDU, 0)
			// vProjecaoFechamento permanece ativa mesmo com a linha oculta no hero:
			// ela e a base de vStatusDecisao e vStatusDecisaoCls (selo EM LINHA / ABAIXO e cor do card).
			VAR vProjecaoFechamento = vRitmoAtualDU * vDiasUteisTotal
			// Gap vs meta = receita realizada no periodo menos a meta do periodo.
			// Ambas seguem a segmentacao Base Receita: RSL x Meta RSL ou RB x Meta RB.
			// Sem meta no contexto o gap fica em branco para nao exibir superavit falso.
			VAR vGapProjetado = IF(vTemMeta, vRSL - vMetaRSL, BLANK())
			VAR vGapProjetadoPerc = DIVIDE(vGapProjetado, vMetaRSL, 0)
			VAR vStatusDecisao = IF(NOT vTemMeta, "SEM META", IF(vProjecaoFechamento >= vMetaRSL, "EM LINHA", "ABAIXO"))
			VAR vStatusDecisaoCls = IF(NOT vTemMeta, "neutral", IF(vProjecaoFechamento >= vMetaRSL, "positive", "negative"))
			VAR vMesDecisao =
			    UPPER(
			        SWITCH(
			            MONTH(vInicioMesDecisao),
			            1, "JANEIRO", 2, "FEVEREIRO", 3, "MARÇO", 4, "ABRIL",
			            5, "MAIO", 6, "JUNHO", 7, "JULHO", 8, "AGOSTO",
			            9, "SETEMBRO", 10, "OUTUBRO", 11, "NOVEMBRO", 12, "DEZEMBRO"
			        )
			    )
			VAR fAtingimentoDecisao = IF(vTemMeta, FORMAT(vAtingimentoDecisao, "0.0%"), "-")
			VAR fPercDiasUteis = FORMAT(vPercDiasUteis, "0%")
			VAR fRitmoAtualDU = FORMAT(DIVIDE(vRitmoAtualDU, 1000000), "R$ #,##0.00") & " mi/du"
			VAR fRitmoNecessarioDU = IF(vDiasUteisRestantes > 0, FORMAT(DIVIDE(vRitmoNecessarioDU, 1000000), "R$ #,##0.00") & " mi/du", "-")
			VAR fMultiplicadorRitmo = IF(vDiasUteisRestantes > 0, FORMAT(vMultiplicadorRitmo, "0.0x"), "-")
			VAR fProjecaoFechamento = FORMAT(DIVIDE(vProjecaoFechamento, 1000000), "R$ #,##0.0") & " mi"
			VAR fGapProjetado =
			    IF(
			        vTemMeta,
			        FORMAT(DIVIDE(vGapProjetado, 1000000), "+R$ #,##0.0;-R$ #,##0.0;R$ 0.0") & " mi",
			        "-"
			    )
			VAR fGapProjetadoPerc = IF(vTemMeta, FORMAT(vGapProjetadoPerc, "+0%;-0%;0%"), "-")
			
			// Atingimento de meta por empresa - dinamico e sensivel aos filtros do relatorio.
			// Todas as empresas usam a mesma escala absoluta, definida pela maior meta do contexto.
			VAR tAtingEmpresaBase =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('dEmpresa'[Empresa]),
			            NOT ISBLANK('dEmpresa'[Empresa])
			        ),
			        "__Empresa", 'dEmpresa'[Empresa],
			        "__Receita",
			            COALESCE(
			                CALCULATE(
			                    IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL])
			                ),
			                0
			            ),
			        "__Meta",
			            IFERROR(
			                VALUE(
			                    CALCULATE(
			                        IF(vUsarReceitaBruta, [Meta RB], [Meta RSL])
			                    )
			                ),
			                BLANK()
			            )
			    )
			VAR tAtingEmpresaFiltrada =
			    FILTER(
			        tAtingEmpresaBase,
			        [__Receita] <> 0 || NOT ISBLANK([__Meta])
			    )
			VAR tAtingEmpresa =
			    ADDCOLUMNS(
			        tAtingEmpresaFiltrada,
			        "__Ordem",
			            RANKX(
			                tAtingEmpresaFiltrada,
			                [__Empresa],
			                ,
			                ASC,
			                DENSE
			            )
			    )
			VAR vAtingEmpresaQtd = COUNTROWS(tAtingEmpresa)
			// Posicionamento centralizado dos componentes dentro do SVG.
			VAR vAtingNomeX = 20
			VAR vAtingTrackX = 130
			VAR vAtingTrackW = 220
			VAR vAtingValorX = 375
			VAR vAtingRowH = 76
			VAR vAtingEscalaMaiorMeta =
			    MAXX(
			        tAtingEmpresa,
			        COALESCE([__Meta], 0)
			    )
			VAR vAtingEscalaFallback =
			    MAXX(
			        tAtingEmpresa,
			        [__Receita]
			    )
			VAR vAtingEscalaValorBase =
			    IF(
			        NOT ISBLANK(vAtingEscalaMaiorMeta) && vAtingEscalaMaiorMeta > 0,
			        vAtingEscalaMaiorMeta,
			        vAtingEscalaFallback
			    )
			VAR vAtingEscalaValorSeguro =
			    IF(
			        ISBLANK(vAtingEscalaValorBase) || vAtingEscalaValorBase = 0,
			        1,
			        vAtingEscalaValorBase
			    )
			VAR fAtingEscalaMax =
			    FORMAT(
			        DIVIDE(vAtingEscalaValorSeguro, 1000000),
			        "R$ #,##0.0"
			    ) & " mi"
			VAR vAtingSVGH = MAX(105, vAtingEmpresaQtd * vAtingRowH + 18)
			VAR HAtingEmpresaRows =
			    IF(
			        vAtingEmpresaQtd = 0,
			        "<text x=""320"" y=""48"" text-anchor=""middle"" class=""axis-label"">Sem empresas com receita ou meta no contexto atual.</text>",
			        CONCATENATEX(
			            tAtingEmpresa,
			            VAR vEmpresa = [__Empresa]
			            VAR vReceitaEmpresa = [__Receita]
			            VAR vMetaEmpresa = [__Meta]
			            VAR vOrdemEmpresa = [__Ordem]
			            VAR vAtingEmpresa = DIVIDE(vReceitaEmpresa, vMetaEmpresa, 0)
			            VAR fAtingEmpresa =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa = 0,
			                    "-",
			                    FORMAT(vAtingEmpresa, "0%")
			                )
			            VAR fReceitaEmpresa =
			                FORMAT(DIVIDE(vReceitaEmpresa, 1000000), "R$ #,##0.00") & " mi"
			            VAR fMetaEmpresa =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa = 0,
			                    "Meta: -",
			                    "Meta: " & FORMAT(DIVIDE(vMetaEmpresa, 1000000), "R$ #,##0.00") & " mi"
			                )
			            VAR vRealizadoClasse =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "",
			                    IF(vReceitaEmpresa >= vMetaEmpresa, " ating-ok", " ating-bad")
			                )
			            VAR vRealPx =
			                MIN(
			                    vAtingTrackW,
			                    MAX(
			                        0,
			                        DIVIDE(vReceitaEmpresa, vAtingEscalaValorSeguro, 0) * vAtingTrackW
			                    )
			                )
			            VAR vMetaPx =
			                MIN(
			                    vAtingTrackW,
			                    MAX(
			                        0,
			                        DIVIDE(COALESCE(vMetaEmpresa, 0), vAtingEscalaValorSeguro, 0) * vAtingTrackW
			                    )
			                )
			            // O preenchimento visual nunca ultrapassa o traço de 100% da empresa.
			            // O percentual textual continua exibindo o atingimento real, inclusive acima de 100%.
			            VAR vRealVisivelPx =
			                IF(
			                    NOT ISBLANK(vMetaEmpresa) && vMetaEmpresa > 0,
			                    MIN(vRealPx, vMetaPx),
			                    vRealPx
			                )
			            VAR fRealPx = SUBSTITUTE(FORMAT(vRealVisivelPx, "0.0"), ",", ".")
			            VAR fMetaPx = SUBSTITUTE(FORMAT(vMetaPx, "0.0"), ",", ".")
			            VAR fMetaX =
			                SUBSTITUTE(
			                    FORMAT(vAtingTrackX + vMetaPx - 2, "0.0"),
			                    ",",
			                    "."
			                )
			            VAR vYBase = 10 + (vOrdemEmpresa - 1) * vAtingRowH
			            VAR fYNome = FORMAT(vYBase + 22, "0")
			            VAR fYTrack = FORMAT(vYBase + 7, "0")
			            VAR fYReal = FORMAT(vYBase + 11, "0")
			            VAR fYMeta = FORMAT(vYBase + 1, "0")
			            VAR fYValor = FORMAT(vYBase + 21, "0")
			            VAR fYMetaValor = FORMAT(vYBase + 54, "0")
			            RETURN
			                "<text x=""" & FORMAT(vAtingNomeX, "0") & """ y=""" & fYNome & """ class=""axis-label"" font-weight=""850"">" & vEmpresa & "</text>" &
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "",
			                    "<rect x=""" & FORMAT(vAtingTrackX, "0") & """ y=""" & fYTrack & """ width=""" & fMetaPx & """ height=""18"" rx=""6"" fill=""var(--sc-ly)"" fill-opacity=""0.34"" stroke=""none""/>"
			                ) &
			                "<rect x=""" & FORMAT(vAtingTrackX, "0") & """ y=""" & fYReal & """ width=""" & fRealPx & """ height=""10"" rx=""5"" fill=""var(--sc-real)"" stroke=""none""/>" &
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "",
			                    "<rect x=""" & fMetaX & """ y=""" & fYMeta & """ width=""4"" height=""31"" rx=""2"" class=""meta-target-line""/>"
			                ) &
			                "<text x=""" & FORMAT(vAtingValorX, "0") & """ y=""" & fYValor & """ class=""value-inline" & vRealizadoClasse & """>Realizado: " & fReceitaEmpresa & "</text>" &
			                "<text x=""" & FORMAT(vAtingValorX, "0") & """ y=""" & fYMetaValor & """ class=""meta-value-inline"">" & fMetaEmpresa & "</text>",
			            "",
			            [__Ordem],
			            ASC
			        )
			    )
			// Formato alternativo do Atingimento de Meta inspirado no layout de cards por empresa.
			VAR HAtingEmpresaCards =
			    IF(
			        vAtingEmpresaQtd = 0,
			        "<div class=""ating-goal-empty"">Sem empresas com receita ou meta no contexto atual.</div>",
			        CONCATENATEX(
			            tAtingEmpresa,
			            VAR vEmpresa = [__Empresa]
			            VAR vReceitaEmpresa = [__Receita]
			            VAR vMetaEmpresa = [__Meta]
			            VAR vAtingEmpresa = DIVIDE(vReceitaEmpresa, vMetaEmpresa, 0)
			            VAR fAtingEmpresa =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "-",
			                    FORMAT(vAtingEmpresa, "0%")
			                )
			            VAR fReceitaEmpresa =
			                FORMAT(DIVIDE(vReceitaEmpresa, 1000000), "R$ #,##0.00") & " mi"
			            VAR fMetaEmpresa =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "Meta: -",
			                    "Meta: " & FORMAT(DIVIDE(vMetaEmpresa, 1000000), "R$ #,##0.00") & " mi"
			                )
			            VAR vRealizadoClasse =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    "",
			                    IF(vReceitaEmpresa >= vMetaEmpresa, " ating-ok", " ating-bad")
			                )
			            VAR vAtingLargura =
			                IF(
			                    ISBLANK(vMetaEmpresa) || vMetaEmpresa <= 0,
			                    0,
			                    MIN(100, MAX(0, vAtingEmpresa * 100))
			                )
			            RETURN
			                "<div class=""ating-goal-item"">" &
			                    "<div class=""ating-goal-company"">" & vEmpresa & "</div>" &
			                    "<div class=""ating-goal-main" & vRealizadoClasse & """>" &
			                        "<span class=""ating-goal-pct"">" & fAtingEmpresa & "</span>" &
			                        "<span class=""ating-goal-real"">" & fReceitaEmpresa & "</span>" &
			                    "</div>" &
			                    "<div class=""ating-goal-track"" aria-label=""Progresso da meta"">" &
			                        "<div class=""ating-goal-fill" & vRealizadoClasse & """ style=""width:" & FORMAT(vAtingLargura, "0") & "%""></div>" &
			                        IF(vAtingEmpresa >= 1, "<div class=""ating-goal-overflow-dot" & vRealizadoClasse & """></div>", "") &
			                    "</div>" &
			                    "<div class=""ating-goal-meta"">" & fMetaEmpresa & "</div>" &
			                "</div>",
			            "",
			            [__Ordem],
			            ASC
			        )
			    )
			VAR vPMWidth     = FORMAT(MIN(100, MAX(0, DIVIDE(vPrecoMedio, IF(vMetaPrecoMedio=0,1,vMetaPrecoMedio),0)*100)), "0")
			VAR vClsDev      = IF(vPercDevolucaoTotalFat<=0.02,"pos",IF(vPercDevolucaoTotalFat<=0.04,"warn","neg"))
			VAR vClsPM       = IF(vPrecoMedio>=vMetaPrecoMedio,"pos",IF(vPrecoMedio>=vMetaPrecoMedio*0.97,"warn","neg"))
			VAR vSetaYoY     = IF(vPercYoY>0,UNICHAR(9650),IF(vPercYoY<0,UNICHAR(9660),UNICHAR(9679)))
			VAR vSetaMoM     = IF(vReceitaMoM>0,UNICHAR(9650),IF(vReceitaMoM<0,UNICHAR(9660),UNICHAR(9679)))
			VAR vSetaFatYoY  = IF(vFaturamentoYoY>0,UNICHAR(9650),IF(vFaturamentoYoY<0,UNICHAR(9660),UNICHAR(9679)))
			VAR vSetaFatMoM  = IF(vFaturamentoMoM>0,UNICHAR(9650),IF(vFaturamentoMoM<0,UNICHAR(9660),UNICHAR(9679)))
			VAR fRSL      = FORMAT(DIVIDE(vRSL,1000000),             "R$ #,##0.00") & " mi"
			VAR fFatNum   = FORMAT(DIVIDE(vFaturamento,1000000),     "#,##0.00")
			VAR fRSLNum   = FORMAT(DIVIDE(vRSL,1000000),             "#,##0.00")
			VAR fMetaRSL  = IF(NOT vTemMeta, "-", FORMAT(DIVIDE(vMetaRSL,1000000), "R$ #,##0.00") & " mi")
			VAR fDev      = FORMAT(DIVIDE(vDevolucao,1000000),       "R$ #,##0.00") & " mi"
			VAR fRef      = FORMAT(DIVIDE(vRefaturamento,1000000),   "R$ #,##0.00") & " mi"
			VAR fDevTotNum= FORMAT(DIVIDE(vDevolucaoTotal,1000000),  "#,##0.00")
			VAR fPercDev  = FORMAT(vPercDevolucao,   "0.00%")
			VAR fPercRef  = FORMAT(vPercRefaturamento, "0.00%")
			VAR fPercYoY     = FORMAT(vPercYoY,          "+0.0%;-0.0%;0.0%")
			VAR fPercMoM     = FORMAT(vReceitaMoM,       "+0.0%;-0.0%;0.0%")
			VAR fPercFatYoY  = FORMAT(vFaturamentoYoY,   "+0.0%;-0.0%;0.0%")
			VAR fPercFatMoM  = FORMAT(vFaturamentoMoM,   "+0.0%;-0.0%;0.0%")
			VAR fPM       = FORMAT(vPrecoMedio,      "R$ #,##0.00")
			VAR fMetaPM   = FORMAT(vMetaPrecoMedio,  "R$ #,##0.00")
			VAR fAtu =
			    IF(
			        ISTEXT(vAtualizacao),
			        TRIM(SUBSTITUTE(vAtualizacao, "Atualizado em:", "")),
			        FORMAT(vAtualizacao, "dd/mm/yyyy hh:mm")
			    )
			VAR vDiaParcial =
			    IFERROR(
			        VALUE(LEFT(fAtu, 2)),
			        DAY(TODAY())
			    )
			VAR fDiaParcial = FORMAT(vDiaParcial, "0")
			
			// Barra fixa de contexto: base, atualização e identificação de mês parcial
			VAR vTagBase =
			    IF(
			        vUsarReceitaBruta,
			        "BASE RB",
			        "BASE RSL"
			    )
			// ==========================================================
			// CONTEXTO DE EMPRESA — HIERARQUIA dEmpresa
			// Empresa > Description
			// ==========================================================
			VAR vEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Empresa]
			    )
			
			VAR vDescricaoEmpresaSelecionada =
			    SELECTEDVALUE(
			        'dEmpresa'[Description]
			    )
			
			VAR vEmpresaContexto =
			    SWITCH(
			        TRUE(),
			
			        HASONEVALUE('dEmpresa'[Description])
			            && NOT ISBLANK(vDescricaoEmpresaSelecionada),
			            COALESCE(vEmpresaSelecionada, "Empresa")
			                & " › "
			                & vDescricaoEmpresaSelecionada,
			
			        HASONEVALUE('dEmpresa'[Empresa])
			            && NOT ISBLANK(vEmpresaSelecionada),
			            vEmpresaSelecionada,
			
			        ISFILTERED('dEmpresa'[Empresa])
			            || ISFILTERED('dEmpresa'[Description]),
			            "Múltiplas empresas",
			
			        "Grupo"
			    )
			
			VAR vAtualizacaoContexto = [00 Atualização]
			VAR fAtualizacaoContexto =
			    IF(
			        ISBLANK(vAtualizacaoContexto),
			        "-",
			        IF(
			            ISTEXT(vAtualizacaoContexto),
			            TRIM(SUBSTITUTE(vAtualizacaoContexto, "Atualizado em:", "")),
			            FORMAT(vAtualizacaoContexto, "dd/mm/yyyy hh:mm")
			        )
			    )
			VAR vDataInicialSelecionadaContexto = MIN('dTempo'[Data])
			VAR vDataFinalSelecionadaContexto = MAX('dTempo'[Data])
			VAR vInicioMesAtualContexto = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR vFimMesAtualContexto = EOMONTH(TODAY(), 0)
			VAR vPeriodoIncluiMesAtualContexto =
			    NOT ISBLANK(vDataInicialSelecionadaContexto)
			        && NOT ISBLANK(vDataFinalSelecionadaContexto)
			        && vDataInicialSelecionadaContexto <= vFimMesAtualContexto
			        && vDataFinalSelecionadaContexto >= vInicioMesAtualContexto
			VAR vParcialBadgeContexto =
			    IF(
			        vPeriodoIncluiMesAtualContexto,
			        "<span class=""badge partial-badge"">Mês parcial até dia "
			            & FORMAT(DAY(TODAY()), "0")
			            & "</span>",
			        ""
			    )
			
			// Periodo selecionado - usa SOMENTE o contexto filtrado atual.
			// Evita ALLSELECTED para nao exibir o intervalo completo da tabela calendario.
			// Exemplo: Ano=2026 e Mes=Junho => Jun-26.
			VAR vDataIniPeriodo = MIN('dTempo'[Data])
			VAR vDataFimPeriodo = MAX('dTempo'[Data])
			VAR vMesIniPeriodo =
			    SWITCH(
			        MONTH(vDataIniPeriodo),
			        1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
			        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez",
			        ""
			    )
			VAR vMesFimPeriodo =
			    SWITCH(
			        MONTH(vDataFimPeriodo),
			        1, "Jan", 2, "Fev", 3, "Mar", 4, "Abr", 5, "Mai", 6, "Jun",
			        7, "Jul", 8, "Ago", 9, "Set", 10, "Out", 11, "Nov", 12, "Dez",
			        ""
			    )
			VAR fPeriodoIniCurto = vMesIniPeriodo & "-" & FORMAT(vDataIniPeriodo, "yy")
			VAR fPeriodoFimCurto = vMesFimPeriodo & "-" & FORMAT(vDataFimPeriodo, "yy")
			VAR fPeriodoSelecionado =
			    IF(
			        ISBLANK(vDataIniPeriodo) || ISBLANK(vDataFimPeriodo),
			        "Período nao selecionado",
			        IF(
			            YEAR(vDataIniPeriodo) = YEAR(vDataFimPeriodo)
			                && MONTH(vDataIniPeriodo) = MONTH(vDataFimPeriodo),
			            fPeriodoFimCurto,
			            fPeriodoIniCurto & " a " & fPeriodoFimCurto
			        )
			    )
			VAR vPeriodoBadge = "<span class=""basetag periodtag"">" & fPeriodoSelecionado & "</span>"
			VAR vPeriodoIncluiMesCorrente =
			    NOT ISBLANK(vDataFimPeriodo)
			        && YEAR(vDataFimPeriodo) = YEAR(TODAY())
			        && MONTH(vDataFimPeriodo) = MONTH(TODAY())
			VAR vParcialBadge =
			    IF(
			        vPeriodoIncluiMesCorrente,
			        "<span class=""basetag partialtag"">Mês parcial até dia " & fDiaParcial & "</span>",
			        ""
			    )
			
			// Regiao x Meta dinamico - usa os valores existentes em dRegional e responde aos filtros do relatorio
			VAR tRegiaoBase =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('dRegional'[order_sale_order_office]),
			            NOT ISBLANK('dRegional'[order_sale_order_office])
			        ),
			        "__Nome", 'dRegional'[order_sale_order_office],
			        "__Realizado", COALESCE(CALCULATE(IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL])), 0),
			        "__Meta", IFERROR(VALUE(CALCULATE(IF(vUsarReceitaBruta, [Meta RB], [Meta RSL]))), BLANK())
			    )
			VAR tRegiaoFiltrada =
			    FILTER(
			        tRegiaoBase,
			        [__Realizado] <> 0 || NOT ISBLANK([__Meta])
			    )
			VAR tRegiaoTop =
			    TOPN(
			        5,
			        tRegiaoFiltrada,
			        [__Realizado], DESC,
			        [__Nome], ASC
			    )
			VAR vRegiaoMaxValor =
			    MAXX(
			        tRegiaoTop,
			        MAX([__Realizado], COALESCE([__Meta], 0))
			    )
			VAR vRegiaoMaxSeguro =
			    IF(ISBLANK(vRegiaoMaxValor) || vRegiaoMaxValor = 0, 1, vRegiaoMaxValor)
			VAR HRegiaoRows =
			    IF(
			        COUNTROWS(tRegiaoTop) = 0,
			        "<div class=""reg-empty"">Sem dados de região no contexto atual. Verifique se o campo dRegional está relacionado às medidas de receita e meta.</div>",
			        CONCATENATEX(
			            tRegiaoTop,
			            VAR vNomeReg = [__Nome]
			            VAR vRealReg = [__Realizado]
			            VAR vMetaReg = [__Meta]
			            VAR vRealPctNum = MIN(100, MAX(2, DIVIDE(vRealReg, vRegiaoMaxSeguro, 0) * 100))
			            VAR vRealPct = FORMAT(vRealPctNum, "0")
			            VAR vMetaPct = FORMAT(MIN(100, MAX(0, DIVIDE(vMetaReg, vRegiaoMaxSeguro, 0) * 100)), "0")
			            VAR fRealReg = FORMAT(DIVIDE(vRealReg, 1000000), "#,##0.00") & " mi"
			            VAR fMetaReg = FORMAT(DIVIDE(vMetaReg, 1000000), "#,##0.00") & " mi"
			            RETURN
			                "<div class=""reg-dyn-row"">" &
			                    "<div class=""reg-dyn-name"">" & vNomeReg & "</div>" &
			                    "<div class=""reg-dyn-chart"">" &
			                        "<div class=""reg-dyn-track"">" &
			                            "<div class=""reg-dyn-bar"" style=""width:" & vRealPct & "%""></div>" &
			                            IF(vRealPctNum >= 42,
			                                "<div class=""reg-dyn-val inside"" style=""left:0;width:" & vRealPct & "%"">" & fRealReg & "</div>",
			                                "<div class=""reg-dyn-val outside"" style=""left:calc(" & vRealPct & "% + 7px)"">" & fRealReg & "</div>"
			                            ) &
			                            IF(ISBLANK(vMetaReg), "", "<div class=""reg-dyn-meta"" style=""left:" & vMetaPct & "%""></div>") &
			                        "</div>" &
			                    "</div>" &
			                    IF(ISBLANK(vMetaReg), "<div class=""reg-dyn-meta-val"">-</div>", "<div class=""reg-dyn-meta-val"">Meta " & fMetaReg & "</div>") &
			                "</div>",
			            "",
			            [__Realizado], DESC
			        )
			    )
			
			// Participação Relativa por Segmento - gráfico de pizza dinâmico e sensível aos filtros do Power BI
			VAR tMixMarcaBase =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES('dMaterial_unificada'[novo_segmento]),
			            NOT ISBLANK('dMaterial_unificada'[novo_segmento])
			        ),
			        "__Grupo", 'dMaterial_unificada'[novo_segmento],
			        "__RSL", COALESCE(CALCULATE(IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL])), 0),
			        "__RSLTotal", COALESCE(CALCULATE(IF(vUsarReceitaBruta, [09 Receita Bruta], [03 RSL]), ALLSELECTED('dMaterial_unificada'[novo_segmento])), 0)
			    )
			// Segmentos sem receita não acrescentam leitura ao gráfico.
			VAR tMixMarcaFiltrada =
			    FILTER(
			        tMixMarcaBase,
			        [__RSL] <> 0
			    )
			VAR tMixMarcaTop =
			    TOPN(
			        6,
			        tMixMarcaFiltrada,
			        [__RSL], DESC,
			        [__Grupo], ASC
			    )
			// A pizza preserva a participação sobre o total selecionado e exibe somente os Top 6 segmentos.
			VAR vMixTotal =
			    MAXX(
			        tMixMarcaTop,
			        [__RSLTotal]
			    )
			VAR vMixTopTotal =
			    SUMX(
			        tMixMarcaTop,
			        [__RSL]
			    )
			VAR HMixPieSlices =
			    IF(
			        COUNTROWS(tMixMarcaTop) = 0 || ISBLANK(vMixTotal) || vMixTotal = 0,
			        "",
			        CONCATENATEX(
			            tMixMarcaTop,
			            VAR vGrupoAtual = [__Grupo]
			            VAR vRSLAtual = [__RSL]
			            VAR vOrdemAtual =
			                1 +
			                COUNTROWS(
			                    FILTER(
			                        tMixMarcaTop,
			                        [__RSL] > vRSLAtual
			                            || ([__RSL] = vRSLAtual && [__Grupo] < vGrupoAtual)
			                    )
			                )
			            VAR vAcumAntes =
			                SUMX(
			                    FILTER(
			                        tMixMarcaTop,
			                        [__RSL] > vRSLAtual
			                            || ([__RSL] = vRSLAtual && [__Grupo] < vGrupoAtual)
			                    ),
			                    [__RSL]
			                )
			            VAR vSharePct = DIVIDE(vRSLAtual, vMixTotal, 0) * 100
			            VAR vAcumPct = DIVIDE(vAcumAntes, vMixTotal, 0) * 100
			            VAR vRestantePct = MAX(0, 100 - vSharePct)
			            VAR vCor =
			                SWITCH(
			                    vOrdemAtual,
			                    1, "#0A3A66",
			                    2, "#14568E",
			                    3, "#2F74AE",
			                    4, "#5A94C6",
			                    5, "#8CB5DB",
			                    6, "#BDD6EC",
			                    "#BDD6EC"
			                )
			            VAR fSharePct = SUBSTITUTE(FORMAT(vSharePct, "0.000"), ",", ".")
			            VAR fRestantePct = SUBSTITUTE(FORMAT(vRestantePct, "0.000"), ",", ".")
			            VAR fAcumPct = SUBSTITUTE(FORMAT(vAcumPct, "0.000"), ",", ".")
			            RETURN
			                "<circle cx=""150"" cy=""150"" r=""75"" fill=""none"" stroke=""" & vCor & """ stroke-width=""150"" pathLength=""100"" stroke-dasharray=""" & fSharePct & " " & fRestantePct & """ stroke-dashoffset=""-" & fAcumPct & """ transform=""rotate(-90 150 150)""/>" ,
			            "",
			            [__RSL], DESC,
			            [__Grupo], ASC
			        )
			    )
			VAR HMixPieLabels =
			    IF(
			        COUNTROWS(tMixMarcaTop) = 0 || ISBLANK(vMixTotal) || vMixTotal = 0,
			        "",
			        CONCATENATEX(
			            tMixMarcaTop,
			            VAR vGrupoAtual = [__Grupo]
			            VAR vRSLAtual = [__RSL]
			            VAR vOrdemAtual =
			                1 +
			                COUNTROWS(
			                    FILTER(
			                        tMixMarcaTop,
			                        [__RSL] > vRSLAtual
			                            || ([__RSL] = vRSLAtual && [__Grupo] < vGrupoAtual)
			                    )
			                )
			            VAR vAcumAntes =
			                SUMX(
			                    FILTER(
			                        tMixMarcaTop,
			                        [__RSL] > vRSLAtual
			                            || ([__RSL] = vRSLAtual && [__Grupo] < vGrupoAtual)
			                    ),
			                    [__RSL]
			                )
			            VAR vShare = DIVIDE(vRSLAtual, vMixTotal, 0)
			            VAR vSharePct = vShare * 100
			            VAR vAcumPct = DIVIDE(vAcumAntes, vMixTotal, 0) * 100
			            VAR vAnguloMeioGraus = (vAcumPct + vSharePct / 2) * 3.6 - 90
			            VAR vAnguloMeioRad = vAnguloMeioGraus * PI() / 180
			            VAR vLabelX = 150 + COS(vAnguloMeioRad) * 98
			            VAR vLabelY = 150 + SIN(vAnguloMeioRad) * 98
			            VAR fLabelX = SUBSTITUTE(FORMAT(vLabelX, "0.0"), ",", ".")
			            VAR fLabelY = SUBSTITUTE(FORMAT(vLabelY, "0.0"), ",", ".")
			            VAR fShare = FORMAT(vShare, "0.0%")
			            VAR vLabelClass = IF(vOrdemAtual <= 4, " light", " dark")
			            RETURN
			                IF(
			                    vOrdemAtual <= 5,
			                    "<text x=""" & fLabelX & """ y=""" & fLabelY & """ class=""mix-pie-label" & vLabelClass & """>" & fShare & "</text>",
			                    ""
			                ),
			            "",
			            [__RSL], DESC,
			            [__Grupo], ASC
			        )
			    )
			VAR HMixPieLegend =
			    IF(
			        COUNTROWS(tMixMarcaTop) = 0 || ISBLANK(vMixTotal) || vMixTotal = 0,
			        "",
			        CONCATENATEX(
			            tMixMarcaTop,
			            VAR vGrupoAtual = [__Grupo]
			            VAR vRSLAtual = [__RSL]
			            VAR vOrdemAtual =
			                1 +
			                COUNTROWS(
			                    FILTER(
			                        tMixMarcaTop,
			                        [__RSL] > vRSLAtual
			                            || ([__RSL] = vRSLAtual && [__Grupo] < vGrupoAtual)
			                    )
			                )
			            VAR vCor =
			                SWITCH(
			                    vOrdemAtual,
			                    1, "#0A3A66",
			                    2, "#14568E",
			                    3, "#2F74AE",
			                    4, "#5A94C6",
			                    5, "#8CB5DB",
			                    6, "#BDD6EC",
			                    "#BDD6EC"
			                )
			            VAR fShare = FORMAT(DIVIDE(vRSLAtual, vMixTotal, 0), "0.0%")
			            RETURN
			                "<div class=""mix-pie-item"">" &
			                    "<span class=""mix-pie-dot"" style=""background:" & vCor & ";""></span>" &
			                    "<span class=""mix-pie-name"">" & vGrupoAtual & "</span>" &
			                    "<span class=""mix-pie-val"">" & fShare & "</span>" &
			                "</div>",
			            "",
			            [__RSL], DESC,
			            [__Grupo], ASC
			        )
			    )
			VAR HMixPie =
			    IF(
			        COUNTROWS(tMixMarcaTop) = 0 || ISBLANK(vMixTotal) || vMixTotal = 0,
			        "<div class=""mix-empty"">Sem dados de segmento no contexto atual.</div>",
			        "<div class=""mix-pie-layout"">" &
			            "<div class=""mix-pie-wrap"">" &
			                "<svg class=""mix-pie-svg"" viewBox=""0 0 300 300"" preserveAspectRatio=""xMidYMid meet"" role=""img"" aria-label=""Participação relativa por segmento"">" &
			                    HMixPieSlices &
			                    HMixPieLabels &
			                "</svg>" &
			            "</div>" &
			            "<div class=""mix-pie-legend"">" & HMixPieLegend & "</div>" &
			        "</div>"
			    )
			
			// Bridge dinamico - responde aos filtros do Power BI
			VAR vCSS01 = ":root{--brand:#023F76;--brand-deep:#062A4C;--accent:#0A5CA8;--accent-soft:#E9F1F9;--accent-line:#BDD4E9;--on-brand:#FFFFFF;--on-brand-dim:rgba(255,255,255,.85);--on-brand-chip:rgba(255,255,255,.14);--on-brand-chip-line:rgba(255,255,255,.28);--shadow-pop:0 4px 20px rgba(6,42,76,.15);--bg:#F2F5F9;--card:#FFFFFF;--card-2:#F8FAFC;--line:#E2E8F0;--line-strong:#C6D0DD;--ink:#14243A;--ink-2:#3C4E64;--ink-3:#51667F;--focus:#0A5CA8;--pos:#176B3A;--pos-soft:#E4F3E9;--pos-line:#A9D8B8;--neg:#B4231F;--neg-soft:#FBEAE8;--neg-line:#EFB4AE;--warn:#8F5600;--warn-soft:#FCF1DE;--warn-line:#ECCF9E;--pos-bright:#57D992;--warn-bright:#F5C04E;--neg-bright:#FF8B84;--cat-1:#0A3A66;--cat-2:#14568E;--cat-3:#2F74AE;--cat-4:#5A94C6;--cat-5:#8CB5DB;--cat-6:#BDD6EC;--sc-real:#0A1B2C;--sc-meta:#5D7186;--sc-ly:#A3B0BE;--sc-fc:#4E86BE;--font:'Segoe UI',system-ui,-apple-system,sans-serif;--fs-foot:11px;--fs-lbl:12px;--fs-body:13px;--fs-md:14px;--fs-h3:15px;--fs-h1:19px;--fs-kpi:22px;--fs-hero:38px;--radius:12px;--radius-sm:8px;--shadow:0 1px 2px rgba(6,42,76,.05),0 2px 10px rgba(6,42,76,.05);--shadow-lift:0 4px 20px rgba(6,42,76,.12);}"
			VAR vCSS02 = "*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}html,body{height:100%;}body{font-family:var(--font);background:var(--bg);margin:0 !important;padding:0 !important;color:var(--ink);font-size:var(--fs-body);line-height:1.45;-webkit-font-smoothing:antialiased;}.num{font-variant-numeric:tabular-nums;}.app{display:flex;min-height:100vh;}.sidebar{width:224px;flex:0 0 224px;background:var(--card);border-right:1px solid var(--line);display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;}.brand{padding:20px 18px 12px;}.wordmark{font-size:26px;font-weight:760;letter-spacing:-.045em;color:var(--brand);line-height:1;text-transform:lowercase;}.wordmark i{font-style:italic;font-weight:640;margin-right:1px;}.brand small{display:block;margin-top:4px;font-size:var(--fs-foot);font-weight:640;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);}"
			VAR vCSS03 = ".nav{padding:4px 10px;flex:1;}.nav .sec{font-size:var(--fs-foot);letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);padding:14px 10px 5px;font-weight:680;}.nav ul{list-style:none;}.nav button{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border:0;border-radius:var(--radius-sm);background:none;color:var(--ink-2);text-align:left;font-family:var(--font);font-weight:560;font-size:var(--fs-body);margin-bottom:1px;cursor:pointer;}.nav button:hover{background:var(--card-2);color:var(--ink);}.nav button.active{background:var(--accent-soft);color:var(--brand-deep);font-weight:680;box-shadow:inset 3px 0 0 var(--accent);}.nav .ic{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;opacity:.85;}.main{flex:1;min-width:0;display:flex;flex-direction:column;}"
			VAR vCSS04 = ".topbar{background:var(--card);border-bottom:1px solid var(--line);padding:11px 24px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;position:sticky;top:0;z-index:30;}.topbar h1{font-size:var(--fs-h1);font-weight:720;letter-spacing:-.015em;}.topbar .sub{color:var(--ink-3);font-size:var(--fs-lbl);font-weight:500;display:block;}.filters{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;}.fgroup{display:flex;flex-direction:column;gap:3px;}.fgroup label{font-size:var(--fs-foot);font-weight:660;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);padding-left:2px;}select{font-family:var(--font);font-size:var(--fs-body);font-weight:580;color:var(--ink);background:var(--card);border:1px solid var(--line-strong);border-radius:var(--radius-sm);padding:6px 10px;cursor:pointer;min-width:110px;}select:focus{outline:2px solid var(--focus);}"
			VAR vCSS05 = ".base-toggle{display:flex;border:1px solid var(--line-strong);border-radius:var(--radius-sm);overflow:hidden;}.base-toggle button{font-family:var(--font);font-size:var(--fs-lbl);font-weight:620;color:var(--ink-2);background:var(--card);border:0;padding:6px 12px;cursor:pointer;}.base-toggle button.on{background:var(--brand);color:white;font-weight:700;}.ctxstrip{display:flex;flex-wrap:wrap;gap:5px 16px;align-items:center;background:var(--card-2);border-bottom:1px solid var(--line);padding:6px 24px;font-size:var(--fs-lbl);color:var(--ink-2);}.ctxstrip b{color:var(--ink-3);font-weight:700;font-size:var(--fs-foot);letter-spacing:.07em;text-transform:uppercase;margin-right:4px;}.ctxstrip .pill{margin-left:auto;color:var(--brand);background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:20px;padding:2px 10px;font-weight:620;font-size:var(--fs-foot);}"
			VAR vCSS06 = ".content{padding:18px 24px 60px;flex:1;}.page{display:none;}.page.active{display:block;}.grid{display:grid;gap:12px;}.cards{grid-template-columns:repeat(12,1fr);}.col-12{grid-column:span 12;}.col-8{grid-column:span 8;}.col-7{grid-column:span 7;}.col-6{grid-column:span 6;}.col-5{grid-column:span 5;}.col-4{grid-column:span 4;}.col-3{grid-column:span 3;}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:15px 17px;box-shadow:var(--shadow);min-width:0;}.card h3{font-size:var(--fs-h3);font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:3px;}.card .desc{font-size:var(--fs-lbl);color:var(--ink-3);margin-bottom:10px;}.card .src{font-size:var(--fs-foot);color:var(--ink-3);margin-top:10px;border-top:1px dashed var(--line);padding-top:6px;}.seclbl{font-size:var(--fs-foot);letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3);font-weight:700;margin:16px 0 6px 2px;}"
			VAR vCSS07 = ".grid>.seclbl{grid-column:1 / -1;margin:4px 2px -2px;}.basetag{font-size:var(--fs-foot);font-weight:680;letter-spacing:.02em;color:var(--ink-3);background:var(--card-2);border:1px solid var(--line-strong);border-radius:20px;padding:1px 8px;margin-left:auto;white-space:nowrap;}.kpis{grid-template-columns:repeat(auto-fit,minmax(190px,1fr));}.kpis-row{grid-column:1 / -1;grid-template-columns:repeat(5,minmax(170px,1fr));align-items:stretch;}.kpis-row.inov{grid-template-columns:repeat(2,minmax(170px,1fr));max-width:460px;}.kpis-row.comp{grid-column:1 / -1;grid-template-columns:repeat(4,minmax(0,1fr));max-width:none;width:100%;align-items:stretch;gap:14px;margin-bottom:30px;}.kpis-row .kpi{min-height:110px;}.kpi{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px 10px;box-shadow:var(--shadow);position:relative;overflow:visible;min-width:0;}.kpi::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:var(--line);}.kpi.st-pos::before{background:var(--pos);}.kpi.st-neg::before{background:var(--neg);}.kpi.st-warn::before{background:var(--warn);}.kpi .lab{font-size:var(--fs-foot);font-weight:680;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-3);display:flex;align-items:center;justify-content:space-between;gap:4px;}"
			VAR vCSS08 = ".kpi-val{font-size:var(--fs-kpi);font-weight:780;letter-spacing:-.02em;margin-top:4px;white-space:nowrap;line-height:1.12;overflow:visible;}.kpi-val small{font-size:var(--fs-md);font-weight:640;color:var(--ink-2);}.deltas{display:flex;gap:10px;margin-top:3px;flex-wrap:wrap;}.delta{font-size:var(--fs-lbl);font-weight:660;display:inline-flex;align-items:center;gap:3px;}.delta .ref{color:var(--ink-3);font-weight:560;}.delta.up{color:var(--pos);}.delta.dn{color:var(--neg);}.delta.fl{color:var(--ink-3);}.kpi .hint{font-size:var(--fs-foot);color:var(--ink-3);margin-top:2px;}.hero{background:linear-gradient(135deg,var(--brand-deep),var(--brand) 70%);color:var(--card);border-radius:var(--radius);padding:20px 24px;box-shadow:var(--shadow-lift);position:relative;overflow:hidden;}.hero .lab{font-size:15px;font-weight:950;letter-spacing:.15em;text-transform:uppercase;color:#FFFFFF;display:flex;gap:8px;align-items:center;flex-wrap:wrap;line-height:1.26;}"
			VAR vCSS09 = ".hero-val{font-size:var(--fs-hero);font-weight:800;letter-spacing:-.025em;line-height:1.1;margin:5px 0 2px;}.hero-val small{font-size:var(--fs-h1);font-weight:640;opacity:.85;}.hero .sub{font-size:16px;font-weight:700;color:#FFFFFF;line-height:1.35;}.hero .row{display:flex;gap:24px;flex-wrap:wrap;align-items:flex-end;margin-top:12px;}.hero .aux{min-width:140px;}.hero .aux .l{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--on-brand-dim);font-weight:750;}.hero .aux .v{font-size:18px;font-weight:780;margin-top:2px;line-height:1.15;}.hero .aux .d{font-size:15px;font-weight:760;margin-top:3px;line-height:1.2;}.hero .aux .delta-inline{display:inline-flex;align-items:center;gap:4px;font-size:15px;font-weight:800;line-height:1.2;}.hero .aux .delta-inline.pos{color:var(--pos-bright);}.hero .aux .delta-inline.neg{color:var(--neg-bright);}.hero .aux .delta-inline.flat{color:#D9E4F0;}.hero-badge{display:inline-flex;align-items:center;gap:8px;margin-top:10px;font-size:var(--fs-body);font-weight:700;border-radius:20px;padding:4px 14px;background:var(--on-brand-chip);border:1px solid var(--on-brand-chip-line);}.hero-badge .dot{width:9px;height:9px;border-radius:50%;flex:none;}"
			VAR vCSS10 = ".tag{display:inline-flex;align-items:center;gap:4px;font-size:var(--fs-foot);font-weight:700;padding:2px 8px;border-radius:20px;white-space:nowrap;}.tag.ok{background:var(--pos-soft);color:var(--pos);}.tag.bad{background:var(--neg-soft);color:var(--neg);}.tag.warn{background:var(--warn-soft);color:var(--warn);}.tag.info{background:var(--accent-soft);color:var(--brand);}.seg-chip{display:inline-flex;align-items:center;gap:6px;font-size:var(--fs-lbl);font-weight:660;padding:4px 12px;border-radius:20px;border:1px solid;white-space:nowrap;cursor:pointer;}.seg-chip.on{color:white;border-color:transparent;}.bar-track{background:var(--bg);border-radius:4px;height:8px;overflow:hidden;margin:5px 0 2px;}.bar-fill{height:100%;border-radius:4px;transition:width .4s ease;}.chart-wrap{width:100%;overflow:hidden;}svg.chart{width:100%;display:block;}.axis-label{font-size:10px;fill:var(--ink-3);font-family:var(--font);}"
			VAR vCSS11 = ".axis-line{stroke:var(--line);stroke-width:1;}.grid-line{stroke:var(--line);stroke-width:1;stroke-dasharray:3,3;}.bar-real{fill:var(--sc-real);}.bar-meta{fill:none;stroke:var(--sc-meta);stroke-width:2;stroke-dasharray:5,3;}.bar-ly{fill:var(--sc-ly);}.line-real{fill:none;stroke:var(--sc-real);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;}.line-meta{fill:none;stroke:var(--sc-meta);stroke-width:2;stroke-dasharray:6,4;}.line-ly{fill:none;stroke:var(--sc-ly);stroke-width:1.5;}.line-fc{fill:none;stroke:var(--sc-fc);stroke-width:2;stroke-dasharray:3,3;}.area-real{fill:var(--sc-real);opacity:.05;}.dot-real{fill:var(--sc-real);}.tooltip-bg{fill:var(--card);stroke:var(--line);stroke-width:1;rx:6;}.legend-item{font-size:10px;fill:var(--ink-2);font-family:var(--font);}.seg-0{fill:var(--cat-1);}.seg-0-stroke{stroke:var(--cat-1);}.seg-1{fill:var(--cat-2);}"
