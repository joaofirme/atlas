	/// Soma total dos valores dos itens das ordens do tipo devolução que estejam faturadas. 
	/// 
	/// Considerar vendas, bonificações e amostras que estejam no depósito diferente de 52. 
	/// 
	/// Devem ser considerado apenas produto acabado (iniciam com 3 e 7).
	/// 
	/// A nota fiscal deve ser do tipo:
	/// ZK - SD NFe Devolução Sem Ref (NF Writer);
	/// ZR - SD NFe Dev. Sem Ref (Cliente);
	/// ZD - Dev. NF Saída Cliente - NFe;
	/// ZE - Dev. NF Saída Própria - NFe;
	/// ZH - Dev.E-commerce NF Saída Própria - NFe.
	/// 
	measure '00 Devolução' =
			
			
			VAR vDevolucao =
			    CALCULATE(
			        SUM('fDevolucao_unificada'[receita]),
			        'fDevolucao_unificada'[deposito_codigo] <> "52"
			    )+0
			
			RETURN vDevolucao
			
			    /*
			    VAR vSomaFarmax =
			    CALCULATE(
			        SUM('fDevolucao_unificada'[receita]),
			        'fDevolucao_unificada'[empresa] = "FARMAX",
			        'fDevolucao_unificada'[deposito_codigo] <> "52",
			        'fDevolucao_unificada'[faturamento_cod_tipo] IN {"ZK","ZR","ZD","ZE","ZH"},
			        LEFT('fDevolucao_unificada'[sku],1) IN {"3","7"}
			    )
			
			VAR vSomaSanavita =
			    CALCULATE(
			        SUM('fDevolucao_unificada'[receita]),
			        'fDevolucao_unificada'[empresa] = "SANAVITA"
			    )
			
			RETURN
			    (COALESCE(vSomaFarmax, 0) + COALESCE(vSomaSanavita, 0)) + 0
			    */
		formatString: #,0
		displayFolder: 06 Devolução
		lineageTag: 0c7ca50e-ea87-4f80-99d3-cee8e026ef60

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Consolidado entre devoluções e refaturamento.
	measure '02 Devolução Total' = ```
			
			    
			    [00 Devolução] + [01 Refaturamento] + 0
			```
		formatString: #,0
		displayFolder: 06 Devolução
		lineageTag: 8dd82b04-2eb1-4380-976e-407514501b99

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Representação percentual de devolução sobre o faturamento.
	measure '03 % Devolução' = ```
			
			
			    ABS(
			        DIVIDE(
			            [02 Devolução Total]
			            ,[00 Faturamento]
			            ,0
			        )
			    )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Devolução
		lineageTag: 3add60a2-eca6-4274-b8c4-e4b17ff3f5c1

		changedProperty = FormatString

	/// Soma total dos valores dos itens das ordens do tipo devolução que estejam faturadas. Devem ser consideradas as vendas, bonificações e amostras que estejam no depósito 52. Devem ser considerado apenas produto acabado (iniciam com 3 e 7).
	measure '01 Refaturamento' =
			
			
			VAR vRefaturamento =
			    CALCULATE(
			        SUM('fDevolucao_unificada'[receita]),
			        'fDevolucao_unificada'[deposito_codigo] == "52"
			    )+0
			
			RETURN
			    vRefaturamento
			
			    /*CALCULATE(
			        SUM('fDevolução'[order_return_subtotal]),
			        'fDevolução'[order_return_storage_code] == "52",
			        'fDevolução'[order_return_billing_type_code] in{"ZK","ZR","ZD","ZE","ZH"},
			        LEFT('fDevolução'[order_return_material_code],1) in {"3","7"}
			    )+0*/
		displayFolder: 06 Devolução
		lineageTag: a44dddd5-3675-46b6-8d1d-5bb95e7b6ea4

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Soma do valor dos pedidos classificados com tipo venda, e status a faturar.
	measure '03 Total a Faturar' = ```
			
			
			    CALCULATE(
			        SUM(fVendas_unificada[order_sale_subtotal])
			        ,fVendas_unificada[pedido_tipo]  = "VENDA" 
			        ,fVendas_unificada[pedido_status] = "A FATURAR"
			        --,order_sale[order_sale_storage_code] in {"50", "85", "54", "95", "52"} -- Adicionado 30/06/23 Pedro por e-mail
			        ,REMOVEFILTERS('dTempo')
			    )+0
			
			/*
			    CALCULATE(
			        SUM(fPedido[order_sale_subtotal])
			        ,fPedido[obt_sales_order_type]  = "VENDA" 
			        ,fPedido[obt_sales_order_status] = "A FATURAR"
			        --,order_sale[order_sale_storage_code] in {"50", "85", "54", "95", "52"} -- Adicionado 30/06/23 Pedro por e-mail
			        ,REMOVEFILTERS('dTempo')
			        --,REMOVEFILTERS('Mês')
			    )+0
			*/
			```
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 6e5c1227-6458-45cf-a7a4-7710a71baa1d

		changedProperty = FormatString

